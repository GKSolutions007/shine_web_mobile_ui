                cardHtml += '<div class="col-12 col-md-4 card-item mb-2" style="animation-delay:' + (index * 0.05) + 's">';
                cardHtml += '  <div class="card card-view-item shadow-sm mt-4">';
                cardHtml += '    <div class="card-header card-header-view fs-5 d-flex align-items-center gap-2">';
                cardHtml += '      <i class="bi bi-person-circle"></i>';
                cardHtml += '      <span class="text-truncate">' + (value.UserName || "Unknown User") + '</span>';
                cardHtml += '    </div>';
