                cardHtml += '        <div class="col-4 text-center border-start border-end"><div class="card-label mb-1"><i class="bi bi-cash-coin me-1"></i>Cash</div><div class="card-value">' + (value.Cash || "-") + '</div></div>';
                cardHtml += '        <div class="col-4 text-center"><div class="card-label mb-1"><i class="bi bi-credit-card me-1"></i>Bank Transfer</div><div class="card-value">' + (value.BankTransfer || "-") + '</div></div>';
                cardHtml += '      </div>';
