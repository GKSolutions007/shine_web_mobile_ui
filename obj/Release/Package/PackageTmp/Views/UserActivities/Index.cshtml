                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-arrow-return-left me-1"></i>Sales Return</div>';
                            cardHtml += '          <div class="card-value">' + (value.SRAmt || "-") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '        <div class="col-4"></div>';
                            cardHtml += '      </div>';

