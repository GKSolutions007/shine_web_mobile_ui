                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-stopwatch me-1"></i>Start Time</div>';
                            cardHtml += '          <div class="card-value">' + (value.StartTime || "--") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '        <div class="col-6 text-center border-start">';
                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-clock me-1"></i>End Time</div>';
                            cardHtml += '          <div class="card-value">' + (value.EndTime || "--") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '      </div>';

