        function loadData() {
            var var_users = getMultiSelectValues('txtUserName').map(function (i) {
                return i.value;
            }).join(',');
            var strDate = $('#dtpDate').val();

            if (!strDate || strDate.trim() === "") {
                showErrorSnackbar("Select valid date");
                $('#dtpDate').focus();
                return;
            }

            $.ajax({
                url: Aurl + "useractivity/generatedata",
                type: 'get',
                contentType: 'json',
                data: { CompanyCode: strCompanyCode, Users: var_users, Date: strDate },
                success: function (data) {
                    var Docjsdata = JSON.parse(data);
                    cachedData = Docjsdata.Table;
                    renderView();
