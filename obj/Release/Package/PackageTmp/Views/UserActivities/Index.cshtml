            });
        }            
            // Function to filter cards based on search input
            function filterCards() {
                var input, filter, cards, cardContainer, h5, i, txtValue;
                input = document.getElementById("txtSearchCards");
                filter = input.value.toUpperCase();
                cardContainer = document.getElementById("divUsersList");
                cards = cardContainer.getElementsByClassName("card-item");

                for (i = 0; i < cards.length; i++) {
                    // Search in the whole text content of the card
                    txtValue = cards[i].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        cards[i].style.display = "";
                    } else {
                        cards[i].style.display = "none";
                    }
                }
            }            
        //Card & Table View
        var currentView = 'card';
        var cachedData = [];

        function switchView(view) {
            currentView = view;
            $('#btnCardView').toggleClass('active', view === 'card');
            $('#btnTableView').toggleClass('active', view === 'table');

            // Show search bar only in table view
            if (view === 'table') {
                $('#searchBarGroup').show();
                $('.search-wrapper').hide();
                
            } else {
                $('#searchBarGroup').hide();
                $('#tblSearchInput').val('');
                $('#btnClearSearch').hide();
                $('.search-wrapper').show();
            }

            renderView();
        }

        function renderView() {
            if (cachedData.length === 0) {
                $('#divUsersList').html(`
            <div class="col-md-12">
                <div class="empty-state-modern text-center py-5 px-4">
                    <div class="empty-icon mb-4"><h3><i class="bi bi-people"></i></h3></div>
                    <h3 class="fw-bold mb-2">No Users Found</h3>
                    <p class="text-muted mb-4">We couldn't find any users matching your search or filters.</p>
                </div>
            </div>`);
                $('#viewToggle').hide();
                return;
            }

            $('#viewToggle').show();

            if (currentView === 'card') {
                renderCardView(cachedData);
            } else {
                renderTableView(cachedData);
            }
        }

        // Search/filter handler
        $(document).on('input', '#tblSearchInput', function () {
            var query = $(this).val().trim().toLowerCase();
            $('#btnClearSearch').toggle(query.length > 0);

            var rows = $('#divUsersList table tbody tr:not(.tbl-no-results)');
            var visibleCount = 0;

            rows.each(function () {
                var userName = $(this).find('td').text().toLowerCase();
                if (query === '' || userName.indexOf(query) !== -1) {
                    $(this).show().toggleClass('tbl-highlight', query.length > 0);
                    visibleCount++;
                } else {
                    $(this).hide().removeClass('tbl-highlight');
                }
            });

            // Show "no results" row if nothing matches
            $('#divUsersList table tbody tr.tbl-no-results').remove();
            if (visibleCount === 0 && query.length > 0) {
                $('#divUsersList table tbody').append(
                    '<tr class="tbl-no-results"><td colspan="12">' +
                    '<i class="bi bi-search me-2"></i>No users found matching <strong>"' + $('<span>').text(query).html() + '"</strong>' +
                    '</td></tr>'
                );
            }
        });

        $(document).on('click', '#btnClearSearch', function () {
            $('#tblSearchInput').val('').trigger('input').focus();
        });

