                            cardHtml += '          <div class="card-value">' + (value.TotalCollection || "0.00") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '        <div class="col-4 text-center border-start border-end">';
                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-cash-coin me-1"></i>Cash</div>';
                            cardHtml += '          <div class="card-value">' + (value.Cash || "-") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '        <div class="col-4 text-center">';
                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-credit-card me-1"></i>Bank Transfer</div>';
                            cardHtml += '          <div class="card-value">' + (value.BankTransfer || "-") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '      </div>';

                            // Divider
                            cardHtml += '      <hr class="my-2">';

                            // Row 3: Cheque | Sales Return
                            cardHtml += '      <div class="row mb-3">';
                            cardHtml += '        <div class="col-4 text-center">';
                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-credit-card-2-front me-1"></i>Cheque</div>';
                            cardHtml += '          <div class="card-value">' + (value.Cheque || "0.00") + '</div>';
                            cardHtml += '        </div>';
