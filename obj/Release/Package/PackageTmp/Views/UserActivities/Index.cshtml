                            cardHtml += '          <div class="card-label mb-1"><i class="bi bi-cart-check me-1"></i>Order Value</div>';
                            cardHtml += '          <div class="card-value">' + (value.OTAmt || "0.00 / 0") + '</div>';
                            cardHtml += '        </div>';
                            cardHtml += '        <div class="col-4 text-center">';
