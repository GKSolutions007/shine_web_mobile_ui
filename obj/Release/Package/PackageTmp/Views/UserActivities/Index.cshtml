                cardHtml += '        <div class="col-4 text-center border-start border-end"><div class="card-label mb-1"><i class="bi bi-arrow-return-left me-1"></i>Sales Return</div><div class="card-value">' + (value.SRAmt || "-") + '</div></div>';
                cardHtml += '        <div class="col-4 text-center"><div class="card-label mb-1"><i class="bi bi-receipt-cutoff me-1"></i>Sales</div><div class="card-value">' + (value.Sales || "-") + '</div></div>';
                cardHtml += '      </div>';
                cardHtml += '      <hr class="my-2">';
                cardHtml += '      <div class="row">';
                cardHtml += '        <div class="col-6 text-center"><div class="card-label mb-1"><i class="bi bi-stopwatch me-1"></i>Start Time</div><div class="card-value">' + (value.StartTime || "--") + '</div></div>';
                cardHtml += '        <div class="col-6 text-center border-start"><div class="card-label mb-1"><i class="bi bi-clock me-1"></i>End Time</div><div class="card-value">' + (value.EndTime || "--") + '</div></div>';
                cardHtml += '      </div>';
                cardHtml += '    </div>';
                cardHtml += '  </div>';
                cardHtml += '</div>';
            });
            cardHtml += '</div>';
            $('#divUsersList').html(cardHtml);
        }

