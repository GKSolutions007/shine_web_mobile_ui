    ///////////////////////////////////////////////////
    //Total CheckBox Validations
    function validateSelections(rowIndex, event) {
        const totalBox = $("#cmbTotal" + rowIndex);
        const sumBox = $("#EnableSum" + rowIndex);
        const avgBox = $("#EnableAvg" + rowIndex);
        const countBox = $("#EnableCount" + rowIndex);
        const uniqueBox = $("#EnableUnique" + rowIndex);

        const clickedName = $(event.target).attr("name");
        const clickedState = $(event.target).prop("checked");

        // Case 1: User unchecked Total → force Sum & Avg off
        if (clickedName === "Total" && !clickedState) {
            sumBox.prop("checked", false);
            avgBox.prop("checked", false);
        }

        // Refresh states
        let sum = sumBox.prop("checked");
        let avg = avgBox.prop("checked");
        let count = countBox.prop("checked");
        let unique = uniqueBox.prop("checked");

        // Case 2: Only 2 selections allowed among Sum/Avg/Count/Unique
        let selected = [sum, avg, count, unique].filter(x => x).length;
        if (selected > 2) {
            $(event.target).prop("checked", false); // undo last action
            showErrorSnackbar("Only 2 selections allowed among Sum, Avg, Count, Unique.");
            return; // stop here — don’t apply dependency logic
        }

        // Case 3: If user clicked Sum or Avg while Total is unchecked → check both
        if (clickedName === "EnableSum" && clickedState && !totalBox.prop("checked")) {
            totalBox.prop("checked", true);
            sumBox.prop("checked", true);
        }
        if (clickedName === "EnableAvg" && clickedState && !totalBox.prop("checked")) {
            totalBox.prop("checked", true);
            avgBox.prop("checked", true);
        }
    }


    // Attach listeners
    $(document).on(
        "change",
        "input[name='Total'], input[name='EnableSum'], input[name='EnableAvg'], input[name='EnableCount'], input[name='EnableUnique']",
        function (event) {
            var rowIndex = $(this).attr("id").match(/\d+/)[0];
            validateSelections(rowIndex, event);
        }
    );


