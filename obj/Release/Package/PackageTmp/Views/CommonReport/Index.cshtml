                    ]);
                    //console.log("rowData ", nrowData);
                    combinedDataRows.push(nrowData);
                });
            }
        });
        //console.log("combinedDataRows ", combinedDataRows);
        // Combine columns for display
        var displayCols = [
            ...headerCols.map(c => ({ ...c, header: c.PrintColumnName + " (H)" })),
            ...footerCols.map(c => ({ ...c, field: c.field, header: c.PrintColumnName + " (F)" }))
        ];

        var content = generatePrintContent(title, combinedDataRows, displayCols, fitersdata);//rows
        openPrintWindow(content);
    }

    function generatePrintContent(title, data, columns, fitersdata) {
