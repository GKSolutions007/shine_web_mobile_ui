            // Remove the first column (by property order)
            //console.log("Footer data ", relatedFooterRows, "Footer Cols ", footerCols);
            //if (relatedFooterRows.length > 0) {
            //    var hidecolumns = detailcolumnsettings.filter(cl => cl.PrintYN == false);
