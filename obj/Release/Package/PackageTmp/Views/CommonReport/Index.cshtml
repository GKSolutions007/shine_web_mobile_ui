<style>
    .modal-body {
        padding: 0px 10px 10px 10px !important;
    }

    table.dataTable > tbody > tr > th, table.dataTable > tbody > tr > td {
        padding: 1px 2px !important;
    }

    .each {
        border-bottom: 1px solid #555 !important;
        padding: 3px 0 !important;
    }

    .acItem .name {
        font-size: 11px !important;
        font-family: Arial, Helvetica, sans-serif !important;
        color: var(--acitemname, black);
    }

    .acItem .desc {
        font-size: 11px !important;
        font-family: Arial, Helvetica, sans-serif !important;
        font-weight: bold !important;
        color: var(--acitemdesc, black);
    }

    .ui-autocomplete {
        max-height: 245px !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        z-index: 500 !important;
    }

    .ui-menu-item-wrapper.ui-state-active {
        /*background-color: red;*/
        background-color: var(--dynamic-bg, orangered);
        font-size: 12px !important;
        color: black !important;
        border-radius: 4px !important;
        font-weight: bold !important;
        /*#f3f2f2*/
    }

    td {
        font-size: 10px;
        padding-bottom: 7px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    .modal-header, .modal-footer {
        padding: 10px;
    }
    /* The Modal (background) */
    .modalReportColumnSettings {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 500; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 800px) {
        .modalReportColumnSettings-content {
            background-color: #ffffff;
            margin: 1% auto; /* 15% from the top and centered */
            padding: 0px;
            border: 1px solid #888;
            border-radius: 10px;
            width: 85%; /* Could be more or less, depending on screen size */
            max-height: 60% !important;
            top: 2% !important;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalReportColumnSettings-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 3px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 20%;
            overflow: auto;
        }
    }
    /*
    .modal-dialog {
        width: 80%
    }*/
    /* The Close Button */
    .closemodalReportColumnSettings {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closemodalReportColumnSettings:hover,
        .closemodalReportColumnSettings:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .dg-toolbar-report-name {
        font-size: 1.2em !important;
    }
</style>
<style>
    #loader {
        display: none
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -58%;
        left: 1em;
        background: rgba(255,255,255,0.15);
        color: #2b2828;
        font-size: 1.1em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }
</style>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 20px 0px 0px 0px;
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
    }

    .container {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .left-section {
        flex: 0.75;
        min-width: 150px;
    }

    .right-section {
        flex: 2;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 0px;
    }

    .party-box {
        background-color: #d1e8dd1a;
        padding: 2px;
        min-height: 550px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .party-info-box {
        background-color: #fffde8;
        padding: 10px;
        min-height: 100px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .documents-box {
        background-color: #ffffff;
        padding: 2px;
        min-height: 400px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    @@media (max-width: 768px) {
        .container {
            flex-direction: column;
        }

        .left-section,
        .right-section {
            flex: 1 0 100%;
        }
    }

    @@media (min-width: 1200px) {
        .container {
            max-width: 100% !important;
            gap: 1px !important;
        }
    }

    .main {
        padding-left: 0px !important;
        padding-top: 40px !important;
        padding-bottom: 30px !important;
        width: 100% !important;
        margin-left: 0px !important;
    }

    .form-control {
        height: 28px !important;
        font-size: 12px !important;
    }
    /*.e-toolbar-items .report-header-toolbar .e-tbar-btn-text {
        font-weight: bold !important;
        font-size: 16px !important;
    }*/
    /* Style only the Report Header item */
    .e-toolbar-items .report-header-toolbar {
        flex: 1; /* take available space */
        text-align: center; /* center text inside */
    }

        .e-toolbar-items .report-header-toolbar .e-tbar-btn-text {
            font-weight: bold !important;
            font-size: 16px !important;
        }

        /* Remove button-like background & borders */
        .e-toolbar-items .report-header-toolbar.e-tbar-btn {
            background: transparent !important;
            border: none !important;
            cursor: default !important;
            box-shadow: none !important;
        }
</style>
<style>
    /* Snackbar container */
    .RepLoadersnackbar {
        visibility: hidden; /* hidden by default */
        min-width: 250px;
        background-color: #333;
        color: #fff;
        text-align: left;
        border-radius: 8px;
        padding: 12px 20px;
        position: fixed;
        top: 50px; /* ⬅️ instead of bottom */
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.25);
    }

        /* Show animation */
        .RepLoadersnackbar.show {
            visibility: visible;
            animation: slideDown 0.3s, fadeout 0.3s 3s;
        }

    /* Slide from top */
    @@keyframes slideDown {
        from {
            top: 0;
            opacity: 0;
        }

        to {
            top: 20px;
            opacity: 1;
        }
    }

    @@keyframes fadeout {
        from {
            top: 20px;
            opacity: 1;
        }

        to {
            top: 0;
            opacity: 0;
        }
    }

    /* Spinner */
    .Reploader {
        border: 3px solid #f3f3f3;
        border-top: 3px solid #4caf50;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    ul li > .menu-name:hover {
        font-weight: bold;
        color: var(--report-menu-hover);
    }
</style>
<style title="Export Model Style">

    /* Export Modal Styles */
    .export-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(5px);
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .export-modal-content {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        margin: 1% auto;
        padding: 0;
        border: none;
        border-radius: 12px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .export-modal-header {
        padding: 20px 25px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px 12px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .export-modal-header h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

    .export-modal-close {
        color: white;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
        line-height: 1;
        padding: 0 5px;
    }

        .export-modal-close:hover,
        .export-modal-close:focus {
            color: #f1f1f1;
            transform: scale(1.2);
        }

    .export-modal-body {
        padding: 25px;
    }

    .export-option {
        margin-bottom: 5px;
        padding: 15px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .export-option:hover {
            border-color: #667eea;
            background-color: #f8f9ff;
            transform: translateX(5px);
        }

        .export-option label {
            display: flex;
            flex-direction: column;
            cursor: pointer;
            margin: 0;
        }

        .export-option input[type="radio"] {
            position: absolute;
            opacity: 0;
        }

            .export-option input[type="radio"] + .radio-label::before {
                content: '';
                display: inline-block;
                width: 20px;
                height: 20px;
                border: 2px solid #667eea;
                border-radius: 50%;
                margin-right: 12px;
                vertical-align: middle;
                transition: all 0.2s;
            }

            .export-option input[type="radio"]:checked + .radio-label::before {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                box-shadow: inset 0 0 0 3px white;
            }

        .export-option .radio-label {
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
        }

        .export-option small {
            display: block;
            color: #666;
            margin-left: 32px;
            font-size: 0.875rem;
        }

        .export-option input[type="radio"]:checked ~ small {
            color: #764ba2;
            font-weight: 500;
        }

    .export-modal-footer {
        padding: 20px 25px;
        background-color: #f8f9fa;
        border-radius: 0 0 12px 12px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .export-btn {
        padding: 10px 25px;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .export-btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .export-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

    .export-btn-secondary {
        background: #e0e0e0;
        color: #333;
    }

        .export-btn-secondary:hover {
            background: #d0d0d0;
        }

    .dg-label {
        font-size: 11px !important;
        border: 0px solid transparent !important;
    }

    table.dataTable.table-bordered > :not(caption) > * > * {
        border-width: 1px !important;
    }

    button:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }
</style>

<body>
    <div id="RepLoadersnackbar" class="RepLoadersnackbar">
        <table>
            <tr>
                <td>
                    <div class="Reploader"></div>
                </td>
                <td style="padding-left:10px;font-size:16px;">
                    <span>Loading... Please wait</span>
                </td>
            </tr>
        </table>
    </div>

    <div>
        @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
        @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
        @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
        @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtTransType" })
        <h4 hidden id="MainHeading">@ViewData["FormName"]</h4>
        <div class="toastBox"></div>
        <textarea hidden id="txtcomplogo"></textarea>
        <div class="container">
            <div class="right-section">
                <div id="Grid" style="width: 100%;"></div>
                <div id="DetailGrid" style="width: 100%;"></div>
            </div>
        </div>

    </div>

    <div class="modalReportColumnSettings" id="mymodalReportColumnSettings" tabindex="-1">
        <div @*class="modal-dialog modal-dialog-centered modal-lg"*@>
            <div class="modalReportColumnSettings-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title" id="lblReportPopupheading"><b>@ViewData["FormName"]</b></h5>
                    <button type="button" class="btn-close closemodalReportColumnSettings" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body">
                    <div id="dvAssign" class="w-100 pb-2">
                        <table class="table table-bordered table-striped align-middle" id="tblReportSettings">
                            <thead>
                                <tr class="trclrforcolheader" style="font-size:10px;">
                                    <th style="width:0%">ReportID</th>
                                    <th style="width:0%">TableID</th>
                                    <th style="width:0%">ColumnID</th>
                                    <th style="width:0%">FormorReport</th>
                                    <th style="width:25%">Column Name</th>
                                    <th style="width:25%">Original Name</th>
                                    <th style="width:30%">Display Name</th>
                                    <th style="width:9%">Width</th>
                                    <th style="width:12%">Visible</th>
                                    <th style="width:12%">Alignment</th>
                                    <th style="width:12%">Display Index</th>
                                    <th style="width:12%">Total</th>
                                    <th style="width:12%">Sum</th>
                                    <th style="width:12%">Average</th>
                                    <th style="width:12%">Count</th>
                                    <th style="width:12%">Unique</th>
                                    <th style="width:12%">Column Menu</th>
                                    <th style="width:12%">Show Column Option</th>
                                    <th style="width:12%">Print</th>
                                    <th style="width:12%">Print Name</th>
                                    <th style="width:12%">Print Width</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th colspan="19"></th>
                                    <th class="text-end">Total Print Width :</th>
                                    <th class="text-end">
                                        <label id="lblPrintWidth"></label>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <div class="text-end w-100">
                        <button type="button" class="btn btn-success" id="btnSubmitmodalReportColumnSettings">
                            <i class="bi bi-save"></i> Accept
                        </button>
                        <button type="button" class="btn btn-warning" id="btnClosemodalReportColumnSettings">
                            <i class="bi bi-x-circle"></i> Close
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- Export Options Modal -->
    <div id="exportOptionsModal" class="export-modal">
        <div class="export-modal-content">
            <div class="export-modal-header">
                <h3>Export Options</h3>
                <span class="export-modal-close" onclick="closeExportModal()">&times;</span>
            </div>
            <div class="export-modal-body">
                <div class="export-option" id="rdoHeaderonly">
                    <label>
                        <input type="radio" name="exportType" value="header" checked>
                        <span class="radio-label">Header</span>
                        <small>Export header grid data only with filters</small>
                    </label>
                </div>
                <div class="export-option" id="rdoFooteronly">
                    <label>
                        <input type="radio" name="exportType" value="footer">
                        <span class="radio-label">Footer</span>
                        <small>Export detail grid data only with filters</small>
                    </label>
                </div>

                <div class="export-option" id="rdoHeaderFooterSaperate">
                    <label>
                        <input type="radio" name="exportType" value="separate">
                        <span class="radio-label">Header & Footer (Separate)</span>
                        <small>Header in Sheet 1, all footer data in Sheet 2</small>
                    </label>
                </div>
                <div class="export-option" id="rdoHeaderFooterCombined">
                    <label>
                        <input type="radio" name="exportType" value="combined">
                        <span class="radio-label">Header & Footer (Combined)</span>
                        <small>Header and footer data combined in single sheet</small>
                    </label>
                </div>
            </div>
            <div class="export-modal-footer">
                <button class="export-btn export-btn-primary" onclick="handleExport()">Export</button>
                <button class="export-btn export-btn-secondary" onclick="closeExportModal()">Close</button>
            </div>
        </div>
    </div>


    <!-- Print Options Modal -->
    <div id="printOptionsModal" class="export-modal">
        <div class="export-modal-content">
            <div class="export-modal-header">
                <h3>Print Options</h3>
                <span class="export-modal-close" onclick="closePrintModal()">&times;</span>
            </div>
            <div class="export-modal-body">
                <div class="export-option" id="rdoPrintHeaderonly">
                    <label>
                        <input type="radio" name="printType" value="header" checked>
                        <span class="radio-label">Header</span>
                        <small>Print header grid data with filter information</small>
                    </label>
                </div>
                <div class="export-option" id="rdoPrintFooteronly">
                    <label>
                        <input type="radio" name="printType" value="footer">
                        <span class="radio-label">Footer</span>
                        <small>Print footer grid data with filter information</small>
                    </label>
                </div>
                <div class="export-option" id="rdoPrintHeaderFooterCombined">
                    <label>
                        <input type="radio" name="printType" value="combined">
                        <span class="radio-label">Header & Footer (Combined)</span>
                        <small>Print both header and footer data combined</small>
                    </label>
                </div>
            </div>
            <div class="export-modal-footer">
                <button class="export-btn export-btn-primary" onclick="handlePrint()">Print</button>
                <button class="export-btn export-btn-secondary" onclick="closePrintModal()">Close</button>
            </div>
        </div>
    </div>
</body>
<script type="text/javascript">
            var UID = '@Session["LoginUserID"]';
    var FID = $("#txtFormID").val();
    var Aurl = '@Session["APIurl"]';
    var CompanyName = '@Session["CompanyName"]';
    var RID = '@Session["LoginRoleID"]';
    var ItemsperPage =   parseInt('@Session["ItemsperPage"]', 10) < 0 ? 'All' :parseInt('@Session["ItemsperPage"]', 10)  || 10;
    var strCompanyCode = '@Session["CompanyCode"]';
    var tblReportSettings = $('#tblReportSettings').DataTable({
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollY: "250px",
        "columnDefs": [{ "targets": [0, 1, 2,3], "visible": false, searchable: false }],
    });
    if (UID != 1) {
        $("#btnScript").hide();
    }
    var SelectTableID = 1;
    var Frames = 1;
    var arrReportDeatils = [], IsDynamicReport = 0,nSendFilterstoDetail = 0;
    var arrAllFooterData = [];

    var modalReportColumnsetting = document.getElementById("mymodalReportColumnSettings");
    var spanRepCSClode = document.getElementsByClassName("closemodalReportColumnSettings")[0];
    spanRepCSClode.onclick = function () {
        modalReportColumnsetting.style.display = "none";
    }
    $('#btnClosemodalReportColumnSettings').click(function (e) {
        modalReportColumnsetting.style.display = "none";
    });

    $("#btnFilters,#btnGenerate,#btnExport").hide();
    if (FID != 0) {
        $("#btnFilters,#btnGenerate,#btnExport,#dvAssign").show();
    }
    getAllReports();
    function getAllReports() {
        $.ajax({
            url: Aurl + "mobiledevicelogin/Reportpermissions",
            type: 'get',
            contentType: 'json',
            data: { CompanyCode: strCompanyCode, RID: RID, UID: UID },
            async: false,
            success: function (data) {
                var repdata = JSON.parse(data);
                console.log(repdata);
                var ParentMenus = repdata.ParentRepMenu;
                var ChildMenus = repdata.UserRepMenus;
                //$.each(ParentMenus, function (i, items) {
                //    var childs = ChildMenus.filter(ch => ch.ParentId == items.ReportID)
                //    //console.log("childs ", childs);
                //});
                // Build final JSON with hierarchy
                var finalData = ParentMenus.map(parent => {
                    // Attach children under each parent
                    var childs = ChildMenus.filter(ch => ch.ParentId == parent.ReportID);
                    return {
                        ReportID: parent.ReportID,
                        MenuName: parent.MenuName,
                        // any other parent properties you want to keep
                        ...parent,
                        Children: childs
                    };
                });
                //console.log("Hierarchical JSON:", finalData);
                document.getElementById('menuContainer').appendChild(createMenu(finalData));

            }
        });
    }
    function getMenuIcon(name, hasChildren) {
        if (!name) return hasChildren ? 'fa-folder' : 'fa-file-lines';

        const lowerName = name.toLowerCase();
        if (lowerName == "sales reports") return 'fa-cart-shopping';
        if (lowerName == "purchase reports") return 'fas fa-shopping-bag';
        if (lowerName == "inventory reports") return 'fa-warehouse';
        if (lowerName == "accounts reports") return 'fa-calculator';
        if (lowerName == "outstanding report") return 'fa-file-invoice-dollar';
        if (lowerName == "analysis reports") return 'fa-chart-pie';
        if (lowerName == "master management") return 'fas fa-database';
        if (lowerName == "margin reports") return 'fa-chart-line';
        if (lowerName == "favourite") return 'fa-regular fa-star';

    }
    function createMenu(data) {
        const ul = document.createElement('ul');
        data.forEach(item => {
            const li = document.createElement('li');
            li.dataset.reportId = item.ReportID || "";
            li.dataset.menuName = item.ReportName;

            const hasChildren = item.Children && item.Children.length > 0;

            // Toggle symbol
            const toggle = document.createElement('span');
            toggle.classList.add('toggle');
            toggle.textContent = hasChildren ? '+' : '•';
            li.appendChild(toggle);

            // 🔹 Add Icon
            const icon = document.createElement('i');
            icon.className = 'fa-solid ' + getMenuIcon(item.ReportName, hasChildren);
            icon.style.marginRight = hasChildren ? '8px' : '4px';
            icon.style.width = hasChildren ? '16px' : '0px';
            icon.style.textAlign = 'center';
            icon.style.color = '#555';
            li.appendChild(icon);

            // Menu text
            const name = document.createElement('span');
            name.textContent = item.ReportName;
            name.classList.add('menu-name');
            li.appendChild(name);

            if (hasChildren) {
                const childUl = createMenu(item.Children);
                childUl.classList.add('collapsed');
                li.appendChild(childUl);

                li.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isCollapsed = childUl.classList.contains('collapsed');

                    const siblings = li.parentElement.querySelectorAll(':scope > li > ul');
                    const siblingToggles = li.parentElement.querySelectorAll(':scope > li > .toggle');
                    const siblingIcons = li.parentElement.querySelectorAll(':scope > li > i');

                    siblings.forEach(s => s.classList.add('collapsed'));
                    siblingToggles.forEach(t => t.textContent = '+');
                    // Reset icons of siblings to closed folder if they have children
                    siblingIcons.forEach((ic, idx) => {
                        const sibLi = li.parentElement.querySelectorAll(':scope > li')[idx];
                        const sibHasChildren = sibLi.querySelector('ul') !== null;
                        if (sibHasChildren) {
                            ic.className = 'fa-solid ' + getMenuIcon(sibLi.dataset.menuName, true);
                        }
                    });

                    if (isCollapsed) {
                        childUl.classList.remove('collapsed');
                        toggle.textContent = '−';
                        // Update this icon to open folder or specific active icon
                        icon.className = 'fa-solid ' + getMenuIcon(item.ReportName, true);
                        icon.style.color = '#007acc';
                    } else {
                        toggle.textContent = '+';
                        icon.style.color = '#555';
                    }
                });
            } else {
                li.addEventListener('click', function (e) {
                    e.stopPropagation();
                    //console.log(li.dataset);
                    $("#Grid").html("");
                    $("#DetailGrid").html("");
                    FID = li.dataset.reportId;
                    GetData(0);
                    GetData(1);
                    //ColumnDetails(2, FID, 1);
                    GetColumnSettingsData(2, FID, 1);
                    $("#MainHeading,#RepMainHeading").html(li.dataset.menuName);
                    $("#txtFormName").val(li.dataset.menuName);
                    if (FID != 0) {
                        $("#btnFilters,#btnGenerate,#btnExport,#dvAssign").show();
                        openTabs(null, 'FilterDetails', 1);
                    }

                    // Highlight active leaf
                    li.parentElement.querySelectorAll('li').forEach(l => l.style.backgroundColor = 'transparent');
                    li.style.backgroundColor = '#eef';
                });
            }

            ul.appendChild(li);
        });
        return ul;
    }
