    function LoadDataforAL() {
        $('#tblFilterData tr td input[type=text],select').each(function (i, items) {
            //ShowMsgPopup(items.value + i);
            //isGridEmpty++;
            var strALName = items.name;
            var id = items.id
            var isMultiSelection = $("#" + id).attr('isMultiselection') == "1";
            var arrData = [];
            var arrMultiSelData = [];
            $.ajax({
                url: Aurl + "reportparameters/get",
                type: 'get',
                contentType: 'json',
                data: { Mode: 2, ReportID: FID, ALName: strALName },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    if (data.length > 0) {
                        //Table.draw().clear();
                        //console.log("Field AL : ", strALName, " Field ID : ", id, " tagName : ", items.tagName);
                        if (items.tagName == "INPUT") {
                            $.each(data, function (i, items) {
                                //arrData[i] = items.Name
                                var al = {
                                    "label": items.Name,
                                    "id": items.ID,
                                }
                                arrData.push(al);
                                arrMultiSelData.push({ "label": items.Name, "value": items.ID });
                            });
                            if (isMultiSelection) {
                                //~Multiselect
                                GKBSPaginatedMultiSelect({
                                    inputId: id,//'txtProducts',
                                    data: arrMultiSelData,
                                    onSelect: function (items) { /* optional live hook */ }
                                });
                            }
                            else {
                                //~AutoList
                                PaginatedAutocomplete({
                                    inputId: id,
                                    data: arrData,
                                    onSelect: function (item) {
                                        $('#' + id + '').val(item.label);
                                        return false;
                                    }
                                });
                            }
                        }
                        else if (items.tagName == "SELECT") {
                            $.each(data, function (i, items) {
                                $('#' + id + '').append($('<option/>', {
                                    value: items.ID,
                                    text: items.Name,
                                }));
                            });
                        }
                    }
                }
            });
