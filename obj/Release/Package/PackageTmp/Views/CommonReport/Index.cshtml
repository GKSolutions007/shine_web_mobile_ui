            //        relatedFooterRows.forEach(row => {
            //            delete row[hidecolumns[i].header];
            //        });
            //    }

            //}
            if (relatedFooterRows.length === 0) {
                // If no footer data, add header row with empty footer columns
                var rowData = [
                    ...headerCols.map(col => {
                        let value = hRow[col.field];
                        if (typeof value === 'string' && value.includes('<')) {
                            var tempDiv = document.createElement('div');
                            tempDiv.innerHTML = value;
                            value = tempDiv.textContent || tempDiv.innerText || '';
                        }
                        return value ?? '';
                    }),
                    //...footerCols.map(() => '')
                ];
                combinedDataRows.push(rowData);
            } else {
                // For each footer row, duplicate the header data
                relatedFooterRows.forEach(footerRow => {
                    //var rowData = [
                    //    ...headerCols.map(col => {
                    //        let value = hRow[col.field];
                    //        if (typeof value === 'string' && value.includes('<')) {
                    //            var tempDiv = document.createElement('div');
                    //            tempDiv.innerHTML = value;
                    //            value = tempDiv.textContent || tempDiv.innerText || '';
                    //        }
                    //        return value ?? '';
                    //    }),
                    //    ...footerCols.map(col => relatedFooterRows[col.field] ?? '')
                    //];
                    //console.log("Footer Row : ", footerRow)
                    var nrowData = Object.fromEntries([
                        ...headerCols.map(col => {
                            let value = hRow[col.field];

                            //if (typeof value === 'string' && value.includes('<')) {
                            //    const tempDiv = document.createElement('div');
                            //    tempDiv.innerHTML = value;
                            //    value = tempDiv.textContent || tempDiv.innerText || '12';
                            //}
                            ////console.log("Key : ", col.field, " Value : ", value)
                            return [col.field, hRow[col.field]];
                        }),
                        ...footerCols.map(fcol => {
                            if (footerRow) {
                                let fvalue = footerRow[fcol.field];
                                //console.log("Footer Key : ", fcol.field, "Footer Value : ", fvalue)
                                return [fcol.field, fvalue ?? '']
                            }
                            else {
                                return [fcol.field, '']
                            }
