    <style>
        :root {
            --primary-blue: #0056b3;
            --primary-dark: #004085;
            --glass-bg: skyblue;
            --glass-border: rgba(255, 255, 255, 0.3);
            --nav-height: 48px;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8fbff;
            color: #202124;
        }

        /* Refined Navbar with Skyblue background */
        .navbar-bright {
            background: var(--glass-bg) !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 1px 5px rgba(0,0,0,0.08);
            min-height: var(--nav-height);
            transition: all 0.3s;
            padding: 0 !important;
        }

        .navbar-brand {
            font-weight: 900;
            color: #003366 !important;
            font-size: 1.15rem;
            letter-spacing: -0.01em;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .navbar-brand img {
                max-height: 40px;
                width: auto;
                object-fit: contain;
            }

        /* Dropdown as Button */
        .nav-item.dropdown .dropdown-toggle {
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 6px;
            padding: 4px 12px !important;
            margin: 0 4px;
            font-size: 13px;
            font-weight: 600;
            color: #003366 !important;
            
        }

            .nav-item.dropdown .dropdown-toggle:hover {
                background-color: rgba(255, 255, 255, 0.4);
            }

        /* Pill Search Button */
        .search-pill-btn {
            background-color: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 20px;
            padding: 3px 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: #003366;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s;
            cursor: pointer;
            text-decoration: none !important;
        }

            .search-pill-btn:hover {
                background-color: rgba(255, 255, 255, 0.6);
                transform: translateY(-1px);
            }

            .search-pill-btn i {
                font-size: 14px;
            }

        /* Center Search Absolute Utility */
        .nav-center-absolute {
            position: absolute;
            left: 50%;
            top: 24px; /* Fixed center of 48px header */
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 1050;
        }

            .nav-center-absolute .search-pill-btn {
                pointer-events: auto;
            }

        .nav-link {
            font-weight: 500;
            color: #003366 !important;
            padding: 0.3rem 0.8rem !important;
            transition: all 0.2s;
        }

        /* Logout Stylings */
        .logout-btn {
            background-color: #dc3545 !important;
            color: white !important;
            font-weight: 700 !important;
            font-size: 15px !important;
            border-radius: 8px;
            padding: 5px 15px !important;
            margin-left: 0px;
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.3);
        }

            .logout-btn:hover {
                background-color: #c82333 !important;
                transform: scale(1.02);
                color: white !important;
            }

        .dropdown-menu {
            border: none;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            border-radius: 12px;
            padding: 8px;
            margin-top: 5px;
            animation: fadeInScale 0.2s ease-out;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 500;
        }

        /* Overlay Dashboard Restyled */
        .overlay {
            height: 100%;
            width: 0;
            position: fixed;
            z-index: 2000;
            top: 0;
            left: 0;
            background-color: rgba(255, 255, 255, 0.98);
            overflow-x: hidden;
            transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }

        .overlay-content {
            position: relative;
            width: 100%;
            padding: 60px 20px 40px 20px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
            gap: 12px;
            max-width: 400px;
            margin: 0 auto;
        }

        .menu-tile {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 12px 8px;
            border-radius: 14px;
            background: #ffffff;
            border: 1px solid #e8f0fe;
            text-decoration: none !important;
            transition: all 0.25s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            aspect-ratio: 1/1;
        }

            .menu-tile img {
                width: 32px;
                height: 32px;
                margin-bottom: 6px;
            }

            .menu-tile p {
                font-size: 10px;
                font-weight: 600;
                color: #444;
                margin: 0;
                text-align: center;
            }

        .closebtn {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 36px;
            color: #333;
            cursor: pointer;
            text-decoration: none;
            z-index: 2005;
            line-height: 1;
            font-weight: bold;
        }

            .closebtn:hover {
                color: #dc3545;
            }

        /* Slim Footer */
        .navbar-footer {
            background: skyblue !important;
            border-top: 1px solid rgba(0,0,0,0.05) !important;
            padding: 6px 0 !important;
            height: 32px;
            display: flex;
            align-items: center;
        }

            .navbar-footer marquee {
                font-size: 11px;
                color: #003366;
                font-weight: 500;
            }

        .small-muted {
            font-size: 11px;
            color: #003366;
            font-weight: 500;
            margin: 0;
        }

        /* Animations */
        @@keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(-10px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* Utility */
        .icon-barnew {
            position: fixed;
            left: 15px;
            top: 15px;
            z-index: 1001;
            background: var(--primary-blue);
            padding: 8px;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            box-shadow: 0 4px 12px rgba(26, 115, 232, 0.3);
            cursor: pointer;
            transition: transform 0.2s;
        }

            .icon-barnew:hover {
                transform: scale(1.1);
            }

        /* Blinking status */
        .blink {
            animation: softPulse 1.5s infinite;
        }

        @@keyframes softPulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.6;
            }

            100% {
                opacity: 1;
            }
        }
        /* Action Popup (Modernized) */
        .action-popup {
            position: absolute;
            display: none;
            background: #ffffff;
            border: 1px solid #eef2f6;
            box-shadow: 0 12px 32px rgba(0,0,0,0.1);
            z-index: 99999;
            min-width: 140px;
            border-radius: 12px;
            padding: 8px 0;
            opacity: 0;
            transform: scale(0.9) translateY(10px);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .action-popup.show {
                opacity: 1;
                transform: scale(1) translateY(0);
            }

            .action-popup ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .action-popup li a {
                display: block;
                padding: 10px 16px;
                color: #444;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: background 0.2s;
            }

                .action-popup li a:hover {
                    background: #f0f6ff;
                    color: var(--primary-blue);
                }

        .ui-dialog {
            z-index: 5001 !important;
        }
    </style>
</head>
