        <div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header" style="background-color: lightgoldenrodyellow;">
                        <h3 class="modal-title" id="myModalLabel">Quick Search</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div id="myDropdown" class="dropdown-content">
                            <input type="text" class="form-control mb-3" placeholder="Search.." id="myInput" onkeyup="filterFunction()">

                            @{
                                if (Session["dtPermission"] != null)
                                {
                                    System.Data.DataRow[] drrr = dtPermission.Select("MenuChildLevel = 2", "MenuName");
                                    if (drrr.Count() > 0)
                                    {
                                        foreach (System.Data.DataRow dr_Row in drrr)
                                        {
                                            if (dr_Row["IsMenu"].ToString() == "1" && dr_Row["IsMobileApp"].ToString() == "1")
                                            {
                                                string reflink = dr_Row["LocationName"].ToString() + "?name=" + dr_Row["MenuName"].ToString() + "&TypeID=1&TranID=0";
                                                <div class="list-group-item border-0">
                                                    <a href="@reflink" class="text-decoration-none"> @dr_Row["MenuName"].ToString() </a>
                                                </div>
                                            }
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>

                    <div class="modal-footer" style="background-color: skyblue;">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>

                </div>
            </div>
        </div>
