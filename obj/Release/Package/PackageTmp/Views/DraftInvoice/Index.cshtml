@model ShineWebMobile.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/chosen.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/chosen.jquery.min.js"></script>
<script src="~/Scripts/jquerychoose.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    .selected-row {
        background-color: #cce5ff !important; /* Light blue, change as needed */
    }
    .chosen-container {
        width: 100% !important;
    }

    th, td {
        white-space: nowrap;
    }

    .toolbar, .dt-search {
        float: right;
    }

    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
   

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight:600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -25%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }
    /*input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .9em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }

    .each {
        border-bottom: 1px solid #555;
        padding: 3px 0;
    }

    .acItem .name {
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .acItem .desc {
        font-size: 10px;
        font-family: Arial, Helvetica, sans-serif;
        color: #555;
    }

    .ui-autocomplete {
        max-height: 245px;
        overflow-y: auto;
        overflow-x: hidden;
    }
</style>
<style>
    /* =============================================
       MODERNIZED dvMain STYLES
    ============================================= */
    /* Form Section Cards */
    .form-section-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,120,200,0.08);
        border: 1px solid #e8f0fe;
        margin-bottom: 14px;
        padding: 14px 16px 10px 16px;
        animation: slideInCard 0.35s cubic-bezier(.4,0,.2,1) both;
        transition: box-shadow 0.2s;
    }
    .form-section-card:hover {
        box-shadow: 0 6px 24px rgba(0,120,200,0.13);
    }
    .form-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #1a73e8;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        border-bottom: 1.5px solid #e8f0fe;
        padding-bottom: 6px;
    }
    .form-section-title i {
        font-size: 14px;
        color: #1a73e8;
    }
    /* Floating label inputs */
    .field-wrap {
        position: relative;
        margin-bottom: 6px;
    }
    .field-wrap .field-icon {
        position: absolute;
        left: 10px;
        top: 40%;
        transform: translateY(-50%);
        color: #1a73e8;
        font-size: 14px;
        z-index: 5;
        pointer-events: none;
    }
    .field-wrap .mod-input,
    .field-wrap .mod-select,
    .field-wrap .mod-textarea {
        width: 100%;
        padding: 10px 10px 7px 34px;
        font-size: 13px;
        border: 1.5px solid #d0dff7;
        border-radius: 8px;
        background: #f8fbff;
        color: #222;
        transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
    }
    .field-wrap .mod-input:focus,
    .field-wrap .mod-select:focus,
    .field-wrap .mod-textarea:focus {
        border-color: #1a73e8;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(26,115,232,0.12);
    }
    .field-wrap .mod-label {
        position: absolute;
        top: 0px;
        left: 34px;
        font-size: 10px;
        font-weight: 700;
        color: #1a73e8;
        letter-spacing: 0.05em;
        pointer-events: none;
        transition: all 0.2s;
    }
    .field-wrap .field-error {
        font-size: 10.5px;
        color: #d32f2f;
        margin-top: 2px;
        min-height: 0px;
        padding-left: 4px;
    }
    /* Chosen select reset for field-wrap */
    .field-wrap .chosen-container {
        width: 100% !important;
        position: relative;
        z-index: 1000; /* Ensure it stays above siblings within field-wrap */
    }
    .field-wrap .chosen-container-active {
        z-index: 3000 !important; /* Extremely high when open/active */
    }
    .field-wrap .chosen-single {
        border-radius: 8px !important;
        border: 1.5px solid #d0dff7 !important;
        background: #f8fbff !important;
        box-shadow: none !important;
        height: 46px !important;
        line-height: 42px !important;
        padding-left: 28px !important;
    }
    /* Fix for dropdowns getting cut off or hidden by subsequent section cards */
    .form-section-card {
        position: relative;
    }
    .field-wrap .chosen-drop {
        z-index: 5000 !important; /* Ensure the actual list is topmost */
    }

    /* Radio button pill groups */
    .radio-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    .radio-pill-group input[type=radio] {
        display: none;
    }
    .radio-pill-group label {
        padding: 5px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        border: 1.5px solid #c5d9f5;
        background: #f0f6ff;
        color: #1a73e8;
        cursor: pointer;
        transition: all 0.18s;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .radio-pill-group input[type=radio]:checked + label {
        background: linear-gradient(135deg, #1a73e8, #0d52b8);
        color: #fff;
        border-color: #1a73e8;
        box-shadow: 0 2px 8px rgba(26,115,232,0.28);
    }
    .radio-pill-group label:hover {
        border-color: #1a73e8;
        background: #e3eeff;
    }
    /* Filter toggle group (Manuf/Category/Product) */
    .filter-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }
    .filter-pill-group input[type=radio] {
        display: none;
    }
    .filter-pill-group label {
        padding: 4px 11px;
        border-radius: 16px;
        font-size: 11.5px;
        font-weight: 600;
        border: 1.5px solid #b2d0fb;
        background: #f0f7ff;
        color: #0b57d0;
        cursor: pointer;
        transition: all 0.18s;
        user-select: none;
    }
    .filter-pill-group input[type=radio]:checked + label {
        background: linear-gradient(135deg, #0b57d0, #1a73e8);
        color: #fff;
        border-color: #0b57d0;
        box-shadow: 0 1px 6px rgba(26,115,232,0.22);
    }
    /* Action bar */
    .dvMain-action-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        padding: 10px 0 6px 0;
        border-top: 1.5px solid #e8f0fe;
        margin-top: 8px;
    }
    .dvMain-action-bar .btn {
        border-radius: 22px;
        font-size: 12.5px;
        font-weight: 600;
        padding: 6px 18px;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all 0.18s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    .dvMain-action-bar .btn:hover {
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    }
    /* Cart badge row */
    .cart-badge-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-weight: 700;
        color: #1a73e8;
        font-size: 13px;
        padding: 4px 0;
    }
    .cart-badge-row i {
        font-size: 18px;
    }
    /* Table header modernize */
    #tblProductInfo thead th {
        background: linear-gradient(135deg, #1a73e8, #0d52b8) !important;
        color: #fff !important;
        font-size: 11px !important;
        text-align: center;
        border: none;
        padding: 8px 5px;
    }
    #tblProductInfo {
        font-size: 12px;
        border-radius: 10px;
        overflow: hidden;
    }
    /* Load Selected Data button */
    #btnLoadSelData {
        border-radius: 22px;
        font-weight: 700;
        font-size: 12.5px;
        background: linear-gradient(135deg, #00bcd4, #0097a7);
        border: none;
        color: #fff;
        padding: 8px 16px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.18s;
        box-shadow: 0 2px 8px rgba(0,150,200,0.2);
    }
    #btnLoadSelData:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(0,150,200,0.35);
    }
    /* Animations */
    @@keyframes slideInCard {
        from { opacity:0; transform: translateY(16px); }
        to   { opacity:1; transform: translateY(0); }
    }
    /* Toggle buttons for select all/deselect */
    .toggle-btn-sm {
        border-radius: 14px;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border: 1.5px solid;
        cursor: pointer;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .toggle-btn-sm.select-all {
        color: #1a73e8;
        border-color: #1a73e8;
        background: #f0f6ff;
    }
    .toggle-btn-sm.select-all:hover { background: #1a73e8; color:#fff; }
    .toggle-btn-sm.deselect-all {
        color: #d32f2f;
        border-color: #d32f2f;
        background: #fff5f5;
    }
    .toggle-btn-sm.deselect-all:hover { background: #d32f2f; color:#fff; }
    /* Responsive tweaks */
    @@media (max-width: 576px) {
        .form-section-card { padding: 10px 10px 8px 10px; }
        .dvMain-action-bar .btn { padding: 6px 12px; font-size: 12px; }
        .radio-pill-group label { font-size: 11px; padding: 4px 10px; }
    }
    /* Card collapse toggle button */
    .card-collapse-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f6ff;
        border: 1.5px solid #c5d9f5;
        color: #1a73e8;
        padding: 0;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .card-collapse-btn:hover {
        background: #1a73e8;
        color: #fff;
        border-color: #1a73e8;
    }
    .card-collapse-btn i {
        font-size: 12px;
        margin-right: 0 !important;
    }

    /* Collapsible card body */
    .card-collapsible-body {
        max-height: 1000px;
        opacity: 1;
        overflow: hidden;
        transition: max-height 0.5s ease-in-out, opacity 0.3s ease;
    }
    .card-collapsible-body.collapsed {
        max-height: 0;
        opacity: 0;
        pointer-events: none;
    }
</style>
<body>
    @Html.HiddenFor(model => model.EnablePrice, new { @autocomplete = "off", @class = "form-control", @id = "txtEnablePrice" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    <h4 id="MainHeading">@ViewData["FormName"]</h4>
    <div class="toastBox"></div>
    <div id="dvDocuments">
        <table class="table table-bordered" id="tblMasterData" width="100%">
            <thead>
                <tr class="trclrforcolheader">
                    <th style="text-align:center;font-size: 12px;width:0%;">ID</th>
                    <th style="text-align:center;font-size: 12px;width:9%;">Doc ID</th>
                    <th style="text-align:center;font-size: 12px;width:9%;">Date</th>
                    <th style="text-align:center;font-size: 12px;width:12%;">Branch</th>
                    <th style="text-align:center;font-size: 12px;width:12%;">Beat</th>
                    <th style="text-align:center;font-size: 12px;width:12%;">Salesman</th>
                    <th style="text-align:center;font-size: 12px;width:20%;">Customer Name</th>
                    <th style="text-align:center;font-size: 12px;width:8%;">Amount</th>
                    <th style="text-align:center;font-size: 12px;width:8%;">User</th>
                    <th style="text-align:center;font-size: 12px;width:3%;" title="Edit">
                        <span class="glyphicon glyphicon-pencil" style="font-size:16px">
                        </span>
                    </th>
                </tr>
            </thead>
        </table>
    </div>

    <div id="dvMain">
        @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
        @Html.HiddenFor(model => model.TransID, new { @autocomplete = "off", @class = "form-control", @id = "txtTransID" })
        <input id="txtID" hidden />
        <input id="txtCustomerID" hidden />
        <input hidden type="number" class="FormclrField" id="txtLatitude" />
        <input hidden type="number" class="FormclrField" id="txtLongtitude" />

        <div class="form-section-card" style="animation-delay:0.05s; z-index:3">
            <div class="form-section-title" style="cursor:pointer; user-select:none" onclick="toggleCustomerCard()">
                <i class="bi bi-person-vcard"></i> Customer Information
                <button type="button" id="btnToggleCustomer" class="card-collapse-btn ms-auto" title="Expand / Collapse" onclick="toggleCustomerCard(); event.stopPropagation();">
                    <i class="bi bi-plus-lg" id="icoToggleCustomer"></i>
                </button>
            </div>
            
            <div id="customerInfoBody" class="card-collapsible-body collapsed">
                <div class="row g-2 mb-2">
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="field-wrap">
                            <i class="bi bi-house field-icon"></i>
                            <label class="mod-label">Branch <span style="color:#d32f2f">*</span></label>
                            <select class="mod-select FormclrcmbField" id="cmbBranchName">
                                <option value="0">Select</option>
                            </select>
                            <div class="field-error clrdivs" id="divErrorOnBranchName"></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="field-wrap">
                            <i class="bi bi-map field-icon"></i>
                            <label class="mod-label">Beat Name</label>
                            <select class="mod-select FormclrcmbField" id="cmbBeatName">
                                <option value="0">Select</option>
                            </select>
                            <div class="field-error clrdivs" id="divErrorOnBeatName"></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="field-wrap">
                            <i class="bi bi-person-badge field-icon"></i>
                            <label class="mod-label">Salesman</label>
                            <select class="mod-select FormclrcmbField" id="cmbSalesManName">
                                <option value="0">Select</option>
                            </select>
                            <div class="field-error clrdivs" id="divErrorOnSalesManName"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <div class="field-wrap">
                        <i class="bi bi-person field-icon" id="Custinfo" style="cursor:pointer"></i>
                        <label class="mod-label">Customer <span style="color:#d32f2f">*</span></label>
                        <input type="text" class="mod-input FormclrField" id="txtCustomerName" autocomplete="off" />
                        <div class="field-error clrdivs" id="divErrorOnCustName"></div>
                    </div>
                </div>
            </div>
        </div>
         <div class="form-section-card" style="animation-delay:0.12s; z-index:2">
                <div class="form-section-title">
                    <i class="bi bi-funnel"></i> Activity Type &amp; Product Filter
                </div>
                <div class="row g-2 align-items-start">
                    
                    <div class="col-12 col-sm-6 col-md-3">
                        <div style="font-size:10.5px;font-weight:700;color:#555;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Activity Type</div>
                        <div class="radio-pill-group">
                            <input type="radio" name="rdoSelect" id="rdoOT" checked />
                            <label for="rdoOT"><i class="bi bi-bag-check"></i> Order Taken</label>

                            <input type="radio" name="rdoSelect" id="rdoFeedback" />
                            <label for="rdoFeedback"><i class="bi bi-chat-dots"></i> Feedback</label>

                            <input type="radio" name="rdoSelect" id="rdoNOT" />
                            <label for="rdoNOT"><i class="bi bi-x-circle"></i> No Order Today</label>
                        </div>
                    </div>
                    
                    <div class="col-12 col-sm-6 col-md-2 tblot1">
                        <div style="font-size:10.5px;font-weight:700;color:#555;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Filter By</div>
                        <div class="filter-pill-group">
                            <input type="radio" name="rdoFilter" id="rdo1" checked />
                            <label for="rdo1">Manufacturer</label>

                            <input type="radio" name="rdoFilter" id="rdo2" />
                            <label for="rdo2">Category</label>

                            <input type="radio" name="rdoFilter" id="rdo3" />
                            <label for="rdo3">Product</label>
                        </div>
                    </div>
                    
                    <div class="col-12 col-md-5 tblot1">
                        <div id="MainFilterData">
                            <div class="field-wrap">                                
                                <input type="text" class="mod-input" id="txtProductName" autocomplete="off" />
                                <div class="field-error clrdivs" id="divErrorOnProductName"></div>
                            </div>
                        </div>
                        <div id="ManufCC">
                            <div class="field-wrap">
                                @*<label class="mod-label">Manufacturer</label>*@
                                <select style="width:100%" data-placeholder="Select Manufacturer..." multiple class="chosen-Manuf form-control" name="Manuf">
                                    @{
                                        <option value="0"></option>
                                    }
                                </select>
                                <button type="button" class="mfr-chosen-toggle select toggle-btn-sm select-all"><i class="bi bi-check2-all"></i> All</button>
                                <button type="button" class="mfr-chosen-toggle deselect toggle-btn-sm deselect-all"><i class="bi bi-x-lg"></i> None</button>
                            </div>                           
                        </div>
                        <div id="ProdGrpCC">
                            <div class="field-wrap">
                                @*<label class="mod-label">Category</label>*@
                                <select style="width:100%" data-placeholder="Select Product Group..." multiple class="chosen-Category form-control">
                                    @{
                                        <option value="0"></option>
                                    }
                                </select>
                                <button type="button" class="pgrp-chosen-toggle select toggle-btn-sm select-all" title="Select All"><i class="bi bi-check2-all"></i> All</button>
                                <button type="button" class="pgrp-chosen-toggle deselect toggle-btn-sm deselect-all" title="De-select All"><i class="bi bi-x-lg"></i> None</button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <button id="btnLoadSelData" type="button" class="tblot1">
                            <i class="bi bi-cloud-download"></i> Load Selected Data
                        </button>
                    </div>
                </div>
