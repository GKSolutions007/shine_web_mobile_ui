    $('#btnLoadVLSData').click(function () {
        var IsValid = true;
        $(".clrdivserror").html("");
        //if ($('#txtVLSNo').val() == '') {
        //    IsValid = false;
        //    $('#divErrorOnInvNo').html('* VLS No should not be empty');
        //    $('#txtVLSNo').focus();
        //}
        if ($('#cmbSalesman').val() == '' || $('#cmbSalesman').val() == 0 || $('#cmbSalesman').val() == null) {
