<script>
        var UID = '@Session["LoginUserID"]';
var Aurl = '@Session["APIurl"]';
   var DecVal = '@Session["DecimalValues"]';
    var strCompanyCode = '@Session["CompanyCode"]';
    var DefSMID = 0;
    var PrintTransID = 4, PrintConfigID = 0;
    $("#lnkMob1,#lnkMob2").hide();
    LoadBranchByRoles(strCompanyCode, '#cmbBranch');
    var enabSm = UID == 1 || UID == 2 ? false : true;
    // ===== Spot Sales Report - Row View (2 columns per row) =====
    // Data currently bound to TableData (populated from the LoadVLSData ajax
    // response) is rendered as one row per product, each row split into 2
    // columns: column 1 has the image, product name, MRP, previous sold qty,
    // today VLS and today sold qty; column 2 has only Avail VLS Qty,
    // highlighted with a green theme. ProdID is kept only as a hidden field.

    // Reads a field off a row, tolerating keys with a trailing space
    // (e.g. "MRP " / "Imagedata ") as seen in the sample TableData shape.
    function getFieldVal(row, key) {
        if (!row) return '';
        if (row[key] !== undefined && row[key] !== null) return row[key];
        if (row[key + ' '] !== undefined && row[key + ' '] !== null) return row[key + ' '];
        return '';
    }

    // Keeps track of whatever is currently on screen (post search-filter) so
    // that toggling "Show Image" or exporting to Excel both act on the same
    // visible set of rows.
    var currentDisplayData = [];

    function renderProductCards(data) {
        currentDisplayData = data || [];
        var $container = $('#dvProductRows');
        $container.empty();
        $('#lblQtyItemCount').text(currentDisplayData.length);

        if (!currentDisplayData.length) {
            $container.html('<div class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No records found</div>');
            return;
        }

        var showImage = $('#chkShowImage').is(':checked');
        var html = '';
        $.each(currentDisplayData, function (i, item) {
            var prodId = getFieldVal(item, 'ProdID');
            var name = getFieldVal(item, 'ProductName');
            var prevSold = parseFloat(getFieldVal(item, 'PreviousSoldQty')) || 0;
            var todayVls = parseFloat(getFieldVal(item, 'TodayVLS')) || 0;
            var todaySold = parseFloat(getFieldVal(item, 'TodaySoldQty')) || 0;
            var availQty = parseFloat(getFieldVal(item, 'AvailVLSQty')) || 0;
            var mrp = parseFloat(getFieldVal(item, 'MRP')) || 0;
            var imgVal = getFieldVal(item, 'Imagedata');

            var imgHtml = '';
            var fieldsHtml = '';
            if (showImage) {
                // ----- Show Image checked: existing design (image + 4 stacked rows) -----
                var hasImg = imgVal && imgVal.toString().trim() !== '' && imgVal.toString().trim().toUpperCase() !== 'NULL';
                if (hasImg) {
                    var src = imgVal.toString().indexOf('data:image') === 0 ? imgVal : ('data:image/jpeg;base64,' + imgVal);
                    imgHtml = '<div class="ssr-img-wrap"><img src="' + src + '" class="ssr-thumb" alt="' + name + '" '
                        + 'onerror="this.classList.add(\'no-img\');this.removeAttribute(\'src\');this.innerHTML=\'<i class=\\\'bi bi-card-image\\\'></i>\';" /></div>';
                } else {
                    imgHtml = '<div class="ssr-img-wrap"><div class="ssr-thumb no-img"><i class="bi bi-card-image"></i></div></div>';
                }

                fieldsHtml = ''
                    + '      <div class="ssr-field"><span class="ssr-label">MRP:</span><span class="ssr-value">' + mrp.toFixed(2) + '</span></div>'
                    + '      <div class="ssr-field"><span class="ssr-label">Previous VLS Qty:</span><span class="ssr-value">' + prevSold.toFixed(2) + '</span></div>'
                    + '      <div class="ssr-field"><span class="ssr-label">Today VLS:</span><span class="ssr-value">' + todayVls.toFixed(2) + '</span></div>'
                    + '      <div class="ssr-field"><span class="ssr-label">Today Sold Qty:</span><span class="ssr-value">' + todaySold.toFixed(2) + '</span></div>';
            } else {
                // ----- Show Image unchecked: no image, MRP/Previous Sold Qty on
                // row 1 and Today VLS/Today Sold Qty on row 2 (2 rows instead of 4) -----
                fieldsHtml = ''
                    + '      <div class="ssr-field-row">'
                    + '        <div class="ssr-field"><span class="ssr-label">MRP:</span><span class="ssr-value">' + mrp.toFixed(2) + '</span></div>'
                    + '        <div class="ssr-field"><span class="ssr-label">Previous VLS Qty:</span><span class="ssr-value">' + prevSold.toFixed(2) + '</span></div>'
                    + '      </div>'
                    + '      <div class="ssr-field-row">'
                    + '        <div class="ssr-field"><span class="ssr-label">Today VLS:</span><span class="ssr-value">' + todayVls.toFixed(2) + '</span></div>'
                    + '        <div class="ssr-field"><span class="ssr-label">Today Sold Qty:</span><span class="ssr-value">' + todaySold.toFixed(2) + '</span></div>'
                    + '      </div>';
            }

            html += ''
                + '<div class="ssr-row">'
                // ProdID is retained only as a hidden field - never shown to the user
                + '  <input type="hidden" class="ssr-prodid" value="' + prodId + '" />'
                // ----- Column 1: image (if shown), name, MRP, previous sold, today VLS, today sold -----
                + '  <div class="ssr-col-details">'
                +      imgHtml
                + '    <div class="ssr-body">'
                + '      <div class="ssr-name-val">' + name + '</div>'
                +      fieldsHtml
                + '    </div>'
                + '  </div>'
                // ----- Column 2: Avail VLS Qty only, green highlighted -----
                + '  <div class="ssr-col-avail">'
                + '    <div class="ssr-avail-inner">'
                //+ '      <span class="ssr-avail-label">Avail VLS Qty</span>'
                + '      <span class="avail-green-badge">' + availQty.toFixed(2) + '</span>'
                + '    </div>'
                + '  </div>'
                + '</div>';
        });
        $container.html(html);
    }

    // Initially hide VLS Summary / Product Details / Save-Clear panels until
    // LoadVLSData() successfully loads a VLS document
    $("#dvInvoicesummary,#dvProductdetails,#dvReceiverInfo,#btnReset").hide();

    // ----- Grid search box: filters TableData by Name / ProdID -----
    $('#txtProductSearch').on('keyup search input', function () {
        var term = $.trim(this.value).toLowerCase();
        if (!term) {
            renderProductCards(TableData);
            return;
        }
        var filtered = $.grep(TableData, function (item) {
            var name = (getFieldVal(item, 'ProductName') || '').toString().toLowerCase();
            var prodId = (getFieldVal(item, 'ProdID') || '').toString().toLowerCase();
            return name.indexOf(term) !== -1 || prodId.indexOf(term) !== -1;
        });
        renderProductCards(filtered);
    });

    // ----- Show/Hide image: keep chkShowImage's original toggle behaviour -----
    // Checked -> image is shown in every card; Unchecked -> image is hidden.
    $('#chkShowImage').on('change', function () {
        renderProductCards(currentDisplayData);
    });

    // ----- Export to Excel -----
    // Row 1: Report Name, Row 2: Branch, Row 3: Salesman, then the report
    // data (whatever is currently displayed / filtered) with only the
    // relevant columns (ProdID and Imagedata are left out of the export).
    function exportSpotSalesReport() {
        if (!currentDisplayData || currentDisplayData.length === 0) {
            showErrorSnackbar("No data to export");
            return;
        }
        if (typeof XLSX === 'undefined') {
            showErrorSnackbar("Excel export library failed to load");
            return;
        }

        var branchText = $('#cmbBranch option:selected').text();
        var salesmanText = $('#cmbSalesman option:selected').text();

        var wsData = [];
        wsData.push(['Report Name ', 'VLS Closing Report']);
        wsData.push(['Branch ', branchText]);
        wsData.push(['Salesman ', salesmanText]);
        wsData.push([]);
        wsData.push(['Product Name', 'Previous VLS Qty', 'Today VLS', 'Today Sold Qty', 'Avail VLS Qty', 'MRP']);

        $.each(currentDisplayData, function (i, item) {
            wsData.push([
                getFieldVal(item, 'ProductName'),
                (parseFloat(getFieldVal(item, 'PreviousSoldQty')) || 0).toFixed(2),
                (parseFloat(getFieldVal(item, 'TodayVLS')) || 0).toFixed(2),
                (parseFloat(getFieldVal(item, 'TodaySoldQty')) || 0).toFixed(2),
                (parseFloat(getFieldVal(item, 'AvailVLSQty')) || 0).toFixed(2),
                (parseFloat(getFieldVal(item, 'MRP')) || 0).toFixed(2)
            ]);
        });

        var ws = XLSX.utils.aoa_to_sheet(wsData);
        // Merge the value cell of the 3 header rows across the data columns
        ws['!merges'] = [
            { s: { r: 0, c: 1 }, e: { r: 0, c: 5 } },
            { s: { r: 1, c: 1 }, e: { r: 1, c: 5 } },
            { s: { r: 2, c: 1 }, e: { r: 2, c: 5 } }
        ];
        ws['!cols'] = [{ wch: 28 }, { wch: 16 }, { wch: 12 }, { wch: 14 }, { wch: 14 }, { wch: 10 }];

        // ----- Add a Filter (AutoFilter) to every column of the data table -----
        var headerRowIdx = 4; // row index (0-based) of 'Product Name', 'Previous Sold Qty', ...
        var lastRowIdx = wsData.length - 1;
        var lastColIdx = wsData[headerRowIdx].length - 1;
        ws['!autofilter'] = {
            ref: XLSX.utils.encode_range({ s: { r: headerRowIdx, c: 0 }, e: { r: lastRowIdx, c: lastColIdx } })
        };

        // ----- Set background color (and bold white text) on the header row -----
        var headerStyle = {
            fill: { patternType: 'solid', fgColor: { rgb: '0DCAF0' } },
            font: { bold: true, color: { rgb: 'FFFFFF' } },
            alignment: { horizontal: 'center', vertical: 'center' }
        };
        for (var c = 0; c <= lastColIdx; c++) {
            var cellRef = XLSX.utils.encode_cell({ r: headerRowIdx, c: c });
            if (ws[cellRef]) ws[cellRef].s = headerStyle;
        }

        var wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Spot Sales Report');

        function pad2(n) { return (n < 10 ? '0' : '') + n; }
        var now = new Date();
        // yyyyMMddhhmmsss: seconds plus one extra tenth-of-a-second digit
        var timestamp = '' + now.getFullYear() + pad2(now.getMonth() + 1) + pad2(now.getDate())
            + pad2(now.getHours()) + pad2(now.getMinutes()) + pad2(now.getSeconds())
            + Math.floor(now.getMilliseconds() / 100);

        var safeSalesman = ($.trim(salesmanText) || 'Salesman').replace(/[^a-zA-Z0-9]+/g, '_');
        var fileName = 'SSR_' + safeSalesman + '_' + timestamp + '.xlsx';

        //XLSX.writeFile(wb, fileName, { cellStyles: true, bookType: 'xlsx' });
        var wbout = XLSX.write(wb, {
            bookType: 'xlsx',
            type: 'array',
            cellStyles: true
        });

        var blob = new Blob(
            [wbout],
            {
                type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
            }
        );

        if (isMobileBrowser()) {// window.Android && Android.downloadExcel
            var reader = new FileReader();
            reader.onloadend = function () {
                var base64 = reader.result.split(',')[1];
                Android.downloadExcel(base64, fileName);
            };
            reader.readAsDataURL(blob);
        }
        else {
            XLSX.writeFile(wb, fileName, { cellStyles: true, bookType: 'xlsx' });
        }
    }

    $('#btnExportExcel').click(function () {
        exportSpotSalesReport();
    });


        $(window).scroll(function () {
            if ($(this).scrollTop() >= 200) {
                $('#return-to-top').fadeIn(200);
                $('#return-to-top').css("display", "flex");
            } else {
                $('#return-to-top').fadeOut(200);
            }
        });

        $('#return-to-top').click(function () {
            $('body,html').animate({
                scrollTop: 0
            }, 500);
        });
    function ClearForm() {
        TableData = [];
        renderProductCards([]);
        $(".info-value").text("--");
        $(".clrdivserror").html("");
        $("#txtVLSNo").val("");
        $("#txtVLSID,#txtVLSStatus").val("");
        $("#txtCustomerName").val("");
        $("#txtCustomerID").val("");
        $("#txtProductSearch").val("");
        $("#lnkMob1,#lnkMob2").hide();
        $("#cmbSalesman").val(DefSMID);
        $("#cmbSalesman").prop("disabled", enabSm);
        VLSData = [];
        VLSProductData = [];
        // Summary / Product Details / Save-Clear panels should only be visible
        // after VLS data has been successfully loaded
        $("#dvInvoicesummary,#dvProductdetails,#dvReceiverInfo,#btnReset").hide();
    }
    var Customerlist = [];

    GetInitialData();
    function GetInitialData() {
        $.ajax({
            url: Aurl + "vls/initialdata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, ID: UID
            },
            success: function (data) {
                Customerlist = [];
                var Todayroute = data.Table;
                var Salesmans = data.Table1;

                $('#cmbSalesman').find("option").remove();
                $('#cmbSalesman').append($('<option/>', {
                    value: 0,
                    text: "-- Select --",
                }));
                $.each(Salesmans, function (i, items) {
                    $('#cmbSalesman').append($('<option/>', {
                        value: items.ID,
                        text: items.Name,
                    }));
                });

                if (Todayroute) {
                    DefSMID = Todayroute[0].SalesmanID;
                    $('#cmbSalesman').val(Todayroute[0].SalesmanID);
                    $("#cmbSalesman").prop("disabled", enabSm);
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

    var VLSData = [],VLSProductData = [];
    function LoadVLSData() {
        var NSalesmanID = $('#cmbSalesman').val();
        var nBranch = $('#cmbBranch').val();
        $.ajax({
            url: Aurl + "vls/generatedata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, BranchID: nBranch, SalesmanID: NSalesmanID
            },
            success: function (data) {
                VLSData = [], VLSProductData = [];
                var invoicedata = data;
                console.log(invoicedata)
                if (data.length > 0) {
                    // Bind the TableData variable - the Product Details card
                    // view (and Export to Excel) both read from TableData.
                    TableData = data;
                    if (TableData.length == 0) {
                        showErrorSnackbar("No items found");
                    }
                    renderProductCards(TableData);
                    // VLS data loaded successfully - reveal the summary,
                    // product details, and save/clear panels
                    $("#dvInvoicesummary,#dvProductdetails,#dvReceiverInfo,#btnReset").show();

                }
                else {
                    showErrorSnackbar("No records found")
                    TableData = [];
                    renderProductCards([]);
                    $("#dvInvoicesummary,#dvProductdetails,#dvReceiverInfo,#btnReset").hide();
                }

            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
