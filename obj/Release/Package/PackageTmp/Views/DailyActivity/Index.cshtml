    function CustomerInfo(nCustID) {

        $.ajax({
            url: Aurl + "customerinfo",
            type: "GET",
            datatype: "JSON",
            data: {
                CompanyCode: strCompanyCode, CustomerID: nCustID
            },
            success: function (data) {
                
                var CustomerData = JSON.parse(data[0].Customerdata);
                var Imagedata = data[0].Imagedata.length > 0 ? data[0].Imagedata[0].ImageData : null;                
                InfoDialogMsg(buildCustomerInfoHtml(CustomerData[0], Imagedata), "Customer Details");                
            },
            error: function (data) {

            }
        });
    }
    function buildCustomerInfoHtml(cust, imagedata) {
        const fullAddress = [cust.Billadd1, cust.Billadd2, cust.Billadd3]
            .filter(Boolean)
            .join(', ');

        const imageHtml = imagedata
            ? `<img src="data:image/jpeg;base64,${imagedata}" alt="Customer" class="custinfo-avatar" />`
            : `<div class="custinfo-avatar custinfo-avatar--placeholder">${(cust.Name || '?').charAt(0).toUpperCase()}</div>`;

        const html = `
  <div class="custinfo-card">
    <div class="custinfo-card__header">
      ${imageHtml}
      <div class="custinfo-card__title">
        <h3>${cust.Name || '-'}</h3>
        <span class="custinfo-code">${cust.Code || '-'}</span>
      </div>
    </div>

    <div class="custinfo-card__body">
      <div class="custinfo-row">
        <span class="custinfo-label">Address</span>
        <span class="custinfo-value">${fullAddress || '-'}</span>
      </div>
      <div class="custinfo-row">
        <span class="custinfo-label">Pincode</span>
        <span class="custinfo-value">${cust.Pincode || '-'}</span>
      </div>
      <div class="custinfo-row">
        <span class="custinfo-label">Contact Person</span>
        <span class="custinfo-value">${cust.ContactPerson || '-'}</span>
      </div>
      <div class="custinfo-row">
        <span class="custinfo-label">Mobile</span>
        <span class="custinfo-value">${cust.Mob1 || '-'}</span>
      </div>
      <div class="custinfo-row">
        <span class="custinfo-label">Email</span>
        <span class="custinfo-value">${cust.Email || '-'}</span>
      </div>
      <div class="custinfo-row">
        <span class="custinfo-label">GSTIN</span>
        <span class="custinfo-value">${cust.GSTIN || '-'}</span>
      </div>
    </div>
  </div>

  <style>
    .custinfo-card {
      font-family: 'Segoe UI', Roboto, Arial, sans-serif;
      max-width: 420px;
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      overflow: hidden;
      border: 1px solid #eef0f3;
    }
    .custinfo-card__header {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 18px 20px;
      background: linear-gradient(135deg, #4f7cff, #6a5cff);
      color: #fff;
    }
    .custinfo-avatar {
      width: 100px; height: 100px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.7);
      flex-shrink: 0;
    }
    .custinfo-avatar--placeholder {
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.2);
      font-weight: 600; font-size: 20px;
    }
    .custinfo-card__title h3 {
      margin: 0; font-size: 16px; font-weight: 600;
    }
    .custinfo-code {
      font-size: 12px; opacity: 0.85;
    }
    .custinfo-card__body {
      padding: 16px 20px;
    }
    .custinfo-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 8px 0;
      border-bottom: 1px solid #f2f3f5;
      font-size: 13.5px;
    }
    .custinfo-row:last-child { border-bottom: none; }
    .custinfo-label {
      color: #8a8f98;
      font-weight: 500;
      min-width: 110px;
    }
    .custinfo-value {
      color: #1f2329;
      text-align: left;
      word-break: break-word;
    }
  </style>
  `;

        return html;
    }



    function GetCustomerbyLocation() {

        //alert("Time :" + curtime);
        $('#divErrorOnCustName').html('');
        $('#divErrorOnPopupSurrCust').html('');
        $('#lblCurrLocation').text("");
        var lats = $('#txtLatitude').val();
        var longs = $('#txtLongtitude').val();
        if (lats != "" && longs != "") {
            TableSurroundCustomers.clear().draw();
            $.ajax({
                url: Aurl + "surroundingcustomers",
                type: "GET",
                datatype: "JSON",
                data: {
                    CompanyCode: strCompanyCode, UserID: UID, Latitude: lats, Longitude: longs
                },
                success: function (data) {
                    $('#lblCurrLocation').text(lats + "," + longs);
                    if (data.length > 0) {
                        if (data[0].Mode == 0) {
                            modal.show();
                            var customerdata = (data[0].Customerdata);
                            console.log("customerdata", customerdata);
                            $.each(customerdata, function (i, items) {
                                TableSurroundCustomers.row.add([
                                    items.ID,
                                    items.Customername,
                                    renderCustomerCell(items, i)                                  
                                ]).draw(false);
                            });
                        } else {
                            modal.hide();
                            showErrorSnackbar(data[0].Message);
                        }
                    } else {
                        $('#divErrorOnCustName').html('No Customers surrounding you.');
                        $('#divErrorOnPopupSurrCust').html('No Customers surrounding you.');
                    }
                }
            });
        } else {
            modal.hide();
            $('#divErrorOnCustName').html('Location Not Identified. Try again');
        }
    }
    function initials(name) {
        if (!name) return "?";
        var parts = name.trim().split(/\s+/);
        var chars = parts.length > 1 ? parts[0][0] + parts[1][0] : parts[0].slice(0, 2);
        return chars.toUpperCase();
    }

    function renderCustomerCell(items, rowIndex) {
        var avatar;
        if (items.ImageData && items.ImageData.trim() !== "") {
            var imgSrcdata = "data:image/jpeg;base64," + items.ImageData;
            avatar = '<img class="cust-avatar" src="' + imgSrcdata + '" alt="' + items.Customername + '" />';
        } else {
            avatar = '<div class="cust-avatar-fallback">' + initials(items.Customername) + '</div>';
        }

        // Stagger the entrance animation per row, capped so long lists don't feel sluggish
        var delay = Math.min(rowIndex * 60, 400);

        return (
            '<div class="cust-card" style="animation-delay:' + delay + 'ms">' +
            avatar +
            '<div class="cust-body">' +
            '<div class="cust-name">' + items.Customername + '</div>' +
            '<div class="cust-meta">' +            
            '<span><i class="bi bi-signpost-split-fill"></i>' + items.Radius + '</span>' +
            '<span><i class="bi bi-geo-alt-fill"></i>' + items.Address + '</span>' +
            '</div>' +
            '</div>' +
            '</div>'
        );
    }
