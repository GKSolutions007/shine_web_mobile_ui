    function SetAutlistforFields(FieldID, arryvalue) {
        $("#" + FieldID).autocomplete({
            minLength: 0,
            source: arryvalue,
            select: function (event, ui) {
                $("#" + FieldID).val(ui.item.name);
                if (FieldID == "txtCustomerName") {
                    //customer info function
                    GetData(5, ui.item.id);
