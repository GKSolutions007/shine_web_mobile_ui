    // ===== Merged Product Info Column helper =====
    // Builds the single merged column markup: image on the left,
    // and on the right: Name (line 1), PriceDesc (line 2), all inputs with labels (line 3).
    function buildProdInfoCell(value, meta, options) {
        options = options || {};
        var rowIndex = meta.row;

        var imgHtml;
        if (value.Imagedata) {
            var src = 'data:image/png;base64,' + value.Imagedata;
            imgHtml = '<img class="prod-thumb" src="' + src + '" />';
        } else {            
            imgHtml = '<div class="prod-thumb prod-thumb-empty"></div>';            
        }

        var qtyVal = options.qtyVal !== undefined && options.qtyVal !== null ? options.qtyVal : 0;
        var priceVal = options.priceVal !== undefined && options.priceVal !== null ? options.priceVal : 0;
        var discVal = options.discVal !== undefined && options.discVal !== null ? options.discVal : 0;

        var fidsQty = 'chkProductsQty_' + rowIndex;
        var fidsPrice = 'chkProductsPrice_' + rowIndex;
        var fidsDisc = 'chkProductsDiscPern_' + rowIndex;

        var qtyDisabled = options.qtyDisabled ? 'disabled' : '';
        var priceDisabled = options.priceDisabled ? 'disabled' : '';
        var discDisabled = options.discDisabled ? 'disabled' : '';

        var qtyInput = '<input ' + qtyDisabled + ' type="number" class="dgvQty" txttag="' + qtyVal + '" name="Qty" id="' + fidsQty + '" value="' + parseFloat(qtyVal).toFixed(DecVal) + '" title="' + qtyVal + '" style="text-align:right;width:55px;" maxlength="16"/>';
        var priceInput = '<input ' + priceDisabled + ' type="number" class="dgvPrice" txttag="' + priceVal + '" name="Price" id="' + fidsPrice + '" value="' + parseFloat(priceVal).toFixed(DecVal) + '" title="' + priceVal + '" style="text-align:right;width:55px;" maxlength="16"/>';
        var discInput = '<input ' + discDisabled + ' type="number" class="dgvDiscPern" txttag="' + discVal + '" name="DiscountPern" id="' + fidsDisc + '" value="' + parseFloat(discVal).toFixed(DecVal) + '" title="' + discVal + '" style="text-align:right;width:55px;" maxlength="16"/>';

        var _action =
            '<div class="prod-row-wrap">' +
                '<div class="prod-img-col">' + imgHtml + '</div>' +
                '<div class="prod-detail-col">' +
                    '<div class="prod-name-row"><b>' + (value.Name != null ? value.Name : '') + '</b></div>' +
                    '<div class="prod-pricedesc-row">' + (value.PriceDesc != null ? value.PriceDesc : '') + '</div>' +
                    '<div class="prod-inputs-row">' +
                        '<span class="prod-input-group"><label>Qty :</label>' + qtyInput + '</span>' +
                        '<span class="prod-input-group"><label>\u20B9 :</label>' + priceInput + '</span>' +
                        '<span class="prod-input-group d-none"><label>D %:</label>' + discInput + '</span>' +
                    '</div>' +
                '</div>' +
            '</div>';
        return _action;
    }

