                toggleDiscountsCard();
            }
            //if (objItemDetails.length == 0) {
            //    IsValid = false;
            //    showErrorSnackbar("Add atleast one items");
            //}
            if (IsValid) {
                AddItemsinCart();
            }
        }
        else {
