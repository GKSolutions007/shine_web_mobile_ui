    GetSetFilterData(6, UID, 0);
    function GetSetFilterData(nMode, strID, strAllsts = "0") {
        $.ajax({
            url: Aurl + "dailyactivity/getdata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, Mode: nMode, ID: strID, SalesmanID: strAllsts
            },
            success: function (data) {
                if (nMode == 6) {
                    var Docjsdata = JSON.parse(data);// JSON.parse(data);
                    var cardHtml = "";
                    if (Docjsdata.length === 0) {
                        cardHtml = '<div class="col-md-12 text-center" style="margin-top:20px;"><h5>No records found</h5></div>';
                    } else {
                        $.each(Docjsdata, function (index, value) {

                            var rowIndex = index;

                            cardHtml += '<div class="col-12 col-md-4 card-item">';
                            cardHtml += '  <div class="card card-view-item shadow-sm">';

                            // Header
                            cardHtml += '    <div class="card-header card-header-view">';
                            cardHtml += '      <i class="bi bi-person"></i> <span>' + (value.CustomerName || "Unknown Customer") + '</span>';
                            cardHtml += '    </div>';

                            // Body
                            cardHtml += '    <div class="card-body card-body-view">';

                            // Row 1: Date & Activity
                            cardHtml += '      <div class="row mb-1">';
                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-calendar"></i> ' + (value.DocDate || "-") + '</span>';
                            cardHtml += '        </div>';

                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-cart"></i> ' + (value.Activity || "-") + '</span>';
                            cardHtml += '        </div>';
                            cardHtml += '      </div>';

                            // Row 2: Amount & Beat
                            cardHtml += '      <div class="row mb-1">';
                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block text-success fw-bold small"><i class="bi bi-currency-rupee"></i> ' + (value.Value || "0.00") + '(' + (value.ItemsCount || "0") + ')</span>';
                            cardHtml += '        </div>';

                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-geo-alt"></i> ' + (value.BeatName || "-") + '</span>';
                            cardHtml += '        </div>';
                            cardHtml += '      </div>';

                            // Row 3: Salesman & Status
                            cardHtml += '      <div class="row">';
                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-person-badge"></i> ' + (value.SalesmanName || "-") + '</span>';
                            cardHtml += '        </div>';

                            // Status Logic
                            var status = value.Status || "-";
                            var statusIcon = "bi-info-circle";
                            var statusClass = "bg-secondary";

                            if (status === "Open" || status === "Amendment") {
                                statusIcon = "bi-envelope-open";
                                statusClass = "bg-primary";
                            }
                            else if (status === "Amended") {
                                statusIcon = "bi-pencil-square";
                                statusClass = "bg-warning";
                            }
                            else if (status === "Cancelled") {
                                statusIcon = "bi-x-circle";
                                statusClass = "bg-danger";
                            }
                            else if (status === "Processed") {
                                statusIcon = "bi-check-circle";
                                statusClass = "bg-success";
                            }

                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="badge ' + statusClass + '"><i class="bi ' + statusIcon + '"></i> ' + status + '</span>';
                            cardHtml += '        </div>';

                            cardHtml += '      </div>';

                            cardHtml += '    </div>'; // Body End

                            // Footer
                            cardHtml += '    <div class="card-footer card-footer-view text-right">';

                            cardHtml += $("#txtViewID").val() == 0 ? '' :
                                '<button id="btnView' + rowIndex + '" type="button" class="btn btn-info btn-sm clsview" data-id="' + value.ID + '" data-customername="' + value.CustomerName + '"><i class="bi bi-eye"></i> View</button>';

                            cardHtml += (value.StatusID == 1 || value.StatusID == 3) && $("#txtModifyID").val() == 1 ?
                                '<button id="btnEdit' + rowIndex + '" type="button" class="btn btn-warning btn-sm clsedit ms-2" data-id="' + value.ID + '" data-customername="' + value.CustomerName + '"><i class="bi bi-pencil"></i> Edit</button>' : '';

                            cardHtml += '    </div>';

                            cardHtml += '  </div>';
                            cardHtml += '</div>';

                        });
                    }

                    $('#divMobCollDocsList').html(cardHtml);
                }
                else if (nMode == 8 || nMode == 7) {
                    var Colljsdata = JSON.parse(data);
                    var HeaderData = Colljsdata.Table[0];
                    var DocData = Colljsdata.Table1;
                    $('#txtID').val(HeaderData.ID),
                        $('#txtStatusID').val(HeaderData.StatusID),
                        $('#cmbBeatName').val(HeaderData.BeatID),
                        $('#cmbSalesManName').val(HeaderData.SalesManID),
                        $('#txtCustomerID').val(HeaderData.CustomerID),
                        $('#txtCustomerName').val(HeaderData.CustomerName),
                        $('#cmbBranchName').val(HeaderData.BranchID),
                        $('#txtFeedBack').val(HeaderData.FeedBack),
                        $('#txtNarration').val(HeaderData.Narration);
                    $('#txtAddnlDisc').val(parseFloat(HeaderData.AdDiscPern).toFixed(DecVal));
                    $('#txtTradeDisc').val(parseFloat(HeaderData.TrDiscPern).toFixed(DecVal));

                    $('#rdoOT').prop('checked', HeaderData.ActivityID == 1);
                    $('#rdoFeedback').prop('checked', HeaderData.ActivityID == 2);
                    $('#rdoNOT').prop('checked', HeaderData.ActivityID == 3);
                    rdoActionID = HeaderData.ActivityID;
                    var isView = nTransMode == 5 ? "disabled" : "";
                    $('#tblProductInfo').DataTable({
                        scrollY: "500px",
                        scrollX: true,
                        scrollCollapse: true,
                        paging: false,
                        destroy: true,
                        data: DocData,
                        fixedColumns: false,
                        ordering: false,
                        searching: true,
                        sorting: false,
                        columns: [
                            { "data": "ID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                            { "data": "Rate", "autoWidth": true, "visible": false, className: "dt-body-left" },
                            { "data": "Imagedata", "autoWidth": true, "visible": false, className: "dt-body-left" },
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var enbPrice = ($("#txtEnablePrice").val() == '0' || nTransMode == 5);
                                    return buildProdInfoCell(value, meta, {
                                        qtyVal: value.Qty,
                                        priceVal: value.Price,
                                        discVal: value.Discount,
                                        qtyDisabled: nTransMode == 5,
                                        priceDisabled: enbPrice,
                                        discDisabled: nTransMode == 5
                                    });
                                },
                            }
                        ],
                        initComplete: function () {
                            // ? Attach row click event AFTER table is loaded
                            $('#tblProductInfo tbody').on('click', 'tr', function () {
                                //showSuccessSnackbar("row click");
                                $(this).toggleClass('selected-row');
                            });
                            applyImageToggleState();
                        }
                    });
                    Table = $('#tblProductInfo').DataTable();
                    if (Table.rows().count() == 0) {
                        showErrorSnackbar("No items added")
                    }
                    FieldPermissions();
                    setTimeout(() => {
                        ShowHideFields(HeaderData.ActivityID == 1);
                        CalcProdDtl();
                    }, 500);
                    

                }
            },
            error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
