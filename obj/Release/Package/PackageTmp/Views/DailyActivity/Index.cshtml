@model ShineWebMobile.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/chosen.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/Content/surroundingcustomerstyle.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/chosen.jquery.min.js"></script>
<script src="~/Scripts/jquerychoose.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>

<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    .selected-row {
        background-color: #cce5ff !important; /* Light blue, change as needed */
    }

    th, td {
        white-space: nowrap;
    }

    .toolbar, .dt-search {
        float: right;
    }

    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 10; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 75%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .modalProdInfo {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 10; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalProdInfo-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 75%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalProdInfo-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closePinfo {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closePinfo:hover,
        .closePinfo:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -35%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }
    /*input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .9em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }

    .each {
        border-bottom: 1px solid #555;
        padding: 3px 0;
    }

    .acItem .name {
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .acItem .desc {
        font-size: 10px;
        font-family: Arial, Helvetica, sans-serif;
        color: #555;
    }

    .ui-autocomplete {
        max-height: 245px;
        overflow-y: auto;
        overflow-x: hidden;
    }
</style>
<style>
    #tblProductInfo tr td input {
        font-weight: 600;
    }

    /* ===== Merged Product Info Column (Image + Name + PriceDesc + Inputs) ===== */
    .prod-row-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: normal;
    }

    .prod-img-col {
        flex: 0 0 85px;
        width: 46px;
    }

    .prod-thumb {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #ddd;
        display: block;
    }

    .prod-thumb-empty {
        width: 90px;
        height: 90px;
    }

    .prod-detail-col {
        flex: 1 1 auto;
        min-width: 0;
    }

    .prod-name-row {
        font-size: 12px;
        white-space: normal;
        word-break: break-word;
    }

    .prod-pricedesc-row {
        font-size: 11px;
        color: #666;
        margin: 2px 0 4px 0;
        white-space: normal;
        word-break: break-word;
    }

    .prod-inputs-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 2px;
    }

    .prod-input-group {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        white-space: nowrap;
    }

        .prod-input-group label {
            margin: 0;
            font-weight: 600;
            white-space: nowrap;
        }

    /* Image Show/Hide toggle - when hidden, only the image column disappears,
       name / price-desc / inputs remain visible */
    #tblProductInfo.hide-prod-image .prod-img-col {
        display: none;
    }

    .img-toggle-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
    }

        .img-toggle-bar label {
            font-size: 12px;
            font-weight: 600;
            margin: 0;
            cursor: pointer;
        }
    /* =============================================
       MODERNIZED dvMain STYLES
    ============================================= */
    /* Form Section Cards */
    .form-section-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,120,200,0.08);
        border: 1px solid #e8f0fe;
        margin-bottom: 14px;
        padding: 14px 16px 10px 16px;
        animation: slideInCard 0.35s cubic-bezier(.4,0,.2,1) both;
        transition: box-shadow 0.2s;
    }

        .form-section-card:hover {
            box-shadow: 0 6px 24px rgba(0,120,200,0.13);
        }

    .form-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #1a73e8;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        border-bottom: 1.5px solid #e8f0fe;
        padding-bottom: 6px;
    }

        .form-section-title i {
            font-size: 14px;
            color: #1a73e8;
        }
    /* Floating label inputs */
    .field-wrap {
        position: relative;
        margin-bottom: 6px;
    }

        .field-wrap .field-icon {
            position: absolute;
            left: 10px;
            top: 40%;
            transform: translateY(-50%);
            color: #1a73e8;
            font-size: 14px;
            z-index: 5;
            pointer-events: none;
        }

        .field-wrap .mod-input,
        .field-wrap .mod-select,
        .field-wrap .mod-textarea {
            width: 100%;
            padding: 10px 10px 7px 34px;
            font-size: 13px;
            border: 1.5px solid #d0dff7;
            border-radius: 8px;
            background: #f8fbff;
            color: #222;
            transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
            outline: none;
            appearance: none;
            -webkit-appearance: none;
        }

            .field-wrap .mod-input:focus,
            .field-wrap .mod-select:focus,
            .field-wrap .mod-textarea:focus {
                border-color: #1a73e8;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(26,115,232,0.12);
            }

        .field-wrap .mod-label {
            position: absolute;
            top: 0px;
            left: 34px;
            font-size: 10px;
            font-weight: 700;
            color: #1a73e8;
            letter-spacing: 0.05em;
            pointer-events: none;
            transition: all 0.2s;
        }

        .field-wrap .field-error {
            font-size: 10.5px;
            color: #d32f2f;
            margin-top: 2px;
            min-height: 0px;
            padding-left: 4px;
        }
        /* Chosen select reset for field-wrap */
        .field-wrap .chosen-container {
            width: 100% !important;
            position: relative;
            z-index: 1000; /* Ensure it stays above siblings within field-wrap */
        }

        .field-wrap .chosen-container-active {
            z-index: 3000 !important; /* Extremely high when open/active */
        }

        .field-wrap .chosen-single {
            border-radius: 8px !important;
            border: 1.5px solid #d0dff7 !important;
            background: #f8fbff !important;
            box-shadow: none !important;
            height: 46px !important;
            line-height: 42px !important;
            padding-left: 28px !important;
        }
    /* Fix for dropdowns getting cut off or hidden by subsequent section cards */
    .form-section-card {
        position: relative;
    }

    .field-wrap .chosen-drop {
        z-index: 5000 !important; /* Ensure the actual list is topmost */
    }

    /* Radio button pill groups */
    .radio-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

        .radio-pill-group input[type=radio] {
            display: none;
        }

        .radio-pill-group label {
            padding: 5px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            border: 1.5px solid #c5d9f5;
            background: #f0f6ff;
            color: #1a73e8;
            cursor: pointer;
            transition: all 0.18s;
            user-select: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .radio-pill-group input[type=radio]:checked + label {
            background: linear-gradient(135deg, #1a73e8, #0d52b8);
            color: #fff;
            border-color: #1a73e8;
            box-shadow: 0 2px 8px rgba(26,115,232,0.28);
        }

        .radio-pill-group label:hover {
            border-color: #1a73e8;
            background: #e3eeff;
        }
    /* Filter toggle group (Manuf/Category/Product) */
    .filter-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

        .filter-pill-group input[type=radio] {
            display: none;
        }

        .filter-pill-group label {
            padding: 4px 11px;
            border-radius: 16px;
            font-size: 11.5px;
            font-weight: 600;
            border: 1.5px solid #b2d0fb;
            background: #f0f7ff;
            color: #0b57d0;
            cursor: pointer;
            transition: all 0.18s;
            user-select: none;
        }

        .filter-pill-group input[type=radio]:checked + label {
            background: linear-gradient(135deg, #0b57d0, #1a73e8);
            color: #fff;
            border-color: #0b57d0;
            box-shadow: 0 1px 6px rgba(26,115,232,0.22);
        }
    /* Action bar */
    .dvMain-action-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px;
        padding: 5px 0 6px 0;
        border-top: 1.5px solid #e8f0fe;
        margin-top: 5px;
    }

        .dvMain-action-bar .btn {
            border-radius: 22px;
            font-size: 12.5px;
            font-weight: 600;
            padding: 6px 18px;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: all 0.18s;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }

            .dvMain-action-bar .btn:hover {
                transform: translateY(-2px) scale(1.04);
                box-shadow: 0 4px 14px rgba(0,0,0,0.15);
            }
    /* Cart badge row */
    .cart-badge-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-weight: 700;
        color: #1a73e8;
        font-size: 13px;
        padding: 4px 0;
    }

        .cart-badge-row i {
            font-size: 18px;
        }
    /* Table header modernize */
    #tblProductInfo thead th {
        background: linear-gradient(135deg, #1a73e8, #0d52b8) !important;
        color: #fff !important;
        font-size: 11px !important;
        text-align: center;
        border: none;
        padding: 8px 5px;
    }

    #tblProductInfo {
        font-size: 12px;
        border-radius: 10px;
        overflow: hidden;
    }
    /* Load Selected Data button */
    .customdabuttons {
        border-radius: 22px;
        font-weight: 700;
        font-size: 12.5px;
        background: linear-gradient(135deg, #00bcd4, #0097a7);
        border: none;
        color: #fff;
        padding: 8px 16px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.18s;
        box-shadow: 0 2px 8px rgba(0,150,200,0.2);
    }

    #customdabuttons:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(0,150,200,0.35);
    }
    /* Animations */
    @@keyframes slideInCard {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* Toggle buttons for select all/deselect */
    .toggle-btn-sm {
        border-radius: 14px;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border: 1.5px solid;
        cursor: pointer;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .toggle-btn-sm.select-all {
            color: #1a73e8;
            border-color: #1a73e8;
            background: #f0f6ff;
        }

            .toggle-btn-sm.select-all:hover {
                background: #1a73e8;
                color: #fff;
            }

        .toggle-btn-sm.deselect-all {
            color: #d32f2f;
            border-color: #d32f2f;
            background: #fff5f5;
        }

            .toggle-btn-sm.deselect-all:hover {
                background: #d32f2f;
                color: #fff;
            }
    /* Responsive tweaks */
    @@media (max-width: 576px) {
        .form-section-card {
            padding: 10px 10px 8px 10px;
        }

        .dvMain-action-bar .btn {
            padding: 6px 12px;
            font-size: 12px;
        }

        .radio-pill-group label {
            font-size: 11px;
            padding: 4px 10px;
        }
    }
    /* Card collapse toggle button */
    .card-collapse-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 1.5px solid #1a73e8;
        background: #f0f6ff;
        color: #1a73e8;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.18s;
        padding: 0;
        flex-shrink: 0;
        line-height: 1;
    }

        .card-collapse-btn:hover {
            background: #1a73e8;
            color: #fff;
        }
    /* Collapsible card body */
    .card-collapsible-body {
        overflow: hidden;
        max-height: 500px;
        transition: max-height 0.35s cubic-bezier(.4,0,.2,1), opacity 0.3s ease;
        opacity: 1;
    }

        .card-collapsible-body.collapsed {
            max-height: 0;
            opacity: 0;
        }
</style>
<style>
    /* Card View Styles */
    .card-view-item {
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 1px;
        padding: 5px;
        transition: transform 0.2s, box-shadow 0.2s;
        border-left: 5px solid deepskyblue;
        animation: fadeIn 0.5s ease-in-out;
    }

        .card-view-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

    .card-header-view {
        font-size: 12px;
        font-weight: bold;
        color: #333;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid #eee;
        padding-bottom: 5px;
    }

        .card-header-view i {
            margin-right: 8px;
            color: deepskyblue;
        }

    .card-body-view {
        font-size: 11px;
        color: #555;
        line-height: 2;
    }

    .card-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 4px;
    }

    .card-label {
        font-weight: 600;
        color: #777;
    }

    .card-value {
        text-align: right;
        font-weight: 500;
    }

    .card-footer-view {
        border-top: 1px solid #eee;
        text-align: right;
    }

        .card-footer-view .btn {
            margin-left: 5px;
            font-size: 11px;
            padding: 5px 10px;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse-blue {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(51, 122, 183, 0.7);
        }

        70% {
            transform: scale(1.05);
            box-shadow: 0 0 0 10px rgba(51, 122, 183, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(51, 122, 183, 0);
        }
    }

    .btn-animated {
        /* animation: pulse-blue 2s infinite; */
        font-weight: bold;
        transition: all 0.3s ease;
    }

        .btn-animated:hover {
            animation: none;
            transform: scale(1.1);
        }

    .bi {
        -webkit-text-stroke: 0.5px;
    }
</style>
<style>

    /* ===== Surrounding Customer Modal — Modern UI ===== */
    @@keyframes scModal {
        from {
            opacity: 0;
            transform: translateY(-28px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    #myModalfg .modal-dialog {
        max-width: 460px;
    }

    #myModalfg .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(30, 90, 180, 0.22);
        animation: scModal 0.35s cubic-bezier(.22,.68,0,1.2) both;
    }

    /* Gradient header */
    #myModalfg .sc-modal-header {
        background: linear-gradient(135deg, #1565c0 0%, #1e88e5 60%, #42a5f5 100%);
        padding: 8px 10px 3px;
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }

    #myModalfg .sc-header-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }

        #myModalfg .sc-header-icon-wrap i {
            font-size: 1.35rem;
            color: #fff;
        }

    #myModalfg .sc-modal-title {
        color: #fff;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        margin: 0;
        flex: 1;
        line-height: 1.2;
    }

    #myModalfg .sc-modal-subtitle {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.78);
        font-weight: 400;
        display: block;
    }

    #myModalfg .sc-close-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,0.18);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
        flex-shrink: 0;
    }

        #myModalfg .sc-close-btn:hover {
            background: rgba(255,255,255,0.32);
            transform: rotate(90deg);
        }

    /* Pulse badge */
    #myModalfg .sc-live-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.15);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 2px 8px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    @@keyframes scPulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    #myModalfg .sc-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #69f0ae;
        display: inline-block;
        animation: scPulse 1.4s ease-in-out infinite;
    }

    /* Modal body */
    #myModalfg .modal-body {
        padding: 1px;
        background: #f4f7fb;
    }

    /* Error message */
    #myModalfg .sc-error-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #fff3f3;
        border-left: 3px solid #e53935;
        border-radius: 6px;
        color: #c62828;
        font-size: 0.78rem;
        padding: 0;
        margin-bottom: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, padding 0.3s ease, margin-bottom 0.3s ease;
    }

        #myModalfg .sc-error-box:not(:empty) {
            padding: 7px 10px;
            margin-bottom: 10px;
            max-height: 80px;
        }

            #myModalfg .sc-error-box:not(:empty)::before {
                font-family: "bootstrap-icons";
                content: "\F33A"; /* bi-exclamation-triangle-fill */
                font-size: 0.9rem;
                flex-shrink: 0;
            }

    /* Table */
    #myModalfg #tblSurroundCustomers_wrapper .dt-search {
        width: 100%;
        margin-bottom: 8px;
    }

        #myModalfg #tblSurroundCustomers_wrapper .dt-search input {
            width: 100%;
            border-radius: 8px;
            border: 1px solid #c8d8f0;
            padding: 6px 12px;
            font-size: 0.8rem;
            background: #fff;
        }

    #myModalfg #tblSurroundCustomers thead th {
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        text-align: center;
        border: none;
        padding: 9px 10px;
        letter-spacing: 0.04em;
    }

    #myModalfg #tblSurroundCustomers tbody tr {
        transition: background 0.18s;
    }

        #myModalfg #tblSurroundCustomers tbody tr:hover {
            background: #e3efff !important;
            cursor: pointer;
        }

    #myModalfg #tblSurroundCustomers tbody td {
        font-size: 12px;
        padding: 8px 10px;
        border-bottom: 1px solid #e8eef8;
        vertical-align: middle;
    }

    /* Distance chip */
    #myModalfg .sc-dist-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #e3efff;
        color: #1565c0;
        border-radius: 12px;
        padding: 2px 9px;
        font-size: 11px;
        font-weight: 600;
    }

    /* Footer */
    #myModalfg .sc-modal-footer {
        background: #eef3fb;
        border-top: 1px solid #dce8f5;
        padding: 12px 16px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    #myModalfg .sc-btn-close {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg,#e53935,#ef5350);
        color: #fff;
        border: none;
        border-radius: 20px;
        padding: 7px 20px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.18s, box-shadow 0.18s;
        box-shadow: 0 3px 10px rgba(229,57,53,0.28);
    }

        #myModalfg .sc-btn-close:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(229,57,53,0.38);
        }
    /* ===== End Surrounding Customer Modal ===== */
    .input-with-icon {
        position: relative;
    }

        .input-with-icon .mod-input {
            padding-right: 40px; /* Space for the icon */
        }

    .info-icon {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #0d6efd;
        font-size: 18px;
        transition: color .2s;
    }

        .info-icon:hover {
            color: #084298;
        }

        .top-action-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    flex-wrap: nowrap;
}

.load-btn-wrap {
    flex: 0 0 75%;
}

.load-btn-wrap button {
    width: 100%;
}

.img-toggle-bar {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    white-space: nowrap;
}

/* Large Desktop */
@@media (max-width: 1400px) {
    .load-btn-wrap {
        flex-basis: 75%;
    }
}

/* Laptop / Tablet */
@@media (max-width: 992px) {
    .load-btn-wrap {
        flex-basis: 50%;
    }
}

/* Mobile */
@@media (max-width: 576px) {
    .load-btn-wrap {
        flex-basis: 60%;
    }

    .img-toggle-bar label {
        font-size: 12px;
    }
}
</style>
