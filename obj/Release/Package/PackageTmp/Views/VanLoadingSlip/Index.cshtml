        <i class="bi bi-chevron-up" style="top: 0px !important; left: 0px !important;"></i>
    </a>
</body>

<script>
        var UID = '@Session["LoginUserID"]';
var Aurl = '@Session["APIurl"]';
   var DecVal = '@Session["DecimalValues"]';
    var strCompanyCode = '@Session["CompanyCode"]';
    var DefSMID = 0;
    var PrintTransID = 4, PrintConfigID = 0;
    $("#lnkMob1,#lnkMob2").hide();
    LoadBranchByRoles(strCompanyCode,'#cmbBranch');
    //lblprintprof,cmbPrintProfile
    var printhdnfields = ["#lblprintprof", "#cmbPrintProfile"];
    
    // Builds the columns definition used by #tblProductInfo.
    // Column 1: combined Image/Serial + Product details (name, uom/mrp, highlighted AvlVLS)
    // Column 2: Qty number input, capped to AvlVLS when that field is present in the row
    function buildProductColumns() {
        return [
            {
                data: null,
                className: "dt-body-left prod-details-col",
                orderable: false,
                render: function (data, type, row, meta) {
                    // For non-display types (filter/sort/type) DataTables needs a plain
                    // string to search/sort against - previously this returned '' which
                    // meant the global search box could never match anything.
                    if (type !== 'display') {
                        var searchParts = [row.ProductName, row.ProdID, row.UomQty, row.MRP];
                        return searchParts.filter(function (p) { return p !== undefined && p !== null; }).join(' ');
                    }
                    var showImage = $('#chkShowImage').is(':checked');
                    var imgVal = row["Imagedata"] !== undefined ? row["Imagedata"] : row["Imagedata "];
                    var mediaHtml = '';
                    var imgBlockHtml = '';

                    if (showImage) {
                        var hasImg = imgVal && imgVal.toString().trim() !== "" && imgVal.toString().trim().toUpperCase() !== "NULL";
                        if (hasImg) {
                            var src = imgVal.toString().indexOf('data:image') === 0 ? imgVal : ('data:image/jpeg;base64,' + imgVal);
                            mediaHtml = '<img src="' + src + '" class="prod-thumb" alt="product" '
                                + 'onerror="this.classList.add(\'no-img\');this.removeAttribute(\'src\');this.innerHTML=\'<i class=\\\'bi bi-card-image\\\'></i>\';" />';
                        } else {
                            mediaHtml = '<div class="prod-thumb no-img"><i class="bi bi-card-image"></i></div>';
                        }
                        // Show Image checked: render the image block alongside the details.
                        imgBlockHtml = '<div class="prod-img-col">' + mediaHtml + '</div>';
                    }
                    // Show Image unchecked: imgBlockHtml stays empty (no placeholder at all),
                    // so the flex .prod-info block below simply expands to fill the space.

                    var uomQty = row.UomQty !== undefined ? row.UomQty : "0.00";
                    var uomPrice = row.InclPrice !== undefined ? row.InclPrice : "0.00";
                    var adjQty = row.AdjustQty;
                    var mrp = row.MRP !== undefined ? row.MRP : null;
                    var avlVls = row.AvlVLS !== undefined ? parseFloat(row.AvlVLS).toFixed(DecVal) : null;

                    //var metaParts = [];
                    //if (uomQty !== undefined && uomQty !== null && uomQty !== '') metaParts.push('Tot Qty: ' + uomQty);
                    //if (uomQty !== undefined && uomQty !== null && uomQty !== '') metaParts.push('Sold Qty: ' + adjQty);
                    //if (mrp !== undefined && mrp !== null && mrp !== '') metaParts.push('MRP: ' + mrp);
                    //var metaLine = metaParts.length ? '<div class="prod-meta">' + metaParts.join(' &nbsp;|&nbsp; ') + '</div>' : '';

                    var metaParts = [];
                    if (uomQty !== undefined && uomQty !== null && uomQty !== '') metaParts.push('Tot Qty: ' + parseFloat(uomQty).toFixed(DecVal));
