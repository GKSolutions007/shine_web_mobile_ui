    // ----- Qty input validation: decimal numbers only + cannot exceed AvlVLS -----
    $('#tblProductInfo tbody').on('input', '.qty-input', function () {
        var $input = $(this);
        var val = $input.val();
        // Allow digits and a single decimal point
        var cleaned = val.replace(/[^0-9.]/g, '');
        var firstDot = cleaned.indexOf('.');
        if (firstDot !== -1) {
            cleaned = cleaned.substring(0, firstDot + 1) + cleaned.substring(firstDot + 1).replace(/\./g, '');
        }
        if (cleaned !== val) {
            $input.val(cleaned);
            val = cleaned;
        }

        var $error = $input.closest('.qty-col').find('.qty-error');
        var maxAttr = $input.attr('max');
        var max = (maxAttr !== undefined && maxAttr !== '') ? parseFloat(maxAttr) : null;
        var $tr = $input.closest('tr');
        var rowApi = Table.row($tr);

        if (val === '' || val === '.') {
            $error.text('');
            $input.removeClass('is-invalid');
            if (rowApi.any()) {
                // IMPORTANT: mutate the row's data object in place instead of calling
                // rowApi.data(obj) as a setter. rowApi.data() (getter) returns a direct
                // reference to the internal data object, so changing a property on it
                // already persists the value into the table's data source. Calling the
                // setter form re-runs the column render functions and replaces the
                // <input> DOM node immediately, which is what was stealing focus after
                // every single keystroke.
                var emptyRowData = rowApi.data();
                emptyRowData.Qty = 0;
            }
            $tr.removeClass('row-qty-highlight');
            updateQtySummary();
            return;
        }

        var numVal = parseFloat(val);
        if (max !== null && !isNaN(max) && numVal > max) {
            $error.text('Qty cannot exceed available VLS (' + max + ')');
            $input.addClass('is-invalid');
            $input.val(max);
            numVal = max;
        } else {
            $error.text('');
            $input.removeClass('is-invalid');
        }

        // Persist the entered Qty into the row's underlying data (by reference,
        // see note above) so it survives redraws (e.g. toggling Show Image) and so
        // Save can read it back later - without forcing a re-render mid-typing.
        if (rowApi.any()) {
            var rowData = rowApi.data();
            rowData.Qty = numVal;
        }

        // Highlight the row live while typing, without a full redraw
        $tr.toggleClass('row-qty-highlight', !isNaN(numVal) && numVal > 0);
        updateQtySummary();
    });

    // Block keystrokes that aren't digits or a single decimal point
    $('#tblProductInfo tbody').on('keypress', '.qty-input', function (e) {
        var charCode = e.which ? e.which : e.keyCode;
        var char = String.fromCharCode(charCode);
        if (char === '.' && $(this).val().indexOf('.') === -1) {
            return true;
        }
        if (charCode < 48 || charCode > 57) {
            e.preventDefault();
            return false;
        }
    });

    // Block pasting non-numeric / multi-decimal text
    $('#tblProductInfo tbody').on('paste', '.qty-input', function (e) {
        var clipboard = e.originalEvent.clipboardData || window.clipboardData;
        var pasted = clipboard ? clipboard.getData('text') : '';
        if (/[^0-9.]/.test(pasted) || (pasted.match(/\./g) || []).length > 1) {
            e.preventDefault();
        }
    });

    // ----- Qty stepper +/- buttons -----
    $('#tblProductInfo tbody').on('click', '.qty-btn-plus', function () {
        var $input = $(this).closest('.qty-stepper').find('.qty-input');
        var max = $input.attr('max') !== undefined && $input.attr('max') !== '' ? parseFloat($input.attr('max')) : null;
        var current = parseFloat($input.val()) || 0;
        var next = Math.round((current + 1) * 100) / 100;
        if (max !== null && !isNaN(max) && next > max) {
            next = max;
        }
        $input.val(next).trigger('input');
    });

    $('#tblProductInfo tbody').on('click', '.qty-btn-minus', function () {
        var $input = $(this).closest('.qty-stepper').find('.qty-input');
        var current = parseFloat($input.val()) || 0;
        var next = Math.round((current - 1) * 100) / 100;
        if (next < 0) next = 0;
        $input.val(next).trigger('input');
    });

