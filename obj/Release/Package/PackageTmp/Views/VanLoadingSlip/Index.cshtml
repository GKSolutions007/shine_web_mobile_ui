    function OpenWhatsApp(phone, message) {
        if (!phone) {
            showErrorSnackbar("Mobile No not found for this customer");
            return;
        }
        var encodedMsg = encodeURIComponent(message);
        if (isMobileBrowser()) {
            // Open WhatsApp app
            window.location.href = "whatsapp://send?phone=" + phone + "&text=" + encodedMsg;
        } else {
            // Open WhatsApp Web/Desktop
            window.open("https://wa.me/" + phone + "?text=" + encodedMsg, "_blank");
        }
    }
    function OpenWhatsApp1(phone, message) {
        var encodedMsg = encodeURIComponent(message);
        var appUrl = "whatsapp://send?phone=" + phone + "&text=" + encodedMsg;
        var webUrl = "https://wa.me/" + phone + "?text=" + encodedMsg;

        var appOpened = false;

        function markOpened() {
            appOpened = true;
        }

        document.addEventListener("visibilitychange", function handler() {
            if (document.hidden) markOpened();
        });
        window.addEventListener("blur", markOpened, { once: true });

        // Attempt to open the desktop app
        window.location.href = appUrl;

        // Only fall back if the page never lost focus (app didn't open)
        setTimeout(function () {
            if (!appOpened) {
                window.location.href = webUrl; // same tab, no new tab
            }
        }, 1500);
    }

    $("#lnkMob1, #lnkMob2").click(function () {
        var mobile = $(this).find("span").text().trim();

        if (!mobile) return;
        if (mobile.length == 10) {
            mobile = '91' + mobile;
        }
        if (isMobileBrowser()) {
            // Open WhatsApp app
            window.location.href = "whatsapp://send?phone=" + mobile;
        } else {
            // Open WhatsApp Web/Desktop
            window.open("https://wa.me/" + mobile, "_blank");
        }
    });
</script>