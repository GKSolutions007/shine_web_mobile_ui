    // Counts how many products currently have a Qty > 0, and sums Qty * InclPrice
    // across those products, then reflects both in the summary bar above the table.
    function updateQtySummary() {
        var itemCount = 0;
        var totalValue = 0;
        var decimals = parseInt(DecVal, 10);
        if (isNaN(decimals)) decimals = 2;

        Table.rows().every(function () {
            var d = this.data();
            var qty = parseFloat(d.Qty);
            if (!isNaN(qty) && qty > 0) {
                itemCount++;
                var inclPrice = parseFloat(d.InclPrice);
                if (isNaN(inclPrice)) inclPrice = 0;
                totalValue += qty * inclPrice;
            }
        });

        $('#lblQtyItemCount').text(itemCount);
        $('#lblQtyTotalValue').text(totalValue.toFixed(decimals));
    }

