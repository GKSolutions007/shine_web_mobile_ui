                "Remarks": $("#txtRemarks").val(),
                "Narration": $("#txtNarration").val(),
                "CBy": UID,
                "UDFId": 0,
                "CompanyCode": strCompanyCode,
                "lstAssignDetails": CheckedInvoices,
            }
