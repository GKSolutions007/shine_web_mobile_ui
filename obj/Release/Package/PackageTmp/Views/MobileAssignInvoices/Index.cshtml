    function SaveData() {
        if (SaveValidation()) {
            //showErrorSnackbar("Validation success");
            var listTrans = {
                "ID": $("#txtID").val(),
                "Date": $("#dtpDate").val(),
                "TransMode": nTransMode,
                "TransID": 21,
                "DocID": $("#lblDocID").val(),
