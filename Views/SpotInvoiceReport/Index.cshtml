    // =======================================================
    //  Helpers
    // =======================================================
    function htmlEscape(val) {
        if (val === null || val === undefined) return "";
        return String(val)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function fmtAmt(val) {
        var n = parseFloat(val);
        return isNaN(n) ? htmlEscape(val) : n.toFixed(2);
    }

    function fmtQty(val) {
        var n = parseFloat(val);
        return isNaN(n) ? htmlEscape(val) : (n % 1 === 0 ? n.toString() : n.toFixed(2));
    }

    var invoiceProductModal = null;

    // =======================================================
    //  Invoice list rendering (row wise, single column fields)
    // =======================================================
    function renderInvoiceTable(data) {
        var $tbody = $('#tbodyInvoiceList');
        $tbody.empty();

        var NSalesmanID = $('#cmbSalesman').val();
        var ndata = $('#dtpDate').val();
        $.ajax({
            url: Aurl + "spotsales/generatedata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, Mode: 1, SalesmanID: NSalesmanID, Date: ndata
            },
            success: function (data) {
                if (!data || data.length === 0) {
                    showErrorSnackbar("No invoice found");
                    $('#dvInvoiceEmpty').show();
                    return;
                }
                $('#dvInvoiceEmpty').hide();
                InvoiceData = data;
                var TotalInvoices = InvoiceData.length;
                var InvoiceValue = 0;
                $.each(data, function (i, inv) {
                    InvoiceValue += parseFloat(inv.NetAmt)
                    var html = '';
                    html += '<tr class="invoice-row" data-id="' + htmlEscape(inv.ID) + '" style="animation-delay:' + (i * 0.04) + 's;">';
                    html += '  <td>';
                    html += '    <div class="invoice-doc-header">';
                    html += '      <span class="doc-id"><i class="bi bi-file-earmark-text"></i>' + htmlEscape(inv.DocID) + '</span>';
                    html += '      <span class="doc-date"><i class="bi bi-calendar3 me-1"></i>' + htmlEscape(inv.DocDate) + '</span>';
                    html += '    </div>';
                    html += '    <div class="invoice-card-body">';
                    html += buildField('bi-person', 'Customer', inv.Customer, 'field-full');
                    html += buildField('bi-person-badge', 'Salesman', inv.Salesman);
                    html += buildField('bi-signpost-2', 'Beat', inv.Beat);
                    html += buildField('bi-telephone', 'Mobile', isNullOrEmpty(inv.Mob1) ? '-' : inv.Mob1);
                    html += buildField('bi-cash-coin', 'Net Amount', fmtAmt(inv.NetAmt));
                    html += buildField('bi-boxes', 'Total Qty', fmtQty(inv.TotalQty));
                    html += buildField('bi-list-check', 'Items', (inv["ItemCount "] || inv.ItemCount || '0').toString().trim());
                    html += '    </div>';
                    html += '    <div class="invoice-doc-footer">';
                    html += '      <button type="button" data-docid="' + inv.DocID +'" class="btn btn-success vlswhatsapp-btn flex-grow-1"><i class="bi bi-whatsapp"></i > Whatsapp</button >';
                    html += '      <button type="button" data-docid="' + inv.DocID +'" class="btn vlspdf-btn flex-grow-1" style="background-color:brown;color:white"><i class="bi bi-filetype-pdf"></i> Download PDF</button>';
                    html += '    </div>';
                    html += '  </td>';
                    html += '</tr>';
                    $tbody.append(html);
                });


                $('#lblInvoiceCount').text(TotalInvoices);
                $('#lblInvoiceTotalValue').text(parseFloat(InvoiceValue).toFixed(2));//.toFixed(2)
            }
        });
        
    }

    function buildField(icon, label, value, extraClass) {
        return '<div class="invoice-field ' + (extraClass || '') + '">' +
            '<span class="field-label"><i class="bi ' + icon + '"></i>' + label + '</span>' +
            '<span class="field-value">' + htmlEscape(value) + '</span>' +
            '</div>';
    }
    setTimeout(() => {
        $('#btnLoadData').trigger("click");
    }, 2000);
    // ----- Load button: show invoice list -----
    $('#btnLoadData').click(function () {
        $('#dvInvoiceDetails').show();
        $('#txtInvoiceSearch').val('');
        //lblInvoiceCount,lblInvoiceTotalValue
        $('#lblInvoiceCount').text("0");
        $('#lblInvoiceTotalValue').text("0.00");
        renderInvoiceTable(InvoiceData);
        $('html, body').animate({ scrollTop: $('#dvInvoiceDetails').offset().top - 80 }, 400);
    });

    // ----- Search: Invoice table -----
    $(document).on('keyup', '#txtInvoiceSearch', function () {
        var term = $(this).val().trim().toLowerCase();
        var visibleCount = 0;
        $('#tbodyInvoiceList .invoice-row').each(function () {
            var match = $(this).text().toLowerCase().indexOf(term) > -1;
            $(this).toggle(match);
            if (match) visibleCount++;
        });
        $('#dvInvoiceEmpty').toggle(visibleCount === 0);
    });

    // ----- Double click on invoice row: open product popup -----
    $(document).on('dblclick', '.invoice-row', function () {
        var id = $(this).data('id');
        $('.invoice-row').removeClass('row-selected');
        $(this).addClass('row-selected');
        openProductPopup(id);
    });
    // ----- click on WhatsApp button : Trigger to send whatsapp message -----
    $(document).on('click', '.vlswhatsapp-btn', function () {
        var id = $(this).data('docid');
        var ProfileID = $("#cmbPrintProfile").val();
        DocumentValidate(ProfileID, id);
    });
    // ----- click on Download PDF button : Trigger to Download  the inoive pdf-----
    $(document).on('click', '.vlspdf-btn', function () {
        var id = $(this).data('docid');
        var ProfileID = $("#cmbPrintProfile").val();
        PDFDocument(4, ProfileID, id );
    });
    // Touch devices: simulate double-tap since dblclick can be unreliable on mobile
    (function () {
        var lastTap = 0, lastEl = null;
        $(document).on('touchend', '.invoice-row', function (e) {
            var now = Date.now();
            if (lastEl === this && (now - lastTap) < 350) {
                $('.invoice-row').removeClass('row-selected');
                $(this).addClass('row-selected');
                openProductPopup($(this).data('id'));
                e.preventDefault();
            }
            lastTap = now;
            lastEl = this;
        });
    })();

    function openProductPopup(id) {
        var invoice = $.grep(InvoiceData, function (inv) { return String(inv.ID) === String(id); })[0];
        //var products = $.grep(InvoiceProducts, function (p) { return String(p.ID) === String(id); });

        $('#popupDocID').text(invoice ? invoice.DocID : '-');
        $('#popupCustomer').text(invoice ? invoice.Customer : '-');

        $('#txtProductSearch').val('');
        $.ajax({
            url: Aurl + "spotsales/generatedata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, Mode: 2, SalesmanID: id, Date: null
            },
            success: function (data) {
                if (!data || data.length === 0) {
                    $('#dvInvoiceEmpty').show();
                    showErrorSnackbar("No Items found");
                    return;
                }
                var products = data
                renderProductTable(products);
                if (!invoiceProductModal) {
                    invoiceProductModal = new bootstrap.Modal(document.getElementById('invoiceProductModal'));
                }
                invoiceProductModal.show();
            }
        });
        
    }

    function renderProductTable(products) {
        var $tbody = $('#tbodyProductDetails');
        $tbody.empty();

        if (!products || products.length === 0) {
            $('#dvProductEmpty').show();
            return;
        }
        $('#dvProductEmpty').hide();

        $.each(products, function (i, p) {
            var qty = p["UomQty "] || p.UomQty || 0;
            var html = '';
            html += '<tr style="animation-delay:' + (i * 0.05) + 's;">';
            //html += '  <td data-label="Code">' + htmlEscape(p.Code) + '</td>';
            html += '  <td data-label="Name">' + htmlEscape(p.Name) + '</td>';
            //html += '  <td data-label="HSN Code">' + htmlEscape(p.HSNCode) + '</td>';
            html += '  <td data-label="MRP">' + fmtAmt(p.MRP) + '</td>';
            html += '  <td data-label="Qty">' + fmtQty(qty) + '</td>';
            html += '</tr>';
            $tbody.append(html);
        });
    }

    // ----- Search: Product table (inside popup) -----
    $(document).on('keyup', '#txtProductSearch', function () {
        var term = $(this).val().trim().toLowerCase();
        var visibleCount = 0;
        $('#tbodyProductDetails tr').each(function () {
            var match = $(this).text().toLowerCase().indexOf(term) > -1;
            $(this).toggle(match);
            if (match) visibleCount++;
        });
        $('#dvProductEmpty').toggle(visibleCount === 0);
    });
   
    function PDFDocument(strTransID, nConfigID, strDocID) {
        if (nConfigID > 0) {
            $.ajax({
                url: Aurl + "transactionprint/generateprint",
                type: 'GET',
                datatype: 'json',
                data: {
                    Companycode: strCompanyCode, TransID: strTransID, ConfigID: nConfigID, DocValue: strDocID,
                    Copies: "1", UserID: UID
                },
                success: function (data) {
                    if (data.length > 0) {
                        //location.href = 'Invoice/ExportData?Fname=' + data;
                        location.href = Aurl + 'print/downloadprint?Companycode=' + strCompanyCode + '&Fname=' + data;
                    } else {
                        showErrorSnackbar('Invalid Document ID');
                    }
                }, error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
        else {
            showErrorSnackbar("Select Print profile");
        }
    }
    function DocumentValidate(nProfileID, DocID) {
        if (nProfileID > 0) {
            $.ajax({
                url: Aurl + "printing/documentvalidate",
                type: 'get',
                contentType: 'json',
                data: { Companycode: strCompanyCode, TransID: 4, strDocID: DocID },
                success: function (data) {
                    $.each(data, function (i, items) {
                        if (items.MsgID == "0") {
                            WhatsappDocument(items.ID, 4, nProfileID);
                        } else {
                            showErrorSnackbar("Doc ID not matched. Enter correct Doc ID");
                        }
                    });
                }
            });
        }
        else {
            showErrorSnackbar("Select Print profile");
        }
    }
    function WhatsappDocument(ID, strTransID, nConfigID) {
        var strcopy = 1;// $("#txtNoofCopies").val() == "" || $("#txtNoofCopies").val() == "0" || $("#txtNoofCopies").val() == null ? 1 : $("#txtNoofCopies").val();
        $.ajax({
            url: Aurl + "print/WhatsappGenerate",
            type: 'GET',
            datatype: 'json',
            data: {
                Companycode: strCompanyCode, DocID: ID, TransID: strTransID, ConfigID: nConfigID,
                Copies: strcopy, APIURL: Aurl, UserID: UID
            },
            success: function (data) {
                if (data.length > 0) {
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            //showSuccessSnackbar(items.Message);
                            var phone = items.RowID
                            var message = items.Message;
                            OpenWhatsApp(phone, message);
                        }
                        else if (items.MsgID == 1) {
                            showErrorSnackbar(items.Message);
                        }
                    });
                } else {
                    showErrorSnackbar('Message Not Send. Try Again');
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function isNullOrEmpty(val) {
        return val === null || val === undefined || val === "" || val == 0;
    }

    function isMobileBrowser() {
        return /Android|iPhone|iPad|iPod|Windows Phone|Opera Mini|IEMobile|Mobile/i.test(navigator.userAgent);
    }
    function OpenWhatsApp(phone, message) {
        if (!phone) {
            showErrorSnackbar("Mobile No not found for this customer");
            return;
        }
        var encodedMsg = encodeURIComponent(message);
        if (isMobileBrowser()) {
            // Open WhatsApp app
            window.location.href = "whatsapp://send?phone=" + phone + "&text=" + encodedMsg;
        } else {
            // Open WhatsApp Web/Desktop
            window.open("https://wa.me/" + phone + "?text=" + encodedMsg, "_blank");
        }
    }
</script>