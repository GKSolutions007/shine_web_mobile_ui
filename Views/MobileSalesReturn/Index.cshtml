                    <!-- Modern Gradient Header -->
                    <div class="sc-modal-header">
                        <div class="sc-header-icon-wrap">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div class="flex-fill">
                            <div class="sc-modal-title" id="lblPopupheading">
                                Surrounding Customers
                                <span class="sc-live-badge ms-2">
