        @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtSRAddID" })
        @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtSRModifyID" })
        @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtSRViewID" })

