<script type="text/javascript">
     var UID = '@Session["LoginUserID"]';
 var Aurl = '@Session["APIurl"]';
    var DecVal = '@Session["DecimalValues"]';
    var strCompanyCode = '@Session["CompanyCode"]';
    var nTransMode = 1;

    $('#ProdGrpCC').hide();
    $('#ProdCC').hide();
    
    let userpermission = {
        SRAdd: $("#txtSRAddID").val() == 1,
        SREdit: $("#txtSRModifyID").val() == 1,
        SRView: $("#txtSRViewID").val() == 1,

        DRView: $("#txtDRViewID").val() == 1,
        DREdit: $("#txtDRModifyID").val() == 1,
        DRAdd: $("#txtDRAddID").val() == 1,
    };
    manageaddpermission();
    function manageaddpermission(){
        //$("#btnAddNew").hide();

        

        if (userpermission.SRAdd && userpermission.SREdit && userpermission.SRView &&
            !userpermission.DRView && !userpermission.DREdit && !userpermission.DRAdd) {
            $("#rdoSR,#lblrdoSR").prop("checked", true);
            $("#rdoSR,#lblrdoSR").show(); $("#rdoDR,#lblrdoDR").hide();
        }
        if (!userpermission.SRAdd && !userpermission.SREdit && !userpermission.SRView &&
            userpermission.DRView && userpermission.DREdit && userpermission.DRAdd) {
            $("#rdoDR,#lblrdoDR").prop("checked", true);
            $("#rdoDR,#lblrdoDR").show(); $("#rdoSR,#lblrdoSR").hide();
        }
        var SRchk = $("#rdoSR").is(":checked");
        if (SRchk) {
            if (userpermission.SRAdd) {// || userpermission.DRAdd
                $("#btnAddNew").show();
            }
            else {
                $("#btnAddNew").hide();
            }
        }
        else {
            if (userpermission.DRAdd) {// || userpermission.DRAdd
                $("#btnAddNew").show();
            }
            else {
                $("#btnAddNew").hide();
            }
        }        
    }
    $("#dvMain").hide();
    var Table = $('#tblProductInfo').DataTable({
        "bFilter": true,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollX: true,
        scrollCollapse: true,
        //dom: 'l<"toolbar">frtip',
        //initComplete: function () {
        //    $("div.toolbar")
        //        .html('<button type="button"  id="plus_button"><b> Add </b></button>');
        //},
        "columnDefs": [{ "targets": [0,1,6], "visible": false, searchable: false, ordering: false }]
        //"selected":true,
    });
    var TableSurroundCustomers = $('#tblSurroundCustomers').DataTable({
        "bFilter": true,
        "bSearchable": true,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        "columnDefs": [{ "targets": [0,1], "visible": false, searchable: false, ordering: false }]
        //"selected":true,
    });
    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));// document.getElementById("myModalfg");

    $('#btnSCClose,#modelcloseX').click(function (e) {
        modal.hide();
    });

    GetSetFilterData(6, 0);
    function GetSetFilterData(nMode, strAllsts = "0") {
        var nSRDRType = $('#rdoSR').is(":checked") ? 1 : 2;
        $.ajax({
            url: Aurl + "mobilereturn/documentlist",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, RetrunType: nSRDRType, UserID: UID, Showall: strAllsts
            },
            success: function (data) {
                if (nMode == 6) {
                    var Docjsdata = JSON.parse(data);// JSON.parse(data);
                    var cardHtml = "";
                    if (Docjsdata.length === 0) {
                        cardHtml = '<div class="col-md-12 text-center" style="margin-top:20px;"><h5>No records found</h5></div>';
                    } else {
                        $.each(Docjsdata, function (index, value) {

                            var rowIndex = index;

                            cardHtml += '<div class="col-12 col-md-4 card-item">';
                            cardHtml += '  <div class="card card-view-item shadow-sm">';

                            // Header
                            cardHtml += '    <div class="card-header card-header-view">';
                            cardHtml += '      <i class="bi bi-person"></i> <span>' + (value.CustomerName || "Unknown Customer") + '</span>';
                            cardHtml += '    </div>';

                            // Body
                            cardHtml += '    <div class="card-body card-body-view">';

                            // Row 1: Date & Activity
                            cardHtml += '      <div class="row mb-1">';
                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-calendar"></i> ' + (value.DocDate || "-") + '</span>';
                            cardHtml += '        </div>';

                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-cart"></i> ' + (value.BranchName || "-") + '</span>';
                            cardHtml += '        </div>';
                            cardHtml += '      </div>';

                            // Row 2: Amount & Beat
                            cardHtml += '      <div class="row mb-1">';
                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block text-success fw-bold small"><i class="bi bi-currency-rupee"></i> ' + (value.Value || "0.00") + '(' + (value.ItemsCount || "0") + ')</span>';
                            cardHtml += '        </div>';

                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-geo-alt"></i> ' + (value.BeatName || "-") + '</span>';
                            cardHtml += '        </div>';
                            cardHtml += '      </div>';

                            // Row 3: Salesman & Status
                            cardHtml += '      <div class="row">';
                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="card-label d-block small"><i class="bi bi-person-badge"></i> ' + (value.SalesmanName || "-") + '</span>';
                            cardHtml += '        </div>';

                            // Status Logic
                            var status = value.Status || "-";
                            var statusIcon = "bi-info-circle";
                            var statusClass = "bg-secondary";

                            if (status === "Open" || status === "Amendment") {
                                statusIcon = "bi-envelope-open";
                                statusClass = "bg-primary";
                            }
                            else if (status === "Amended") {
                                statusIcon = "bi-pencil-square";
                                statusClass = "bg-warning";
                            }
                            else if (status === "Cancelled") {
                                statusIcon = "bi-x-circle";
                                statusClass = "bg-danger";
                            }
                            else if (status === "Processed") {
                                statusIcon = "bi-check-circle";
                                statusClass = "bg-success";
                            }

                            cardHtml += '        <div class="col-6">';
                            cardHtml += '          <span class="badge ' + statusClass + '"><i class="bi ' + statusIcon + '"></i> ' + status + '</span>';
                            cardHtml += '        </div>';

                            cardHtml += '      </div>';

                            cardHtml += '    </div>'; // Body End

                            // Footer
                            cardHtml += '    <div class="card-footer card-footer-view text-right">';
