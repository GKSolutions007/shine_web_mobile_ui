    #myModalfg #tblSurroundCustomers tbody tr {
        transition: background 0.18s;
    }

        #myModalfg #tblSurroundCustomers tbody tr:hover {
            background: #e3efff !important;
            cursor: pointer;
        }

    #myModalfg #tblSurroundCustomers tbody td {
        font-size: 12px;
        padding: 8px 10px;
        border-bottom: 1px solid #e8eef8;
        vertical-align: middle;
    }

    /* Distance chip */
    #myModalfg .sc-dist-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #e3efff;
        color: #1565c0;
