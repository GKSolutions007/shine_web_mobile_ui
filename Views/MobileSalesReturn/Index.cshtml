    var sum = 0, nCount = 0, mSum = 0;
    function CalcProdDtl() {
        var objItemDetails = [];
        var totamt = sum, amt = 0, isGridEmpty = 0;
        ClearErrorMsg();
        //loaditemcounttotamt("0", "0.00");
        var isGO = false;
        var prodid = '0', qty = '0', prodname = '0',PDisc = 0;
        amt = 0, isGridEmpty = 0, mrp = '0', Price = 0,mrp = 0;
        if (Table.rows().count() > 0) {
            $("#tblProductInfo tbody tr").each(function () {
                const data = Table.row(this).data();

                const qty = parseFloat($(this).find('[name="Qty"]').attr("txttag")) || 0;
                const price = parseFloat($(this).find('[name="Price"]').attr("txttag")) || data.Rate;
                const discount = parseFloat($(this).find('[name="DiscountPern"]').attr("txttag")) || data.Discount;
                const dmrp = parseFloat($(this).find('[name="MRP"]').attr("txttag")) || 0;
                if (!qty) return;

                totamt += qty * price;

                objItemDetails.push({
                    Name: data.Name,
                    PriceDesc: data.PriceDesc,
                    ID: data.ID,
                    Discount: discount.toString(),
                    Qty: qty.toString(),
                    Rate: data.Rate.toString(),
                    AppPrice: price.toString(),
                    MRP: dmrp
                });
            });
            if (objItemDetails.length > 0) {
                $("#btnSave,#btnSubmitBottom").prop("disabled", false);
                $("#btnViewTop,#btnViewBottom").prop("disabled", false);
                loaditemcounttotamt(nCount + objItemDetails.length, totamt, totamt - mSum);
            }
        }
    }
