                                cardHtml += !userpermission.SRView ? '' :
                                    '<button id="btnView' + rowIndex + '" type="button" class="btn btn-info btn-sm clsview" data-id="' + value.ID + '" data-customername="' + value.CustomerName + '"><i class="bi bi-eye"></i> View</button>';
