    function WhatsappDocument(ID, strTransID, nConfigID) {
        var strcopy = 1;// $("#txtNoofCopies").val() == "" || $("#txtNoofCopies").val() == "0" || $("#txtNoofCopies").val() == null ? 1 : $("#txtNoofCopies").val();
        $.ajax({
            url: Aurl + "print/WhatsappGenerate",
            type: 'GET',
            datatype: 'json',
            data: {
                Companycode: strCompanyCode, DocID: ID, TransID: strTransID, ConfigID: nConfigID,
                Copies: strcopy, APIURL: Aurl, UserID: UID
            },
            success: function (data) {
                if (data.length > 0) {
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            //showSuccessSnackbar(items.Message);
                            var phone = items.RowID
                            var message = items.Message;
                            OpenWhatsApp(phone, message);
                        }
                        else if (items.MsgID == 1) {
                            showErrorSnackbar(items.Message);
                        }
                    });
                } else {
                    showErrorSnackbar('Message Not Send. Try Again');
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
</script>