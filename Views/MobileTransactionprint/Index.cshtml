@model ShineWebMobile.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
@*<link href="~/Content/surroundingcustomerstyle.css" rel="stylesheet" />*@

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>
<style>

    .each {
        border-bottom: 1px solid #555;
        padding: 3px 0;
    }

    .acItem .name {
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .acItem .desc {
        font-size: 10px;
        font-family: Arial, Helvetica, sans-serif;
        color: #555;
    }

    .ui-autocomplete {
        max-height: 245px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    input[type=number]::placeholder {
        text-align: left;
    }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    .mobile-delivery-container {
        padding: 5px;
        animation: fadeIn 0.4s ease-in-out;
    }

    .modern-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        margin-bottom: 1rem;
        background: #fff;
    }

        .modern-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    /* ---------- Doc Filter Modal ---------- */
    #docFilterModal .modal-header {
        background: #f8f9fa;
    }

    #docFilterModal .selected-transaction-name {
        font-size: 1rem;
        font-weight: 600;
        color: #0d6efd;
    }

    /* ---------- Doc Filter Search Bar ---------- */
    .doc-search-wrap {
        margin-bottom: 12px;
    }

    .doc-search-group .input-group-text,
    .doc-search-group .form-control,
    .doc-search-group .btn {
        border-color: #dfe4ea;
    }

    .doc-search-group .form-control {
        box-shadow: none;
    }

        .doc-search-group .form-control:focus {
            box-shadow: none;
            border-color: #86b7fe;
        }

    /* ---------- Select Button (redesigned) ---------- */
    .doc-select-btn {
        border: none;
        border-radius: 999px;
       /* padding: 7px 20px;*/
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #fff;
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        box-shadow: 0 2px 8px rgba(13,110,253,0.35);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

        .doc-select-btn i {
            font-size: 15px;
        }

        .doc-select-btn:hover,
        .doc-select-btn:focus {
            background: linear-gradient(135deg, #0b5ed7, #084298);
            box-shadow: 0 5px 14px rgba(13,110,253,0.45);
            transform: translateY(-1px);
            color: #fff;
        }

        .doc-select-btn:active {
            transform: translateY(0);
            box-shadow: 0 2px 6px rgba(13,110,253,0.3);
        }

    @@media (max-width: 420px) {
        .doc-row-action {
            justify-items: stretch;
        }

        .doc-select-btn {
            width: 100%;
            justify-content: center;
            /*padding: 9px 0;*/
        }
    }

    .doc-cards-wrap {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .doc-card {
        border: 1px solid #e3e7ee;
        border-radius: 10px;
        padding: 10px 14px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

        .doc-card:hover {
            box-shadow: 0 4px 14px rgba(0,0,0,0.09);
        }

    .doc-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px 16px;
        padding: 3px 0;
    }

        .doc-row + .doc-row {
            border-top: 1px dashed #e9ecef;
        }

    .doc-row-header {
        padding-top: 0;
    }

    .doc-row-single .doc-col-full {
        grid-column: 1 / -1;
    }

    .doc-row-action {
        grid-template-columns: 1fr;
        justify-items: end;
        padding-top: 10px;
        margin-top: 2px;
        border-top: 1px solid #e9ecef !important;
    }

    .doc-col {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .doc-col-empty {
        visibility: hidden;
    }

    .doc-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #6c757d;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .doc-value {
        font-size: 13.5px;
        color: #212529;
        word-break: break-word;
    }

    .doc-value-strong {
        font-weight: 700;
        color: #0d6efd;
    }

    #divDocFilterResults {
        max-height: 55vh;
        overflow-y: auto;
        padding-right: 2px;
    }

    @@media (max-width: 576px) {
        #docFilterModal .modal-body {
            padding: 0.75rem;
        }

        #divDocFilterResults {
            max-height: none;
            padding-bottom: 100px;
        }
    }

    @@media (max-width: 420px) {
        .doc-row {
            grid-template-columns: 1fr 1fr;
        }

        .doc-row-header .doc-col:first-child {
            border-bottom: 1px dashed #eef1f5;
            padding-bottom: 4px;
            margin-bottom: 2px;
        }

        .doc-col-empty {
            display: none;
        }
    }
</style>
<body>
    <div class="mobile-delivery-container">
        @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
        @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
        @Html.HiddenFor(model => model.TransID, new { @autocomplete = "off", @class = "form-control", @id = "txtTransID" })
        @Html.HiddenFor(model => model.UserID, new { @autocomplete = "off", @class = "form-control", @id = "txtSwitchSMID" })

        <div class="d-flex align-items-center mb-3">
            <h4 id="MainHeading" class="m-0 fw-bold text-primary"><i class="bi bi-printer me-2"></i>@ViewData["FormName"]</h4>
        </div>

        <div class="toastBox"></div>
        <hr class="text-muted" />

        <div class="row g-3">
            <!-- Left Column: Inputs & Actions -->
            <!--  $('#cmbTransaction,#cmbProfile').find("option").remove(); -->
            <div class="col-12 col-lg-4">
                <div class="modern-card card p-3">

                    <div class="mb-3">
                        <label class="form-label fw-bold text-primary"><i class="bi bi-list-task me-2 text-primary"></i>Transaction *</label>
                        <select id="cmbTransaction" class="form-select shadow-sm border-1 bg-light"><option value="0">Select Transaction</option></select>
                        <div class="text-danger small mt-1 clrdivserror" id="divErrorOnTransaction"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-primary"><i class="bi bi-person-badge me-2 text-primary"></i>Profile *</label>
                        <select id="cmbProfile" class="form-select shadow-sm border-1 bg-light"><option value="0">Select Profile</option></select>
                        <div class="text-danger small mt-1 clrdivserror" id="divErrorOnProfile"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-primary"><i class="bi bi-sort-numeric-up me-2 text-primary"></i>Document ID *</label>

                        <div class="d-flex gap-2">
                            <input class="form-control shadow-sm border-1 bg-light" id="txtDocID" />
                            <button id="btnDocFilter" type="button" class="btn btn-outline-primary flex-shrink-0" title="Doc Filter">
                                <i class="bi bi-funnel"></i> Doc Filter
                            </button>
                        </div>
                        <div class="text-danger small mt-1 clrdivserror" id="divErrorOnDocID"></div>

                    </div>
                    <div class="d-flex gap-2 mt-auto">
                        <button id="btnReset" type="button" class="btn btn-danger deliveryaction-btn flex-grow-1 text-white">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                        <button id="btnWhatsapp" type="button" class="btn btn-success deliveryaction-btn flex-grow-1">
                            <i class="bi bi-whatsapp"></i> Whatsapp
                        </button>
                        <button id="btnSave" type="button" class="btn btn-primary deliveryaction-btn flex-grow-1">
                            <i class="bi bi-cloud-download"></i> Download
                        </button>
                    </div>
                </div>
            </div>

        </div>
        <a href="javascript:" id="return-to-top" class="btn btn-primary shadow-lg" style="position: fixed; bottom: 35px; right: 5px; border-radius: 50%; width: 45px; height: 45px; display: none; align-items: center; justify-content: center; z-index: 999; ">
            <i class="bi bi-chevron-up" style="top: 0px !important; left: 0px !important;"></i>
        </a>
    </div>

    <!-- ===================== Doc Filter Modal ===================== -->
    <div class="modal fade" id="docFilterModal" tabindex="-1" aria-labelledby="docFilterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="docFilterModalLabel">
                        <i class="bi bi-funnel me-2 text-primary"></i>
                        <span class="selected-transaction-name" id="lblDocFilterTransName"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-person me-2 text-primary"></i>User Name *</label>
                            <select id="cmbDocUserName" class="form-select shadow-sm border-1 bg-light">
                                <option value="0">-- Select --</option>
                            </select>
                            <div class="text-danger small mt-1 docFilterError" id="divErrorOnDocUserName"></div>
                        </div>
                        <div class="col-5 col-md-4">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-calendar-event me-2 text-primary"></i>From Date *</label>
                            <input type="date" id="txtDocFromDate" class="form-control shadow-sm border-1 bg-light" autocomplete="off" />
                            <div class="text-danger small mt-1 docFilterError" id="divErrorOnFromDate"></div>
                        </div>
                        <div class="col-5 col-md-4">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-calendar-event me-2 text-primary"></i>To Date *</label>
                            <input type="date" id="txtDocToDate" class="form-control shadow-sm border-1 bg-light" autocomplete="off" />
                            <div class="text-danger small mt-1 docFilterError" id="divErrorOnToDate"></div>
                        </div>
                        <div class="col-2 text-end mt-5">
                            <button id="btnDocFilterLoad" type="button" class="btn btn-primary">
                                <i class="bi bi-download me-1"></i>Load
                            </button>
                        </div>
                    </div>

                    <hr class="text-muted" />

                    <div id="docSearchWrap" class="doc-search-wrap" style="display:none;">
                        <div class="input-group input-group-sm doc-search-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="txtDocSearch" class="form-control border-start-0 border-end-0" placeholder="Search Doc ID, Date, Party Name..." autocomplete="off" />
                            <button type="button" id="btnDocSearchClear" class="btn btn-outline-secondary border-start-0 d-none" title="Clear search">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="small text-muted mt-1" id="lblDocResultCount"></div>
                    </div>

                    <div id="divDocFilterResults"></div>
                </div>
            </div>
        </div>
    </div>
</body>

<script>
        var UID = '@Session["LoginUserID"]';
var Aurl = '@Session["APIurl"]';
   var DecVal = '@Session["DecimalValues"]';
    var strCompanyCode = '@Session["CompanyCode"]';
    var DefSMID = 0;
    var PrintTransID = 4, PrintConfigID = 0;
    var enabSm = UID == 1 || UID == 2 ? false : true;
        $(window).scroll(function () {
            if ($(this).scrollTop() >= 200) {
                $('#return-to-top').fadeIn(200);
                $('#return-to-top').css("display", "flex");
            } else {
                $('#return-to-top').fadeOut(200);
            }
        });

        $('#return-to-top').click(function () {
            $('body,html').animate({
                scrollTop: 0
            }, 500);
        });
    function ClearForm() {
        $(".clrdivserror").html("");
        $("#txtDocID").val("");
        GetData();
    }
    var TransactionDocuments = [
