        }
    ];
    $('#cmbTransaction').change(function (e) {
        $('#cmbProfile').find("option").remove();
        $("#txtDocID").val("");
        $(".clrdiv").html("");
        RenderDocFilterResults([]);
        var ID = e.target.value;
        var prefix = $('#cmbTransaction option:selected').data('prefix');
        if (prefix) {
            var Profiles = arrProfiles.filter(a => a.TransID == ID);
            if (Profiles.length > 0) {
                $("#txtDocID").val(prefix);
                var defid = 0;// Profiles.filter(f => f.DefaultConfig == 1)[0].ProfileID || Profiles[0].ProfileID;
                for (var i = 0; i < Profiles.length; i++) {
                    $('#cmbProfile').append($('<option/>', {
                        value: Profiles[i].ProfileID,
                        text: Profiles[i].ProfileName,
                    }));
                    if (Profiles.DefaultConfig == 1) {
                        defid = Profiles[i].ProfileID;
                    }
                }
                if (defid) {
                    $('#cmbProfile').val(defid);
                }
            } else {
                showErrorSnackbar("No profiles found");
            }
        } else {
            showErrorSnackbar("No profiles found");
        }
    });
    $('#btnSave').click(function () {
        var IsValid = true;
        $(".clrdivserror").html("");
        //if ($('#txtVLSNo').val() == '') {
        //    IsValid = false;
        //    $('#divErrorOnInvNo').html('* VLS No should not be empty');
        //    $('#txtVLSNo').focus();
        //}
        if ($('#cmbSalesman').val() == '' || $('#cmbSalesman').val() == 0 || $('#cmbSalesman').val() == null) {
            IsValid = false;
            $('#divErrorOnSalesman').html('* Select Salesman');
            $('#cmbSalesman').focus();
        }
        if (IsValid) {
            LoadVLSData();
        }
    });
    var SendOption = "PDF";
    //divErrorOnTransaction,divErrorOnProfile,txtDocID,divErrorOnDocID
    $("#btnSave,#btnWhatsapp").click(function (e) {
        SendOption = e.target.id == "btnSave" ? "PDF" : "Whatsapp";
        $(".clrdivserror").html("");
        var IsValid = true;
        if ($("#cmbTransaction").val() == 0) {
            IsValid = false;
            $("#divErrorOnTransaction").html("Select Transaction");
            showErrorSnackbar("Select Transaction");
        }
        if ($("#cmbProfile").val() == 0 || $("#cmbProfile").val() == "" || $("#cmbProfile").val() == null) {
            IsValid = false;
            $("#divErrorOnProfile").html("Select Profile");
            showErrorSnackbar("Select Profile");
        }

        if ($("#txtDocID").val() == "") {
            IsValid = false;
            $("#divErrorOnDocID").html("Doc ID should not be empty");
            showErrorSnackbar("Doc ID should not be empty");
        }
        if (IsValid) {
            if (cfFocus != 3) {
                var DigMsg = SendOption == "PDF" ? " download pdf ?" : " send Whatsapp message ?"
                ConfirmDialogMsg("Do you want to" + DigMsg);
            } else {
                SaveData();
            }
        }
    });
    function SaveData() {
        var configid = $("#cmbProfile").val();
        var transid = $("#cmbTransaction").val();
        var docid = $("#txtDocID").val();
        if (SendOption == "PDF")
            PDFDocument(transid, configid, docid);
        else
            DocumentValidate(transid, docid);
    }
    // ----- Reset button: simply reset the whole form -----
    $('#btnReset').click(function () {
        ClearForm();
    });
    function isNullOrEmpty(val) {
        return val === null || val === undefined || val === "" || val == 0;
    }

    function isMobileBrowser() {
        return /Android|iPhone|iPad|iPod|Windows Phone|Opera Mini|IEMobile|Mobile/i.test(navigator.userAgent);
    }
    function OpenWhatsApp(phone, message) {
        if (!phone) {
            showErrorSnackbar("Mobile No not found for this customer");
            return;
        }
        var encodedMsg = encodeURIComponent(message);
        if (isMobileBrowser()) {
            // Open WhatsApp app
            window.location.href = "whatsapp://send?phone=" + phone + "&text=" + encodedMsg;
        } else {
            // Open WhatsApp Web/Desktop
            window.open("https://wa.me/" + phone + "?text=" + encodedMsg, "_blank");
        }
    }
    var arrTrans = [], arrProfiles = [];
    GetData();
    function GetData() {
        $.ajax({
            url: Aurl + "transactionprint/get",
            type: 'get',
            contentType: 'json',
            data: { CompanyCode: strCompanyCode, UserID: UID },
            success: function (data) {
                if (data.Transactions.length > 0) {
                    arrTrans = [], arrProfiles = [];
                    $('#cmbTransaction,#cmbProfile').find("option").remove();
                    $('#cmbTransaction').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data.Transactions, function (i, items) {
                        if (items.Type == 1) {
                            var al = {
                                "Transaction": items.Name,
                                "TransID": items.ID,
                                "Prefix": items.Prefix,
                            }
                            arrTrans.push(al);
                            $('#cmbTransaction').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                                'data-prefix': items.Prefix
                            }));
                        }
                        else if (items.Type == 2) {
                            var al = {
                                "ProfileName": items.Name,
                                "ProfileID": items.ID,
                                "TransID": items.TransID,
                                "DefaultConfig": items.DefaultConfig,
                                "NoCopies": items.NoCopies,
                            }
                            arrProfiles.push(al);
                        }
                    });
                }
                else {
                    showErrorSnackbar("No Transactions Found");
                }
                $('#cmbDocUserName').find("option").remove();
                $('#cmbDocUserName').append($('<option/>', {
                    value: 0,
                    text: "-- Select --",
                }));
                $.each(data.Users, function (i, items) {
                    $('#cmbDocUserName').append($('<option/>', {
                        value: items.ID,
                        text: items.Name
                    }));
                    $('#cmbDocUserName').val(UID);
                });
            }
            , error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function PDFDocument( strTransID, nConfigID,strDocID) {
        if (nConfigID > 0) {
            $.ajax({
                url: Aurl + "transactionprint/generateprint",
                type: 'GET',
                datatype: 'json',
                data: {
                    Companycode: strCompanyCode, TransID: strTransID, ConfigID: nConfigID, DocValue: strDocID,
                    Copies: "1", UserID : UID
                },
                success: function (data) {
                    if (data.length > 0) {
                        //location.href = 'Invoice/ExportData?Fname=' + data;
                        location.href = Aurl + 'print/downloadprint?Companycode=' + strCompanyCode + '&Fname=' + data;
                    } else {
                        showErrorSnackbar('Invalid Document ID');
                    }
                }, error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
        else {
            showErrorSnackbar("Select Print profile");
        }
    }
    function DocumentValidate(dTransID, DocID) {
        $.ajax({
            url: Aurl + "printing/documentvalidate",
            type: 'get',
            contentType: 'json',
            data: { Companycode: strCompanyCode, TransID: dTransID, strDocID: DocID },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == "0") {
                        //items.ID,
                        var configid = $("#cmbProfile").val();
                        var transid = $("#cmbTransaction").val();
                        WhatsappDocument(items.ID, transid, configid);
                    } else {
                        showErrorSnackbar("Doc ID not matched. Enter correct Doc ID");
                    }
                });
            }
        });
    }
    // ===================== Doc Filter Modal Logic =====================
    var docFilterModalInstance = null;
    var docFilterInitialized = false; // becomes true after the modal's date filter is set up the first time

    // Returns today's date as "yyyy-mm-dd" (format required by <input type="date">)
    function GetTodayISO() {
        var d = new Date();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        return d.getFullYear() + '-' + mm + '-' + dd;
    }

    $('#btnDocFilter').click(function () {
        $("#divErrorOnTransaction").html("");
        if (isNullOrEmpty($("#cmbTransaction").val())) {
            $("#divErrorOnTransaction").html("Select Transaction");
            showErrorSnackbar("Select Transaction");
            return;
        }

        $(".docFilterError").html("");

        var transName = $("#cmbTransaction option:selected").text();
        $("#lblDocFilterTransName").text(transName);

        // Current date is always the max selectable date (no future dates allowed)
        var todayISO = GetTodayISO();
        $("#txtDocFromDate, #txtDocToDate").attr("max", todayISO);

        // Only set the default From/To date the first time the modal is opened.
        // On subsequent opens we keep whatever the user had selected before (don't reset the filter).
        if (!docFilterInitialized) {
            $("#txtDocFromDate").val(todayISO);
            $("#txtDocToDate").val(todayISO);
            docFilterInitialized = true;
        }

        

        var modalEl = document.getElementById('docFilterModal');
        docFilterModalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
        docFilterModalInstance.show();
    });

    // Converts "27/Aug/2026" style date strings to a JS Date object
    function ParseDocDate(str) {
        if (!str) return null;
        var months = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
        var parts = $.trim(str).split('/');
        if (parts.length !== 3 || !(parts[1] in months)) return null;
        return new Date(parseInt(parts[2], 10), months[parts[1]], parseInt(parts[0], 10));
    }

    $('#btnDocFilterLoad').click(function () {
        $(".docFilterError").html("");
        var IsValid = true;

        var userName = $("#cmbDocUserName").val();
        var fromDateStr = $("#txtDocFromDate").val();
        var toDateStr = $("#txtDocToDate").val();

        //if (isNullOrEmpty(userName)) {
        //    IsValid = false;
        //    $("#divErrorOnDocUserName").html("Select User Name");
        //}
        if (fromDateStr === "" || fromDateStr === null || fromDateStr === undefined) {
            IsValid = false;
            $("#divErrorOnFromDate").html("From Date is required");
        }
        if (toDateStr === "" || toDateStr === null || toDateStr === undefined) {
            IsValid = false;
            $("#divErrorOnToDate").html("To Date is required");
        }

        if (IsValid) {
            var fromDate = new Date(fromDateStr);
            var toDate = new Date(toDateStr);
            if (fromDate > toDate) {
                IsValid = false;
                $("#divErrorOnToDate").html("To Date should be greater than or equal to From Date");
            }
        }

        if (!IsValid) {
            showErrorSnackbar("Please correct the highlighted fields");
            return;
        }

        var fromDate = fromDateStr;
        var toDate = toDateStr;
        var dTransID = $("#cmbTransaction").val();
        $.ajax({
            url: Aurl + "transactionprint/documentfilter",
            type: 'get',
            contentType: 'json',
            data: { Companycode: strCompanyCode, TransID: dTransID, UserID: userName, FromDate: fromDate, ToDate: toDate },
            success: function (data) {        
                if (!data || data.length === 0) {
                    showErrorSnackbar("No records found");
                }
                RenderDocFilterResults(data);
            }
        });

        //var filteredData = $.grep(TransactionDocuments, function (doc) {
        //    if (!isNullOrEmpty(userName) && userName !== "0" && doc["User Name"] !== userName) return false;
        //    var docDate = ParseDocDate(doc["Doc Date"]);
        //    if (!docDate) return false;
        //    return docDate >= fromDate && docDate <= toDate;
        //});
        //RenderDocFilterResults(filteredData);
    });

    // Builds the responsive result cards.
    // Layout per document (mobile + desktop):
    //   Row 1 (static)  : Doc ID | Doc Date
    //   Row 2 (static)  : Party Name (full width)
    //   Row 3+ (dynamic): every remaining key from the data object, 2 columns per row
    //   Last row        : Select button
    function RenderDocFilterResults(data) {
        // Reset search state on every fresh Load
        $("#txtDocSearch").val("");
        $("#btnDocSearchClear").addClass("d-none");

        if (!data || data.length === 0) {
            $("#docSearchWrap").hide();
            $("#divDocFilterResults").html('<div class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No Records Found</div>');
            return;
        }

        $("#docSearchWrap").show();
        UpdateDocResultCount(data.length, data.length);

        var html = '<div class="doc-cards-wrap">';

        $.each(data, function (i, doc) {
            var docId = doc["Doc ID"] || "";
            var docDate = doc["Doc Date"] || "";
            var partyName = doc["Party Name"] || "";

            // Collect any remaining keys (in their original order) other than the 3 static ones above
            var restKeys = [];
            $.each(doc, function (key) {
                var trimmedKey = $.trim(key);
                if (trimmedKey !== "Doc ID" && trimmedKey !== "Doc Date" && trimmedKey !== "Party Name") {
                    restKeys.push(key);
                }
            });

            html += '<div class="doc-card">';

            // Row 1: Doc ID + Doc Date
            html += '<div class="doc-row doc-row-header">';
            html += '<div class="doc-col"><span class="doc-label">Doc ID</span><span class="btn doc-select-btn btnDocSelect" data-docid="' + $('<div/>').text(docId).html() + '">' + $('<div/>').text(docId).html() + '</span></div>';
            html += '<div class="doc-col"><span class="doc-label">Doc Date</span><span class="doc-value">' + $('<div/>').text(docDate).html() + '</span></div>';
            html += '</div>';

            // Row 2: Party Name (full width)
            html += '<div class="doc-row doc-row-single">';
            html += '<div class="doc-col doc-col-full"><span class="doc-label">Party Name</span><span class="doc-value doc-value-strong">' + $('<div/>').text(partyName).html() + '</span></div>';
            html += '</div>';

            // Dynamic rows: remaining keys, 2 per row
            for (var j = 0; j < restKeys.length; j += 2) {
                html += '<div class="doc-row">';
                html += '<div class="doc-col"><span class="doc-label">' + $.trim(restKeys[j]) + '</span><span class="doc-value">' + $('<div/>').text(doc[restKeys[j]]).html() + '</span></div>';
                if (restKeys[j + 1] !== undefined) {
                    html += '<div class="doc-col"><span class="doc-label">' + $.trim(restKeys[j + 1]) + '</span><span class="doc-value">' + $('<div/>').text(doc[restKeys[j + 1]]).html() + '</span></div>';
                } else {
                    html += '<div class="doc-col doc-col-empty"></div>';
                }
                html += '</div>';
            }

            // Final row: Select button
            //html += '<div class="doc-row doc-row-action">';
            //html += '<button type="button" class="btn doc-select-btn btnDocSelect" data-docid="' + $('<div/>').text(docId).html() + '"><i class="bi bi-check2-circle"></i>Select Document</button>';
            //html += '</div>';

            html += '</div>'; // .doc-card
        });

        html += '</div>'; // .doc-cards-wrap
        $("#divDocFilterResults").html(html);
    }

    function UpdateDocResultCount(visibleCount, totalCount) {
        if (totalCount === 0) {
            $("#lblDocResultCount").text("");
        } else if (visibleCount === totalCount) {
            $("#lblDocResultCount").text(totalCount + (totalCount === 1 ? " document found" : " documents found"));
        } else {
            $("#lblDocResultCount").text("Showing " + visibleCount + " of " + totalCount);
        }
    }

    // Live client-side search across all fields already rendered in the result cards
    $(document).on('input', '#txtDocSearch', function () {
        var term = $.trim($(this).val()).toLowerCase();
        $("#btnDocSearchClear").toggleClass("d-none", term === "");

        var cards = $("#divDocFilterResults .doc-card");
        var totalCount = cards.length;
        var visibleCount = 0;

        cards.each(function () {
            var isMatch = term === "" || $(this).text().toLowerCase().indexOf(term) !== -1;
            $(this).toggle(isMatch);
            if (isMatch) visibleCount++;
        });

        $("#divDocNoMatch").remove();
        if (visibleCount === 0 && totalCount > 0) {
            $("#divDocFilterResults").append('<div id="divDocNoMatch" class="text-center text-muted py-4"><i class="bi bi-search fs-3 d-block mb-2"></i>No matching documents</div>');
        }

        UpdateDocResultCount(visibleCount, totalCount);
    });

    $('#btnDocSearchClear').click(function () {
        $("#txtDocSearch").val("").trigger('input').focus();
    });

    $(document).on('click', '.btnDocSelect', function () {
        var docId = $(this).data('docid');
        $("#txtDocID").val(docId);
        $("#divErrorOnDocID").html("");
        if (docFilterModalInstance) {
            docFilterModalInstance.hide();
        }
    });
