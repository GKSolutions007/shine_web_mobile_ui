                            $('#cmbBeatName').val(items.Code);
                            if ($('#txtCustomerName').val() == '') {
                                $('#txtCustomerName').val(items.Billadd2);
                            }

                            setTimeout(() => {
                                GetData(2, $('#cmbBeatName').val(), $('#cmbSalesManName').val());
