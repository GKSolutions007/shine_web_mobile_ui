                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function getPartyInfo(nPartyID) {

        var var_Branch = $('#cmbBranchName').val();
        if (var_Branch > 0) {
            $.ajax({
                url: Aurl + "partyinfos",
                type: "GET",
                datatype: "JSON",
                data: {
                    CompanyCode: strCompanyCode, PartyID: nPartyID, BranchID: var_Branch
                },
                success: function (data) {
                    var CustomerData = data;
                    //lblOSCountValue,lblLastSaleDate
                    var PartyActivity = CustomerData[0].CustomerActivity;
                    $("#lblOSCountValue").text(formatIndianCurrency(PartyActivity[0].OSValue) + " " + PartyActivity[0].CrDr + " / " + PartyActivity[0].OSCount);
                    if (PartyActivity[0].CrDr == "Cr") {
                        $("#lblOSCountValue").css("color", "red");
                    } else {
                        $("#lblOSCountValue").css("color", "green");
                    }
                    $("#lblLastCollectionDate").text(PartyActivity[0].LastCollDate);
                    $("#lblACDValue").text(PartyActivity[0].ACD);
                    
                    //console.log("CustomerData ", CustomerData);
                },
                error: function (data) {

                }
            });
        }
        else {
            showErrorSnackbar("Select Branch");
        }
    }
