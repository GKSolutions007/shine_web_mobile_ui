    function CalculateBalanceAmt() {
        var isGO = false;
        var totcollAmt = $('#txtCollAmt').val() != "" ? parseFloat($('#txtCollAmt').val()) : 0;
        var eachAdjAmt = 0, balanceAmt = 0, otherChrg = 0, discAmt = 0, TotAdj = 0,OCPos = 0,OCNeg = 0;

        $('#tblAdjDocInfo tbody tr').each(function (i, items) {
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                //,
                if (fieldName == "AdjAmount") {
                    eachAdjAmt += parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                }
                else if (fieldName == "OtherCharge") {
                    var ocamt = parseFloat(document.getElementById(fieldID).getAttribute('txttag'))
                    if (ocamt > 0) OCPos += ocamt;
                    else OCNeg += Math.abs(ocamt);

                    otherChrg += parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                }
                else if (fieldName == "DiscountAmt") {
                    discAmt += parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                }
            });
        });        
        balanceAmt = parseFloat(totcollAmt) - (parseFloat(eachAdjAmt) );
        $('#divBalanceTop,#divBalanceBottom').html('Coll ₹ : ' + parseFloat(totcollAmt).toFixed(2) + ' ; Disc ₹ : ' + parseFloat(discAmt + OCNeg).toFixed(2) + ' ;  Bal : ' + parseFloat(balanceAmt - OCPos).toFixed(2));        
        $("#lblRemBalance").text(parseFloat(balanceAmt - OCPos).toFixed(2));
    }
    function adjamtValidation() {
        var isValid = false;
        var isNoRowAffected = false;
        $('#divErrorMessage').html('');
        var rowIndex = 1;
        var adjamt = 0, balance = 0;
        $('#tblAdjDocInfo tr td input').each(function (i, items) {
            if (i % 2 == 0) {
                if (items.value > 0) {
                    isValid = true;
                    isNoRowAffected = true;
                    adjamt = parseFloat(items.value);
                    balance = parseFloat(items.name);
                }
            }
            else {
                var OtherCharg = parseFloat(items.value);
                adjamt = adjamt + (OtherCharg < 0 ? (OtherCharg * -1) : 0)
                if (adjamt > balance) {
                    showErrorSnackbar('Error in Row ' + rowIndex.toString() + ' - Adj amt should be (<=) bal amt');
                    isValid = false;
                    return isValid;
                }
                rowIndex++;
            }
        });
        if (!isNoRowAffected) showErrorSnackbar('Atleast one row need to adj');
        return isValid;
    }
