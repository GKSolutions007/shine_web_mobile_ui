        $('#tblAdjDocInfo tbody tr input').each(function () {
            const name = this.name;
            const value = parseFloat(this.getAttribute('txttag')) || 0;

            if (name === 'AdjAmount') eachAdjAmt += value;
            else if (name === 'OtherCharge') otherChrg += value;
            else if (name === 'DiscountAmt') discAmt += value;
        });

        var $row = $(e.target).closest("tr");
        var rowData = Table.row($row).data();
        var InvoiceAmt = rowData.NetAmt;
        //DiscountPern,DiscountAmt
        
        var DiscPern = parseFloat($row.find("input[name='DiscountPern']").attr("txttag")) || 0;
        var DiscAmt = parseFloat($row.find("input[name='DiscountAmt']").attr("txttag")) || 0;
        var Balance = parseFloat($row.find("label[name='Balance']").attr("lbltag")) || 0;
        var OtherChargeAmt = parseFloat($row.find("input[name='OtherCharge']").attr("txttag")) || 0;
        //parseFloat(CollAmt) +
        var TotAdjAmt =  parseFloat(value) + DiscAmt + (OtherChargeAmt <= 0 ? Math.abs(OtherChargeAmt) : 0);
        if (eachAdjAmt > CollAmt) {
            updateInputColumn(id, 0);
            showErrorSnackbar("Adjust Amount should be lessthan Collection Amount.");
        }
        else if (TotAdjAmt > Balance) {
            updateInputColumn(id, 0);
            showErrorSnackbar("Amount mismatched");
        }

        
        CalculateBalanceAmt();
    });
    $(document).on("change", ".dgvOtherCharge", function (e) {
        ProdGridChange = true;
        var id = e.target.id;
        var name = e.target.name;
        var value = parseFloat(e.target.value);              
        var $row = $(e.target).closest("tr");
        var PreviousOtherChargeAmt = parseFloat($row.find("input[name='OtherCharge']").attr("txttag")) || 0;
        updateInputColumn(id, e.target.value);
        var rowData = Table.row($row).data();
        var InvoiceAmt = rowData.NetAmt;
        //DiscountPern,DiscountAmt
        var dCollAmt = $('#txtCollAmt').val()
        let eachAdjAmt = 0, otherChrgPOS = 0, otherChrgNEG = 0, discAmt = 0;
        $('#tblAdjDocInfo tbody tr input').each(function () {
            const name = this.name;
            const value = parseFloat(this.getAttribute('txttag')) || 0;

            if (name === 'AdjAmount') {
                eachAdjAmt += value;
            }
            else if (name === 'OtherCharge') {
                if (value > 0) {
                    otherChrgPOS += value;
                } else {
                    otherChrgNEG += Math.abs(value);
                }                
            }
            else if (name === 'DiscountAmt') {
                discAmt += value
            }
        });
        if ((eachAdjAmt + otherChrgPOS) > parseFloat(dCollAmt)) {
            updateInputColumn(id, 0);
        } else {
            var DiscPern = parseFloat($row.find("input[name='DiscountPern']").attr("txttag")) || 0;
            var DiscAmt = parseFloat($row.find("input[name='DiscountAmt']").attr("txttag")) || 0;
            var Balance = parseFloat($row.find("label[name='Balance']").attr("lbltag")) || 0;
            var AdjAmtPM = parseFloat($row.find("input[name='AdjAmount']").attr("txttag")) || 0;
            var TotAdjAmt = parseFloat(AdjAmtPM) + DiscAmt + (value <= 0 ? Math.abs(value) : 0);
            if (TotAdjAmt > Balance) {
                updateInputColumn(id, 0);
                showErrorSnackbar("Amount mismatched");
            }
        }
        CalculateBalanceAmt();
    });
    $(document).on("change", ".dgvDiscPern,.dgvDiscAmt", function (e) {
        try {
            ProdGridChange = true;
            var id = e.target.id;
            var CurrentFName = e.target.name;
            var fieldval = e.target.value;
            updateInputColumn(id, e.target.value);
            var $row = $(e.target).closest("tr");
            var rowData = Table.row($row).data();
            var InvoiceAmt = rowData.NetAmt;
            //DiscountPern,DiscountAmt
            var DiscPern = parseFloat($row.find("input[name='DiscountPern']").attr("txttag")) || 0;
            var DiscAmt = parseFloat($row.find("input[name='DiscountAmt']").attr("txttag")) || 0;
            var Balance = parseFloat($row.find("label[name='Balance']").attr("lbltag")) || 0;
            var AdjAmtPM = parseFloat($row.find("input[name='AdjAmount']").attr("txttag")) || 0;
            var OtherChargeAmt = parseFloat($row.find("input[name='OtherCharge']").attr("txttag")) || 0;
            var OCAmt = OtherChargeAmt < 0 ? Math.abs(OtherChargeAmt) : 0;
            if (CurrentFName === "DiscountAmt") {
                var calpern = (fieldval / InvoiceAmt) * 100;
                updateInputColumn($row.find("input[name='DiscountPern']").attr("id"), calpern);
                DiscPern = calpern;
                DiscAmt = fieldval;
                if ((AdjAmtPM + parseFloat(DiscAmt) + OCAmt) > Balance) {
                    DiscPern = 0;
                    DiscAmt = 0;
                    updateInputColumn($row.find("input[name='DiscountPern']").attr("id"), 0);
                    updateInputColumn($row.find("input[name='DiscountAmt']").attr("id"), 0);
                    showErrorSnackbar("Amount mismatched")
                }
            }

            if (CurrentFName === "DiscountPern") {
                var calamt = (fieldval * InvoiceAmt) / 100;
                updateInputColumn($row.find("input[name='DiscountAmt']").attr("id"), calamt);
                DiscAmt = calamt;
                DiscPern = fieldval;
                if ((AdjAmtPM + parseFloat(DiscAmt) + OCAmt) > Balance) {
                    DiscPern = 0;
                    DiscAmt = 0;
                    updateInputColumn($row.find("input[name='DiscountPern']").attr("id"), 0);
                    updateInputColumn($row.find("input[name='DiscountAmt']").attr("id"), 0);
                    showErrorSnackbar("Amount mismatched")
                }
            }
            CalculateBalanceAmt();
        } catch (error) {
            console.error('Export error:', error);
            alert('Export failed: ' + error.message);
        }
    });
    function CalculateBalanceAmt_old() {
        var isGO = false;
        var totcollAmt = parseFloat($('#txtCollAmt').val());
        var eachAdjAmt = 0, balanceAmt = 0, otherChrg = 0;
        $('#tblAdjDocInfo tr td input').each(function (i, items) {
            if (i % 2 == 0) {
                if (items.value > 0) {
                    isGO = true;
                    eachAdjAmt = parseFloat(eachAdjAmt) + parseFloat(items.value);
                }
            }
            else {
                if (isGO) {
                    otherChrg = parseFloat(otherChrg) + (parseFloat(items.value) > 0 ? parseFloat(items.value) : 0);
                }
            }
        });
        balanceAmt = parseFloat(totcollAmt) - (parseFloat(eachAdjAmt) + parseFloat(otherChrg));
        $('#divBalanceTop').html('Coll Amt : ' + totcollAmt.toString() + '  ;  Bal : ' + balanceAmt.toString());
