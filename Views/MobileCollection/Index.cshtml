    function toggleCustomerCard() {
    const body = document.getElementById('customerInfoBody');
    const icon = document.getElementById('icoToggleCustomer');

    if (body.classList.contains('collapsed')) {
        body.classList.remove('collapsed');
        icon.classList.remove('bi-plus-lg');
        icon.classList.add('bi-dash-lg');
    } else {
        body.classList.add('collapsed');
        icon.classList.remove('bi-dash-lg');
        icon.classList.add('bi-plus-lg');
    }
}

function toggleNotesCard() {
    const body = document.getElementById('notesBody');
    const icon = document.getElementById('icoToggleNotes');

    if (body.classList.contains('collapsed')) {
        body.classList.remove('collapsed');
        icon.classList.remove('bi-plus-lg');
        icon.classList.add('bi-dash-lg');
    } else {
        body.classList.add('collapsed');
        icon.classList.remove('bi-dash-lg');
        icon.classList.add('bi-plus-lg');
    }
}
    $('#txtAllowTrackLocation').val(1);

    $('#btnGetSurrCustomers').click(function () {
        $('#divErrorOnCustName').html('');
        var IsAllow = $('#txtAllowTrackLocation').val() == "0" ? false : true;
        if (IsAllow) {
            $('#dvCustLoc').show();
            geolocate(2);
        }
        else {
            $('#divErrorOnCustName').html('You dont have Location tracking Permission. Cannot load data');
        }
    });
    function geolocate(nMode) {
        var IsAllow = $('#txtAllowTrackLocation').val() == "0" ? false : true;
        if (IsAllow) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    //var geolocation = new google.maps.LatLng(
                    //position.coords.latitude, position.coords.longitude);
                    var PinLat = position.coords.latitude;
                    var PinLong = position.coords.longitude;

                    $('#txtLatitude').val(PinLat);
                    $('#txtLongtitude').val(PinLong);
                    if (nMode == 2) {
                        GetCustomerbyLocation();
                    }
                }, function (error) {
                    showErrorSnackbar(error.message);
                });
            } else {
                showErrorSnackbar("Geolocation is not supported by this browser.")
            }
        }
    }
    function GetCustomerbyLocation() {

        //alert("Time :" + curtime);
        $('#divErrorOnCustName').html('');
        $('#divErrorOnPopupSurrCust').html('');
        $('#lblCurrLocation').text("");
        var lats = $('#txtLatitude').val();
        var longs = $('#txtLongtitude').val();
        if (lats != "" && longs != "") {
            TableSurroundCustomers.clear().draw();
            $.ajax({
                url: Aurl + "surroundingcustomers",
                type: "GET",
                datatype: "JSON",
                data: {
                    CompanyCode: strCompanyCode, UserID: UID, Latitude: lats, Longitude: longs
                },
                success: function (data) {
                    $('#lblCurrLocation').text(lats + "," + longs);
                    if (data.length > 0) {
                        if (data[0].Mode == 0) {
                            modal.show();
                            var customerdata = (data[0].Customerdata);
                            $.each(customerdata, function (i, items) {
                                TableSurroundCustomers.row.add([
                                    items.ID,
                                    items.Customername,
                                    renderCustomerCell(items, i)
                                ]).draw(false);
                            });
                        } else {
                            modal.hide();
                            showErrorSnackbar(data[0].Message);
                        }
                    } else {
                        $('#divErrorOnCustName').html('No Customers surrounding you.');
                        $('#divErrorOnPopupSurrCust').html('No Customers surrounding you.');
                    }
                }
            });
        } else {
            modal.hide();
            $('#divErrorOnCustName').html('Location Not Identified. Try again');
        }
    }
    function initials(name) {
        if (!name) return "?";
        var parts = name.trim().split(/\s+/);
        var chars = parts.length > 1 ? parts[0][0] + parts[1][0] : parts[0].slice(0, 2);
        return chars.toUpperCase();
    }

    function renderCustomerCell(items, rowIndex) {
        var avatar;
        if (items.ImageData && items.ImageData.trim() !== "") {
            var imgSrcdata = "data:image/jpeg;base64," + items.ImageData;
            avatar = '<img class="cust-avatar" src="' + imgSrcdata + '" alt="' + items.Customername + '" />';
        } else {
            avatar = '<div class="cust-avatar-fallback">' + initials(items.Customername) + '</div>';
        }

        // Stagger the entrance animation per row, capped so long lists don't feel sluggish
        var delay = Math.min(rowIndex * 60, 400);

        return (
            '<div class="cust-card" style="animation-delay:' + delay + 'ms">' +
            avatar +
            '<div class="cust-body">' +
            '<div class="cust-name">' + items.Customername + '</div>' +
            '<div class="cust-meta">' +
            '<span><i class="bi bi-signpost-split-fill"></i>' + items.Radius + '</span>' +
            '<span><i class="bi bi-geo-alt-fill"></i>' + items.Address + '</span>' +
            '</div>' +
            '</div>' +
            '</div>'
        );
    }
    $('#tblSurroundCustomers tbody').on('click', 'tr', function () {
        $('#txtBeatName').val('');
        $('#txtSalesManName').val('');
        var CustID = TableSurroundCustomers.row(this).data()[0];
        var Cust = TableSurroundCustomers.row(this).data()[1];
        $('#txtCustomerName').val(Cust);
        GetData(5, CustID);
        GetData(4, CustID, $('#cmbSalesManName').val())
        getPartyInfo(CustID);
        $("#txtCustomerID").val(CustID);
        modal.hide();
    });
</script>