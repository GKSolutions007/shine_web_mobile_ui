    function SaveData() {
        var arrAmtAdjDocs = [];
        var totamt = 0;
        var collAmt = parseFloat($('#txtCollAmt').val());

        var totcollAmt = $('#txtCollAmt').val() != "" ? parseFloat($('#txtCollAmt').val()) : 0;
        var eachAdjAmt = 0, balanceAmt = 0, otherChrg = 0, discAmt = 0, TotAdj = 0, OCPos = 0, OCNeg = 0;
        var rembal = parseFloat( $("#lblRemBalance").text());
        if (rembal >= 0) {
            $('#tblAdjDocInfo tbody tr').each(function (i, items) {
                var rowdata = Table.row($(this)).data();
                var RowIndex = Table.row($(this)).index();
                var GridID = rowdata.ID;//[0];
                var GridDocprefix = rowdata.Docprefix;//[1];
                var GridDocID = rowdata.Docid;//[1];
                var GridDocDate = rowdata.Docdate;//[2];
                var GridRefNo = rowdata.Refno;
                var GridNetAmt = rowdata.NetAmt;
                var AssignID = rowdata.AssignInvoiceID
                var Adjamt = 0, Otherchrg = 0, Balance = 0, DiscAmt = 0, DiscPern = 0;
                $(this).find("input").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "AdjAmount") {
                        Adjamt = parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                    }
                    if (fieldName == "OtherCharge") {
                        Otherchrg = parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                    }
                    if (fieldName === "DiscountAmt") {
                        DiscAmt = parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                    }

                    if (fieldName === "DiscountPern") {
                        DiscPern = parseFloat(document.getElementById(fieldID).getAttribute('txttag'));
                    }
                });
                $(this).find("label").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "Balance") {
                        Balance = $(this).text();
                    }
                });
                if (Adjamt > 0) {
                    totamt = parseFloat(totamt) + parseFloat(Adjamt) -
                        ((parseFloat(Otherchrg) < 0 ? 0 : parseFloat(Math.abs(Otherchrg))));// + parseFloat(DiscAmt)
                    var docs = {
                        "ID": GridID,
                        "Docprefix": GridDocprefix,
                        "Docid": GridDocID,
                        "Docdate": GridDocDate,
                        "Refno": GridRefNo,
                        "NetAmt": GridNetAmt,
                        "Balance": Balance,
                        "Amtadj": Adjamt,
                        "Ohtercharges": Otherchrg,
                        "DiscPern": DiscPern,
                        "DiscAmt": DiscAmt,
                        "AssignInvoiceID": AssignID,
                    }
                    arrAmtAdjDocs.push(docs)
                }
            });
            if (collAmt >= totamt) {
                var advamt = parseFloat(collAmt) - parseFloat(totamt);
                lstTrans = {
                    CompanyCode: strCompanyCode,
                    ID: $('#txtID').val(),
                    TransMode: nTransMode,
                    "CurrentStatus": $('#txtStatusID').val(),      
                    BeatID: $('#cmbBeatName').val(),
                    SalesManID: $('#cmbSalesManName').val(),
                    CustomerID: $('#txtCustomerID').val(),
                    BranchID: $('#cmbBranchName').val(),
                    lstadjdocs: arrAmtAdjDocs,
                    "Flags": 1,
                    "UserID": UID,
                    "collectedamt": $('#txtCollAmt').val(),
                    "PaymentmodeID": $('#cmbPaymentMode').val(),
                    "Chequedate": $('#dtpChequeDate').val(),
                    "Chequeno": $('#txtChequeNo').val(),
                    "BankID": $('#cmbBankName').val(),
                    "Bankname": $('#cmbBankName option:selected').text(),
                    "ifsc": $('#txtifsc').val(),
                    "AdvAmt": advamt,
                    "BankACno": $('#cmbBankACNo').val(),
                    "BankACID": $('#cmbBankACNo option:selected').text(),
                    "Remarks": $('#txtRemarks').val(),
                    "Narration": $('#txtNarration').val(),
                    "CusLatitude": $('#txtLatitude').val(),
                    "CusLongtitude": $('#txtLongtitude').val(),
                                  
                    "TransType": 1,// $('#txtTransType').val(),
                    "TransID": 0,//$('#txtTransID').val()
                };
                var SwapCustID = $('#txtCustomerID').val();
                $.ajax({
                    url: Aurl + "mobilecollection/save",
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(lstTrans),
                    cache: false,
                    processData: false,
                    //xhrFields: {
                    //    withCredentials: true
                    //},
                    success: function (data) {
                        $.each(data, function (i, items) {
                            if (items.MsgID == 0) {
                                //alert(items.Message);
                                showSuccessSnackbar(items.Message);
                                ClearForm();
                                NavigatetoNext("Switch to", SwapCustID);
                            }
                            else {
                                //$("#dvErrorName").html(items.Message);
                                //alert(items.Message);
                                showErrorSnackbar(items.Message);
                            }
                        });
                    }
                });
            }
            else {
                arrAmtAdjDocs = [];
                showErrorSnackbar('Adj amt should be less than or equal to coll amt');
            }
        }
        else {
            arrAmtAdjDocs = [];
            showErrorSnackbar('Balance should not be negative');
        }
    }
