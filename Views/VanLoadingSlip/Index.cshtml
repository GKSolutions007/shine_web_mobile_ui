        $("#lblAddress").text(Deliverydata.DeliveryAddress);
        $("#lblMobNo").text(Deliverydata.MobNo);

        $("#lblDBy").text(Deliverydata.DeliveryBy);
        $("#lblDDate").text(Deliverydata.DeliveryDate);
        $("#txtReciever").val(Deliverydata.ReceiverName);
