    function GetData(nMode, strID = null) {
        $.ajax({
            url: Aurl + "delivery/initialdata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode,ID: strID
            },
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbBranch').find("option").remove();
                    $('#cmbBranch').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    var responsedata = JSON.parse(data);
                    var allBranches = responsedata.Table;
                    $.each(allBranches, function (i, items) {
                        $('#cmbBranch').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    var Todayroute = responsedata.Table1;
                    if (Todayroute) {
                        $('#cmbBranch').val(Todayroute[0].BranchID)
                    }
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
