                                    @*<li> @Html.ActionLink("🔁 Switch", "SwitchCompany", "LogOn", null, new { @class = "blink", @style = "font-weight:bold;", @id = "lnkSwitch" })</li>*@
                                    <li>@Html.ActionLink("LogOut - " + @UserName, "LogOff", "LogOn", null, new { })</li>
                                </ul>

