    //setInterval(function () {
    //    GetSessionState()
    //}, 300000);


    function GetSessionState() {
        $.ajax({
            url: '@Url.Action("checkSession", "Customer")',
            type: 'GET',
            datatype: 'json',
            data: {},
            success: function (data) {
                if (data == "1") {
                    alert("User is Logout in another tab. So logout in all tab for Security Purpose");
                    location.href = '@Url.Action("Index", "LogOn")';
                }
            }
        });
    }
    var element = document.getElementsByClassName('.overlay');
    myFunction();
    function myFunction() {
        document.getElementById("myDropdown").classList.toggle("show");
    }

    function filterFunction() {
        var input, filter, ul, li, a, i;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        div = document.getElementById("myDropdown");
        a = div.getElementsByTagName("a");
        for (i = 0; i < a.length; i++) {
            txtValue = a[i].textContent || a[i].innerText;
            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                a[i].style.display = "";
            } else {
                a[i].style.display = "none";
            }
        }

    }

    $('#lnkSwitch').hide();
    $('#hrefSwap').hide();
    $('#hrefOT').hide();
    $('#hrefSR').hide();
    $('#hrefCollection').hide();
    $('#hrefPayment').hide();
    $('#hrefPO').hide();
    $('#hrefCustomer').hide();
    $('#hrefVendor').hide();
    $('#hrefProduct').hide();
    $('#hrefPriceList').hide();
    $('#hrefDashBoardDetails').hide();
    $('#hrefCustomerLocation').hide();
    $('#hrefOrderLocation').hide();
    $('#TransPrint').hide();
    $('#TransSales').hide();
    $('#hrefCLSUP').hide();

    //GetPermission();
    function GetPermission() {
        $.ajax({
            url: '@Url.Action("ImageGetPermissions", "Customer")',
            type: 'POST',
            datatype: 'json',
            data: {},
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.ControllerName == "Customer")
                    {
                        $('#hrefCustomer').show();
                    }
                    else if (items.ControllerName == "Vendor")
                    {
                        $('#hrefVendor').show();
                    }
                    else if (items.ControllerName == "Product")
                    {
                        $('#hrefProduct').show();
                    }
                    else if (items.ControllerName == "OrderTaken")
                    {
                        $('#hrefOT').show();
                    }
                    else if (items.ControllerName == "SalesReturn")
                    {
                        $('#hrefSR').show();
                    }
                    else if (items.ControllerName == "Collection")
                    {
                        $('#hrefCollection').show();
                    }
                    else if (items.ControllerName == "CustomerLocation")
                    {
                        $('#hrefCustomerLocation').show();
                    }
                    else if (items.ControllerName == "GetLocation") {
                        $('#hrefOrderLocation').show();
                    }
                    else if (items.ControllerName == "Payment")
                    {
                        $('#hrefPayment').show();
                    }
                    else if (items.ControllerName == "PurchaseOrder")
                    {
                        $('#hrefPO').show();
                    }
                    else if (items.ControllerName == "PriceList") {
                        $('#hrefPriceList').show();
                    }
                    //else if (items.ControllerName == "GetLocation") {
                    //    $('#hrefLocation').show();
                    //}
                    else if (items.ControllerName == "DashBoardDetails") {
                        $('#hrefDashBoardDetails').show();
                    }
                    else if (items.ControllerName == "TransPrint") {
                        $('#hrefTransPrint').show();
                    }
                    else if (items.ControllerName == "TranSales") {
                        $('#hrefTranSales').show();
                    }
                    else if (items.ControllerName == "Swap") {
                        $('#lnkSwitch').show();
                        $('#hrefSwap').show();
                    }
                    else if (items.ControllerName == "ClosingStockUpdate") {
                        $('#hrefCLSUP').show();
                    }
                });
            }
        });
    }

    function openNav() {
        document.getElementById("myNav").style.width = "35%";
    }

function closeNav() {
  document.getElementById("myNav").style.width = "0%";
    }
    function arrowKeyHandlersave(e) {
        if (e.key === "ArrowRight") {
            e.preventDefault();
            document.querySelector(".clsNo")?.focus();
        } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            document.querySelector(".clsYes")?.focus();
        }
    }
        var cfFocus = '@Session["ConfirmFocus"]';
    function ConfirmDialogMsg(message) {
        var IsAccepted = false;
        $('<div></div>').appendTo('body')
            .html('<div><h6>' + message + '</h6></div>')
            .dialog({
                modal: true,
                closeOnEscape: true,
                title: 'Confirm Popup',
                zIndex: 100,
                autoOpen: true,
                width: '300px',
                resizable: true,
                close: false,
                open: function () {
                    document.addEventListener("keydown", arrowKeyHandlersave);
                    $(this).closest(".ui-dialog")
                        .find(".ui-dialog-titlebar-close")
                        .removeClass("ui-dialog-titlebar-close")
                        .html("x");
