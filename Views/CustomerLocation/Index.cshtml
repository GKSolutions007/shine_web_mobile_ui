    function geolocate(nMode) {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                //var geolocation = new google.maps.LatLng(
                //position.coords.latitude, position.coords.longitude);
                var PinLat = position.coords.latitude;
                var PinLong = position.coords.longitude;

                $('#txtLatitude').val(PinLat);
                $('#txtLongtitude').val(PinLong);
                if (nMode == 2) {
                    GetCustomerbyLocation();
                } else {
                    setLoadButtonLoading(false);
                }
            }, function (error) {
                showErrorSnackbar(error.message);
                setLoadButtonLoading(false);
            });
        } else {
            showErrorSnackbar("Geolocation is not supported by this browser.")
            setLoadButtonLoading(false);
        }
    }
    // ===== Show in Map (Google Maps with all customer pins + current location) =====
    var arrCustomerMapData = [];
    var googleMapInstance = null;
    var mapMarkers = [];
    var GOOGLE_MAPS_API_KEY = "AIzaSyBDhzKQV1BgtvQdvhFwbAjUxUKp4iPL9Is"; // TODO: replace with your actual Google Maps JavaScript API key
    var isGoogleMapsLoaded = false;
    var isGoogleMapsLoading = false;

    function loadGoogleMapsScript(callback) {
        if (isGoogleMapsLoaded && typeof google !== 'undefined' && google.maps) {
            callback();
            return;
        }
        if (isGoogleMapsLoading) {
            var waitInterval = setInterval(function () {
                if (isGoogleMapsLoaded) {
                    clearInterval(waitInterval);
                    callback();
                }
            }, 200);
            return;
        }
        isGoogleMapsLoading = true;
        window.__onGoogleMapsLoaded = function () {
            isGoogleMapsLoaded = true;
            isGoogleMapsLoading = false;
            callback();
        };
        var script = document.createElement('script');
        script.src = "https://maps.googleapis.com/maps/api/js?key=" + GOOGLE_MAPS_API_KEY + "&callback=__onGoogleMapsLoaded";
        script.async = true;
        script.defer = true;
        script.onerror = function () {
            isGoogleMapsLoading = false;
            showErrorSnackbar("Unable to load Google Maps. Please check your internet connection or API key.");
        };
        document.head.appendChild(script);
    }

    function showCustomerMap() {
        if (!arrCustomerMapData || arrCustomerMapData.length == 0) {
            showErrorSnackbar("No customer location data available. Please load customers first.");
            return;
        }
        var mapModalEl = document.getElementById('customerMapModal');
        var mapModal = bootstrap.Modal.getOrCreateInstance(mapModalEl);
        mapModal.show();

        loadGoogleMapsScript(function () {
            // Small delay so the modal has finished its show transition and the
            // map container has a proper, non-zero size before Maps initializes.
            setTimeout(function () {
                renderCustomerMap();
            }, 250);
        });
    }

    function renderCustomerMap() {
        var mapContainer = document.getElementById('customerMapContainer');
        var currLat = parseFloat($('#txtLatitude').val());
        var currLng = parseFloat($('#txtLongtitude').val());
        var centerLatLng = (!isNaN(currLat) && !isNaN(currLng)) ? { lat: currLat, lng: currLng } : { lat: 20.5937, lng: 78.9629 };

        googleMapInstance = new google.maps.Map(mapContainer, {
            center: centerLatLng,
            zoom: 12,
            mapTypeId: google.maps.MapTypeId.HYBRID
        });

        $.each(mapMarkers, function (i, m) { m.setMap(null); });
        mapMarkers = [];

        var bounds = new google.maps.LatLngBounds();
        var infoWindow = new google.maps.InfoWindow();

        // ----- Current location marker -----
        if (!isNaN(currLat) && !isNaN(currLng)) {
            var currMarker = new google.maps.Marker({
                position: { lat: currLat, lng: currLng },
                map: googleMapInstance,
                title: "Location",
                icon: { url: "https://maps.google.com/mapfiles/ms/icons/blue-dot.png" },
                zIndex: 999
            });
            currMarker.addListener('click', function () {
                infoWindow.setContent('<div style="font-size:13px;font-weight:600;">Your Current Location</div>');
                infoWindow.open(googleMapInstance, currMarker);
            });
            mapMarkers.push(currMarker);
            bounds.extend(currMarker.getPosition());
        }

        // ----- Customer pin locations -----
        $.each(arrCustomerMapData, function (i, value) {
            var lat = parseFloat(value.Latitude), lng = parseFloat(value.Longtitude);
            if (isNaN(lat) || isNaN(lng)) { return; }

            var marker = new google.maps.Marker({
                position: { lat: lat, lng: lng },
                map: googleMapInstance,
                title: value.Name || ''
            });

            marker.addListener('click', function () {
                var lat = value.Latitude, lng = value.Longtitude;

                var latlong = lat.trim() + "," + lng.trim();

                var Redirectlink = lat != "" && lng != "" ?
                    /Android/i.test(navigator.userAgent) ? `geo:${latlong}?q=${latlong}` : `https://www.google.com/maps/dir/?api=1&destination=${latlong}` : ``;

                var content =
                    '<div style="min-width:190px;font-family:Arial, Helvetica, sans-serif;">' +
                        '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">' +                            
                            '<div style="font-size:14px;font-weight:600;">' + (value.Name || '') + '</div>' +
                        '</div>' +
                    '<div style="font-size:12px;margin-bottom:2px;">OS : ' + (value.Balance != null ? formatIndianCurrency(value.Balance) : 0) + ', Aging : ' + (value.Aging != null ? value.Aging : 0) + '</div>' +
                        //'<div style="font-size:12px;margin-bottom:4px;">Aging : ' + (value.Aging != null ? value.Aging : 0) + '</div>' +
                        '<div style="font-size:14px;margin-top:10px;">' +
                            '<a href="Redirectlink" class="map-distance-link" data-lat="' + lat + '" data-lng="' + lng + '" style="color:#0d6efd;text-decoration:underline;">' +
                                '<i class="bi bi-geo-alt-fill"></i> ' + (value.Distance || '') +
                            '</a>' +
                        '</div>' +
                    '</div>';

                infoWindow.setContent(content);
                infoWindow.open(googleMapInstance, marker);
            });

            mapMarkers.push(marker);
            bounds.extend(marker.getPosition());
        });

        if (!bounds.isEmpty()) {
            googleMapInstance.fitBounds(bounds);
        }

        google.maps.event.trigger(googleMapInstance, 'resize');
    }

