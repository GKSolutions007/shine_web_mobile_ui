    function GetCustomerbyLocation() {
        $('#divErrorOnCustName').html('');
        $('#lblCurrLocation').text("");
        var lats = $('#txtLatitude').val();
        var longs = $('#txtLongtitude').val();
        if (lats != "" && longs != "") {
            Table.clear().draw();

            var nBeatID = $('#cmbBeatName').val(), nSMID = $('#cmbSalesManName').val();
            nCustID = $("#txtCustomerID").val();
            $.ajax({
                url: Aurl + "customerlocation",
                type: "GET",
                datatype: "JSON",
                data: {
                    CompanyCode: strCompanyCode, Type: rdoCheckedID, BeatID: nBeatID, SalesmanID: nSMID, Customer: nCustID,
                    Latitude: lats, Longitude: longs
                },
                success: function (data) {
                    $('#lblCurrLocation').text(lats + "," + longs);
                    if (data.length > 0) {
                            var customerdata = (data);
                            arrCustomerMapData = customerdata;
                            $('#btnShowMap').show();
                            $('#tblCustomerData').DataTable({
                                scrollY: "500px",
                                scrollX: true,
                                scrollCollapse: true,
                                paging: false,
                                destroy: true,
                                data: customerdata,
                                fixedColumns: false,
                                ordering: false,
                                searching: true,
                                sorting: false,
                                columns: [
                                    { "data": "ID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                    { "data": "Latitude", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                    { "data": "Longtitude", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                    {
                                        className: "dt-body-center",
                                        "mRender": function (data, type, value, meta) {
                                            var rowIndex = (meta.row + 1);
                                            var avatar;
                                            if (value.Imagedata && value.Imagedata.trim() !== "") {
                                                avatar = '<img class="cust-avatar" src="' + value.Imagedata + '" alt="' + value.Name + '" />';
                                            } else {
                                                avatar = '<div class="cust-avatar-fallback">' + initials(value.Name) + '</div>';
                                            }

                                            var mobileHtml = (value.Mob1 && value.Mob1.toString().trim() !== "")
                                                ? '<a class="cust-cell-mobile" href="tel:' + value.Mob1 + '"><i class="bi bi-telephone-fill"></i> ' + value.Mob1 + '</a>'
                                                : '<span class="cust-cell-mobile" style="color:#999;">No number</span>';
                                            var lat = value.Latitude, lng = value.Longtitude;

                                            var latlong = lat.trim() + "," + lng.trim();

                                            var Redirectlink = lat != "" && lng != "" ?
                                                /Android/i.test(navigator.userAgent) ? `geo:${latlong}?q=${latlong}` : `https://www.google.com/maps/dir/?api=1&destination=${latlong}` : ``;


                                            var DistanceField = '<a class="distance-link" href="' + Redirectlink + '" data-lat="' + lat + '" data-lng="' + lng + '">' +
                                                '<i class="bi bi-geo-alt-fill"></i> ' + value.Distance +
                                                '</a>';

                                            return '' +
                                                '<div class="cust-cell">' +
                                                    '<span class="cust-serial">' + rowIndex + '</span>' +
                                                    avatar +
                                                    '<div class="cust-cell-info">' +
                                                        '<div class="cust-cell-name" title="' + (value.Name || '') + '">' + (value.Name || '') + '</div>' +
                                                        mobileHtml +
                                                        '<div class="cust-cell-meta">' +
                                                            '<span class="cust-badge outstanding">OS : ' + (value.Balance != null ? formatIndianCurrency(value.Balance) : 0) + '</span>' +
                                                            '<span class="cust-badge aging">Aging : ' + (value.Aging != null ? value.Aging : 0) + '</span>' +
                                                '</div>' + '<div class="mt-2"><span>' + DistanceField +'</span></div>'
                                                '</div>'
                                                '</div>';
                                        },
                                    },
                                    {
                                        className: "dt-body-center", width: "18%", "visible": false,
                                        "mRender": function (data, type, value, meta) {
                                            var lat = value.Latitude, lng = value.Longtitude;

                                            var latlong = lat.trim() + "," + lng.trim();

                                            var Redirectlink = lat != "" && lng != "" ?
                                                /Android/i.test(navigator.userAgent) ? `geo:${latlong}?q=${latlong}` : `https://www.google.com/maps/dir/?api=1&destination=${latlong}` : ``;


                                            return '<a class="distance-link" href="' + Redirectlink + '" data-lat="' + lat + '" data-lng="' + lng + '">' +
                                                       '<i class="bi bi-geo-alt-fill"></i> ' + value.Distance +
                                                   '</a>';
                                        },
                                    },
                                ],
                            });
                            Table = $('#tblCustomerData').DataTable();
                    } else {
                        showErrorSnackbar("No Customers found");
                        //$('#divErrorOnCustName').html('No Customers found.');
                        arrCustomerMapData = [];
                        $('#btnShowMap').hide();
                    }
                },
                error: function (data) {
                    showErrorSnackbar("Unable to load customers. Please try again.");
                },
                complete: function () {
                    setLoadButtonLoading(false);
                }
            });
        } else {
            showErrorSnackbar('Location Not Identified. Try again');
            //$('#divErrorOnCustName').html('Location Not Identified. Try again');
            setLoadButtonLoading(false);
        }
    }
    function initials(name) {
        if (!name) return "?";
        var parts = name.trim().split(/\s+/);
        var chars = parts.length > 1 ? parts[0][0] + parts[1][0] : parts[0].slice(0, 2);
        return chars.toUpperCase();
    }
