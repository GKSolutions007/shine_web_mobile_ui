@model ShineWebMobile.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
@*<link href="~/Content/surroundingcustomerstyle.css" rel="stylesheet" />*@
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    th, td {
        white-space: nowrap;
    }

    .toolbar, .dt-search {
        float: right;
    }

    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }


    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 1em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -18%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 1em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }
    /*input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .9em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }

    .each {
        border-bottom: 1px solid #555;
        padding: 3px 0;
    }

    .acItem .name {
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .acItem .desc {
        font-size: 10px;
        font-family: Arial, Helvetica, sans-serif;
        color: #555;
    }

    .ui-autocomplete {
        max-height: 245px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* =============================================
       MODERNIZED dvMain STYLES
    ============================================= */
    /* Form Section Cards */
    .form-section-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,120,200,0.08);
        border: 1px solid #e8f0fe;
        margin-bottom: 14px;
        padding: 14px 16px 10px 16px;
        animation: slideInCard 0.35s cubic-bezier(.4,0,.2,1) both;
        transition: box-shadow 0.2s;
        position: relative;
    }

        .form-section-card:hover {
            box-shadow: 0 6px 24px rgba(0,120,200,0.13);
        }

    .form-section-title {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #1a73e8;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
        border-bottom: 1.5px solid #e8f0fe;
        padding-bottom: 6px;
    }

        .form-section-title i {
            font-size: 14px;
            color: #1a73e8;
        }
    /* Floating label inputs */
    .field-wrap {
        position: relative;
        margin-bottom: 6px;
    }

        .field-wrap .field-icon {
            position: absolute;
            left: 10px;
            top: 40%;
            transform: translateY(-50%);
            color: #1a73e8;
            font-size: 14px;
            z-index: 5;
            pointer-events: none;
        }

        .field-wrap .mod-input,
        .field-wrap .mod-select,
        .field-wrap .mod-textarea {
            width: 100%;
            padding: 10px 10px 7px 34px;
            font-size: 13px;
            border: 1.5px solid #d0dff7;
            border-radius: 8px;
            background: #f8fbff;
            color: #222;
            transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
            outline: none;
            appearance: none;
            -webkit-appearance: none;
        }

            .field-wrap .mod-input:focus,
            .field-wrap .mod-select:focus,
            .field-wrap .mod-textarea:focus {
                border-color: #1a73e8;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(26,115,232,0.12);
            }

        .field-wrap .mod-label {
            position: absolute;
            top: 0px;
            left: 34px;
            font-size: 10px;
            font-weight: 700;
            color: #1a73e8;
            letter-spacing: 0.05em;
            pointer-events: none;
            transition: all 0.2s;
        }

        .field-wrap .field-error {
            font-size: 10.5px;
            color: #d32f2f;
            margin-top: 2px;
            min-height: 0px;
            padding-left: 4px;
        }
    /* Radio button pill groups */
    .radio-pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        justify-content: center;
        margin-bottom: 15px;
    }

        .radio-pill-group input[type=radio] {
            display: none;
        }

        .radio-pill-group label {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            border: 1.5px solid #c5d9f5;
            background: #f0f6ff;
            color: #1a73e8;
            cursor: pointer;
            transition: all 0.18s;
            user-select: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .radio-pill-group input[type=radio]:checked + label {
            background: linear-gradient(135deg, #1a73e8, #0d52b8);
            color: #fff;
            border-color: #1a73e8;
            box-shadow: 0 2px 8px rgba(26,115,232,0.28);
        }

        .radio-pill-group label:hover {
            border-color: #1a73e8;
            background: #e3eeff;
        }


    /* Collapsible Card Body */
    .card-collapsible-body {
        max-height: 1000px;
        opacity: 1;
        overflow: hidden;
        transition: max-height 0.5s ease-in-out, opacity 0.3s ease;
    }

        .card-collapsible-body.collapsed {
            max-height: 0;
            opacity: 0;
            pointer-events: none;
        }

    /* Circular Toggle Button */
    .card-collapse-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f6ff;
        border: 1.5px solid #c5d9f5;
        color: #1a73e8;
        padding: 0;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

        .card-collapse-btn:hover {
            background: #1a73e8;
            color: #fff;
            border-color: #1a73e8;
        }

        .card-collapse-btn i {
            font-size: 12px;
            margin-right: 0 !important;
        }

    /* Animations */
    @@keyframes slideInCard {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* Table header modernize */
    #tblCustomerData thead th {
        background: linear-gradient(135deg, #1a73e8, #0d52b8) !important;
        color: #fff !important;
        font-size: 11px !important;
        text-align: center;
        border: none;
        padding: 10px 5px;
    }

    .cust-avatar {
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
        background: #eef0fd;
    }

    .cust-avatar-fallback {
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
        color: var(--accent);
        background: #eef0fd;
    }

    /* ===== Modernized 2-column customer table ===== */
    .cust-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 4px;
        text-align: left;
        white-space: normal;
    }

    .cust-serial {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #eef4fd;
        color: #1a73e8;
        font-size: 10px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .cust-cell-info {
        flex: 1;
        min-width: 0;
    }

    .cust-cell-name {
        font-size: 12px;
        font-weight: 700;
        color: #222;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 220px;
    }

    .cust-cell-mobile {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        color: #1a73e8;
        text-decoration: none;
        font-weight: 600;
        margin-top: 2px;
    }

        .cust-cell-mobile:hover {
            text-decoration: underline;
            color: #0d52b8;
        }

    .cust-cell-meta {
        display: flex;
        gap: 6px;
        margin-top: 4px;
        flex-wrap: wrap;
    }

    .cust-badge {
        font-size: 13px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        background: #f0f6ff;
        color: #333;
        white-space: nowrap;
    }

        .cust-badge.outstanding {
            background: #fdecea;
            color: #c62828;
        }

        .cust-badge.aging {
            background: #fff6e0;
            color: #8a6100;
        }

    .distance-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        color: #1a73e8;
        background: #eef4fd;
        padding: 6px 10px;
        border-radius: 16px;
        text-decoration: none;
        white-space: nowrap;
        border: 1px solid #d0dff7;
        transition: all 0.18s;
        cursor: pointer;
    }

        .distance-link:hover {
            background: #1a73e8;
            color: #fff;
            border-color: #1a73e8;
        }

    /* Load button loading state */
    #btnLoad.is-loading {
        pointer-events: none;
        opacity: 0.85;
    }

    .btn-spinner {
        display: inline-block;
        width: 12px;
        height: 12px;
        border: 2px solid rgba(255,255,255,0.55);
        border-top-color: #fff;
        border-radius: 50%;
        animation: btnSpin 0.7s linear infinite;
        margin-right: 6px;
        vertical-align: -1px;
    }

    @@keyframes btnSpin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<body>
    <div style="margin-bottom:50px;">
        @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
        @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
        @Html.HiddenFor(model => model.TransID, new { @autocomplete = "off", @class = "form-control", @id = "txtTransID" })

        @Html.HiddenFor(model => model.AssignInvoicewise, new { @autocomplete = "off", @class = "form-control", @id = "txtAssignInvoicewiseID" })
        @Html.HiddenFor(model => model.Customerwise, new { @autocomplete = "off", @class = "form-control", @id = "txtCustomerwiseID" })
        <h4 id="MainHeading">@ViewData["FormName"]</h4>
        <div class="toastBox"></div>
        <hr class="style14" />

        <div>
            <input id="txtCustomerID" hidden />
            <label hidden id="lblCustAdvAmt">0</label>
            <input hidden type="number" class="FormclrField" id="txtLatitude" />
            <input hidden type="number" class="FormclrField" id="txtLongtitude" />

            <!-- Filter Selection -->
            <div class="radio-pill-group">
                <input type="radio" name="rdoFilter" id="rdoAssignedInvoice" checked />
                <label for="rdoAssignedInvoice"><i class="bi bi-file-earmark-check"></i> Assigned Invoices</label>

                <input type="radio" name="rdoFilter" id="rdoCustomer" />
                <label for="rdoCustomer"><i class="bi bi-person"></i> Customer</label>
            </div>

            <!-- SECTION 1: Location & Customer -->
            <div class="form-section-card form-stack-3" style="animation-delay:0.05s">
                <div class="form-section-title" style="cursor:pointer; user-select:none" onclick="toggleCustomerCard()">
                    <i class="bi bi-geo-alt"></i> Customer Information
                    <button type="button" id="btnToggleCustomer" class="card-collapse-btn ms-auto" title="Expand / Collapse" onclick="toggleCustomerCard(); event.stopPropagation();">
                        <i class="bi bi-plus-lg" id="icoToggleCustomer"></i>
                    </button>
                </div>

                <div id="customerInfoBody" class="card-collapsible-body collapsed">
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-sm-4 col-md-4">
                            <div class="field-wrap">
                                <i class="bi bi-map field-icon"></i>
                                <label class="mod-label">Beat Name</label>
                                <select class="mod-select FormclrcmbField" id="cmbBeatName">
                                    <option value="0">Select</option>
                                </select>
                                <div class="field-error clrdivs" id="divErrorOnBeatName"></div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-4">
                            <div class="field-wrap">
                                <i class="bi bi-person-badge field-icon"></i>
                                <label class="mod-label">Salesman</label>
                                <select class="mod-select FormclrcmbField" id="cmbSalesManName">
                                    <option value="0">Select</option>
                                </select>
                                <div class="field-error clrdivs" id="divErrorOnSalesManName"></div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-4">
                            <div class="field-wrap">
                                <i class="bi bi-person field-icon" id="Custinfo" style="cursor:pointer"></i>
                                <label class="mod-label">Customer <span style="color:#d32f2f">*</span></label>
                                <input type="text" class="mod-input FormclrField" id="txtCustomerName" autocomplete="off" />
                                <div class="field-error clrdivs" id="divErrorOnCustName"></div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-sm-12 col-md-4">
                            <div class="d-flex gap-2 mt-auto">
                                <button id="btnClear" type="button" class="btn btn-danger  flex-grow-1">
                                    <i class="bi bi-arrow-counterclockwise"></i> Clear
                                </button>
                                <button id="btnLoad" type="button" class="btn btn-success  flex-grow-1">
                                    <span id="btnLoadSpinner" class="btn-spinner" style="display:none;"></span>
                                    <i class="bi bi-pin-map" id="btnLoadIcon"></i>
                                    <span id="btnLoadText">Load</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="style14" />
            <div class="d-flex justify-content-end mb-2">
                <button id="btnShowMap" type="button" class="btn btn-primary btn-sm" style="display:none;">
                    <i class="bi bi-geo-alt-fill"></i> Show in Map
                </button>
            </div>
            <div class="table-responsive mt-2">
                <table id="tblCustomerData" class="table table-hover table-bordered" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th style="width:0%;">ID</th>
                            <th style="width:0%;">Latitude</th>
                            <th style="width:0%;">Longitude</th>
                            <th style="width:75%;text-align:center">Customer Details</th>
                            <th style="width:25%;">Distance</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Customer Locations Map Modal -->
        <div class="modal fade" id="customerMapModal" tabindex="-1" aria-labelledby="customerMapModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="customerMapModalLabel"><i class="bi bi-geo-alt-fill"></i> Customer Locations</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div id="customerMapContainer" style="width:100%; height:70vh;"></div>
                    </div>
                </div>
            </div>
        </div>

        <a href="javascript:" id="return-to-top"><i class="icon-chevron-up"></i></a>
    </div>
</body>
<script type="text/javascript">
        var UID = '@Session["LoginUserID"]';
var Aurl = '@Session["APIurl"]';
    var DecVal = '@Session["DecimalValues"]';
    var strCompanyCode = '@Session["CompanyCode"]';
    var rdoCheckedID = 1;
   var nTransMode = 1;
    var Table = $('#tblCustomerData').DataTable({
        "bFilter": false,
        "bLengthChange": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollY: "500px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0, 1, 2,4], "visible": false, searchable: false, ordering: false }]
    });

    LoadPermission();
    function LoadPermission() {
        if ($("#txtAssignInvoicewiseID").val() == 0) {
            $("#rdoAssignedInvoice, label[for='rdoAssignedInvoice']").hide();
        }
        if ($("#txtCustomerwiseID").val() == 0) {
            $("#rdoCustomer, label[for='rdoCustomer']").hide();
        }
        setTimeout(() => {
            var radioId = null;
            rdoCheckedID = 2;
            if ($("label[for='rdoAssignedInvoice']").css("display") != "none") {
                radioId = "rdoAssignedInvoice";
                rdoCheckedID = 1;
            }
            else if ($("label[for='rdoCustomer']").css("display") != "none") {
                radioId = "rdoCustomer";
                rdoCheckedID = 2;
            }

            if (radioId) {
                $("#" + radioId).prop("checked", true).trigger("change");
            }
        }, 1000)
        //if (firstVisibleRadio)
            //$("#" + firstVisibleRadio).trigger("click");
    }

    $(window).scroll(function () {
        if ($(this).scrollTop() >= 200) {        // If page is scrolled more than 50px
            $('#return-to-top').fadeIn(200);    // Fade in the arrow
        } else {
            $('#return-to-top').fadeOut(200);   // Else fade out the arrow
        }
    });
    $('#return-to-top').click(function () {      // When arrow is clicked
        $('body,html').animate({
            scrollTop: 0                       // Scroll to top of body
        }, 500);
    });
    GetData(1, UID);
    var arrParty = [], arrBankAccountData = [];

    function GetData(nMode, strID = null, strSalesmanID = null) {
        $.ajax({
            url: Aurl + "mobilecollection/getdata",
            type: 'get',
            contentType: 'json',
            data: {
                CompanyCode: strCompanyCode, Mode: nMode, ID: strID, SalesmanID: strSalesmanID, FilterType: rdoCheckedID,
                BranchID: $('#cmbBranchName').val()
            },
            //xhrFields: {
            //    withCredentials: true
            //},
            success: function (data) {
                if (nMode == 1) {
                    arrBankAccountData = [];
                    //cmbPaymentMode,cmbBankACNo,cmbBankName
                    $('#cmbBeatName,#cmbSalesManName').find("option").remove();
                    $('#cmbBeatName,#cmbSalesManName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            $('#cmbSalesManName').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 2) {
                            $('#cmbBeatName').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 7) {
                            //console.log("Beat : " + items.Code + " ,Salesman : " + items.Name);
                            $('#cmbSalesManName').val(items.Name);
                            $('#cmbBeatName').val(items.Code);
                            $('#cmbBranchName').val(items.ID);

                        }
                    });
                    setTimeout(() => {
                        GetData(2, $('#cmbBeatName').val(), $('#cmbSalesManName').val());
                    }, 500);
                }
                else if (nMode == 2) {
                    arrParty = [];
                    $.each(data, function (i, items) {
                        if (items.FType == 7) {
                            var Prod = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                            }
                            arrParty.push(Prod);
                        }
                    });
                    SetAutlistforFields("txtCustomerName", arrParty);
                }
                else if (nMode == 5) {
                    $.each(data, function (i, items) {
                        if ($("#txtTransType").val() == "2" && $("#txtTransID").val() != "") {

                            if ($('#cmbSalesManName').val() == 0) {
                                $('#cmbSalesManName').val(items.Name)
                            }
                            $('#cmbBeatName').val(items.Code);
                            if ($('#txtCustomerName').val() == '') {
                                $('#txtCustomerName').val(items.Billadd2);
                            }

                            setTimeout(() => {
                                GetData(2, $('#cmbBeatName').val(), $('#cmbSalesManName').val());
                            }, 500);
                        }
                        else {
                            if ($('#cmbBeatName').val() == 0 && $('#cmbSalesManName').val() == 0) {
                                $('#cmbBeatName').val(items.Code)
                                $('#cmbSalesManName').val(items.Name)
                            }
                            else if ($('#cmbSalesManName').val() == 0) {
                                $('#cmbSalesManName').val(items.Name)
                            }
                            else if ($('#cmbBeatName').val() == 0) {
                                $('#cmbBeatName').val(items.Code)
                            }
                            if ($('#txtCustomerName').val() == '') {
                                $('#txtCustomerName').val(items.Billadd2);
                            }
                        }
                    });
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

