    // ===== Distance click -> open Google Maps navigation =====
    $(document).on('click', '.distance-link123', function () {
        var lat = $(this).data('lat');
        var lng = $(this).data('lng');
        if (lat !== undefined && lat !== null && lat !== '' && lng !== undefined && lng !== null && lng !== '') {

